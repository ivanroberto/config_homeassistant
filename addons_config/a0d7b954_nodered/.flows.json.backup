"12097a98.a70645","version":3,"outputs":2,"halt_if":"off","halt_if_type":"str","halt_if_compare":"is","entity_id":"switch.registro_agua_geral","state_type":"str","blockInputOverrides":true,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"entity"}],"for":"","forType":"num","forUnits":"minutes","override_topic":false,"state_location":"payload","override_payload":"msg","entity_location":"data","override_data":"msg","x":510,"y":200,"wires":[["e193cc62b17e0497"],[]]},{"id":"509852e8d1d796a9","type":"inject","z":"37cd6d52e9e3b419","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"60","crontab":"","once":false,"onceDelay":"1","topic":"","payload":"","payloadType":"date","x":160,"y":80,"wires":[["674beea7b335f8e2"]]},{"id":"23464b992755e8cc","type":"function","z":"37cd6d52e9e3b419","name":"Liga registro durante irrigação","func":"// 1. CARREGA AS CONFIGURAÇÕES EXTERNAS\nconst config = msg.config;\nif (!config) {\n    node.warn(\"Configuração ausente! Passe pelo nó Change antes.\");\n    return [null, null, null];\n}\n\n// Acessa todos os estados em tempo real do Home Assistant\nconst haContext = global.get('homeassistant');\nif (!haContext || !haContext.homeAssistant || !haContext.homeAssistant.states) {\n    node.warn(\"Aguardando conexão com Home Assistant...\");\n    return [null, null, null];\n}\nconst haStates = haContext.homeAssistant.states;\n\n// 2. LÊ OS ESTADOS ATUAIS USANDO OS NOMES DA CONFIGURAÇÃO\nconst alarmeEntity = haStates[config.alarme_entity];\nconst registroEntity = haStates[config.registro_entity];\nconst caixaEntity = haStates[config.caixa_entity];\n\nconst alarmeState = alarmeEntity ? alarmeEntity.state : 'off';\nconst registroState = registroEntity ? registroEntity.state : 'off';\n\n// Obtém o nível da caixa d'água\nlet nivelCaixa = 100; // Por segurança, assume cheia se falhar\nif (caixaEntity && !isNaN(parseFloat(caixaEntity.state))) {\n    nivelCaixa = parseFloat(caixaEntity.state);\n}\n\nconst agora = new Date();\nlet deveIrrigar = false;\nconst margemMs = config.margem_minutos * 60 * 1000;\n\n// 3. VERIFICA TODAS AS ZONAS INSTANTANEAMENTE\nfor (const id of config.zonas_irrigacao) {\n    const zona = haStates[id];\n    if (!zona) continue;\n\n    // Se estiver irrigando fisicamente agora\n    if (zona.state === 'on') {\n        deveIrrigar = true;\n        break;\n    }\n\n    // Valida a janela de tempo futura/atual\n    if (zona.attributes && zona.attributes.next_start) {\n        const inicio = new Date(zona.attributes.next_start);\n        if (!isNaN(inicio.getTime())) {\n            const duracaoSegundos = parseFloat(zona.attributes.next_duration) || 0;\n            const duracaoMs = duracaoSegundos * 1000;\n            \n            const janelaInicio = new Date(inicio.getTime() - margemMs);\n            const janelaFim = new Date(inicio.getTime() + duracaoMs + margemMs);\n            \n            if (agora >= janelaInicio && agora <= janelaFim) {\n                deveIrrigar = true;\n                break;\n            }\n        }\n    }\n}\n\n// 4. LÓGICA DE AÇÃO DESEJADA (TARGET STATE)\nconst precisaEncherCaixa = nivelCaixa < config.nivel_minimo_caixa;\nlet acaoDesejada = \"\";\n\nif (deveIrrigar || precisaEncherCaixa) {\n    acaoDesejada = \"ABRIR_IMEDIATO\";\n} else if (alarmeState === 'off') {\n    acaoDesejada = \"ABRIR_COM_ATRASO\";\n} else {\n    acaoDesejada = \"FECHAR_COM_ATRASO\";\n}\n\n// 5. CONTROLE DE TEMPO (DELAYS)\n// Puxa a memória de quando essa ação começou a ser desejada\nlet acaoAnterior = context.get('acaoAnterior');\nlet tempoMudanca = context.get('tempoMudanca');\n\nif (acaoDesejada !== acaoAnterior) {\n    // A situação mudou! Zera o cronômetro para agora\n    tempoMudanca = agora.getTime();\n    context.set('acaoAnterior', acaoDesejada);\n    context.set('tempoMudanca', tempoMudanca);\n}\n\n// 6. EXECUÇÃO\nlet out1 = null; // Saída para 'Desliga?'\nlet out2 = null; // Saída para 'Liga?'\nlet out3 = { payload: deveIrrigar }; // Status da janela\n\nif (acaoDesejada === \"ABRIR_IMEDIATO\" && registroState === 'off') {\n    out2 = { payload: \"on\" }; // Abre na mesma hora\n    \n} else if (acaoDesejada === \"ABRIR_COM_ATRASO\" && registroState === 'off') {\n    let momentoAbrir = tempoMudanca + (config.tempo_para_abrir_min * 60 * 1000);\n    if (agora.getTime() >= momentoAbrir) {\n        out2 = { payload: \"on\" }; // Abre após 5 min\n    }\n    \n} else if (acaoDesejada === \"FECHAR_COM_ATRASO\" && registroState === 'on') {\n    let momentoFechar = tempoMudanca + (config.tempo_para_fechar_min * 60 * 1000);\n    if (agora.getTime() >= momentoFechar) {\n        out1 = { payload: \"off\" }; // Fecha após 30 min\n    }\n}\n\nreturn [out1, out2, out3];","outputs":3,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":190,"y":160,"wires":[["d900c0f3e6b3251f","836fb91196982165"],["cdec38e0610cce9a","d7337572b1749555"],["97115bdcd1c5fe78"]]},{"id":"45f54ef18f7245a4","type":"inject","z":"37cd6d52e9e3b419","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":520,"y":260,"wires":[["acc8790911ce383f"]]},{"id":"aded9b589653443f","type":"inject","z":"37cd6d52e9e3b419","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":520,"y":300,"wires":[["e193cc62b17e0497"]]},{"id":"d900c0f3e6b3251f","type":"debug","z":"37cd6d52e9e3b419","name":"debug 14","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":160,"y":220,"wires":[]},{"id":"cdec38e0610cce9a","type":"debug","z":"37cd6d52e9e3b419","name":"debug 15","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":160,"y":260,"wires":[]},{"id":"97115bdcd1c5fe78","type":"debug","z":"37cd6d52e9e3b419","name":"debug 17","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":160,"y":300,"wires":[]},{"id":"674beea7b335f8e2","type":"change","z":"37cd6d52e9e3b419","name":"⚙️ Configurações do Fluxo","rules":[{"t":"set","p":"config","pt":"msg","to":"{\"alarme_entity\":\"binary_sensor.ha_alarme_externo_ativado\",\"registro_entity\":\"switch.registro_agua_geral\",\"caixa_entity\":\"sensor.nivel_caixa_agua\",\"nivel_minimo_caixa\":80,\"margem_minutos\":5,\"tempo_para_fechar_min\":25,\"tempo_para_abrir_min\":20,\"zonas_irrigacao\":[\"binary_sensor.irrigation_unlimited_c1_z1\",\"binary_sensor.irrigation_unlimited_c1_z2\",\"binary_sensor.irrigation_unlimited_c1_z3\",\"binary_sensor.irrigation_unlimited_c2_z1\",\"binary_sensor.irrigation_unlimited_c3_z1\"]}","tot":"json"}],"action":"","property":"","from":"","to":"","reg":false,"x":420,"y":80,"wires":[["23464b992755e8cc"]]},{"id":"c7daca0e.dc5808","type":"comment","z":"c8b19fe3.e52d3","name":"Ajusta tempo Irrigação","info":"","x":140,"y":40,"wires":[]},{"id":"2285f28.af8700e","type":"inject","z":"c8b19fe3.e52d3","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"600","crontab":"","once":true,"onceDelay":"3","topic":"","payload":"","payloadType":"date","x":130,"y":80,"wires":[["83b6814.4f2758"]]},{"id":"6fff8c05.6a78d4","type":"api-current-state","z":"c8b19fe3.e52d3","name":"Chuva ponderada 5 Dias","server":"12097a98.a70645","version":3,"outputs":1,"halt_if":"","halt_if_type":"str","halt_if_compare":"is","entity_id":"sensor.irrigation_unlimited_rain_weighted_total","state_type":"str","blockInputOverrides":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"entity"}],"for":0,"forType":"num","forUnits":"minutes","x":370,"y":380,"wires":[["b2155ba8.238478"]]},{"id":"10751b44.da07f5","type":"api-current-state","z":"c8b19fe3.e52d3","name":"Temperatura 5 Dias Media Movel","server":"12097a98.a70645","version":3,"outputs":1,"halt_if":"","halt_if_type":"str","halt_if_compare":"is","entity_id":"sensor.irrigation_unlimited_temperature_5_day_moving_average","state_type":"str","blockInputOverrides":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"entity"}],"for":0,"forType":"num","forUnits":"minutes","x":400,"y":140,"wires":[["7cc82abf.c639d4"]]},{"id":"8ceca0d1.f4188","type":"function","z":"c8b19fe3.e52d3","name":"","func":"var ajuste = 100;\nvar temperaturaAjuste = flow.get(\"temperatura_ajuste\");\nvar tempAtual = flow.get(\"temperatura_5_dias\");\nvar chuvaPonderada = flow.get(\"chuva_ponderada\");\nvar chuvaAjuste = flow.get(\"chuva_ajuste\");\n//var chovendoAgora = flow.get(\"chovendo_agora\");\nvar sensorChuva = flow.get(\"sensor_chuva\");\nvar chuvaHoje = flow.get(\"chuva_hoje\");\n\n//node.warn(\"temperaturaAjuste = \" + temperaturaAjuste);\n//node.warn(\"tempAtual = \" + tempAtual);\n//node.warn(\"chuvaPonderada = \" + chuvaPonderada);\n//node.warn(\"chuvaAjuste = \" + chuvaAjuste);\n//node.warn(\"chovendoAgora = \" + chovendoAgora);\n//node.warn(\"chuvaHoje = \" + chuvaHoje);\n//node.warn(\"sensorChuva = \" + sensorChuva);\n\nif (sensorChuva != \"on\"){\n    //node.warn(\"Nao esta chovendo\");\n    if(chuvaHoje < chuvaAjuste){\n        //node.warn(\"Chuva de hoje abaixo do limite\");\n        var ajusteChuva, ajusteTemp;\n        ajusteTemp = Math.pow((tempAtual/temperaturaAjuste),2);\n        if(ajusteTemp > 2){\n            ajusteTemp = 2;\n        }\n        //node.warn(\"Ajuste de temp = \" + ajusteTemp);\n        if (chuvaPonderada >= chuvaAjuste) { //ajusteChuva\n            ajusteChuva = 0;\n        } else if(chuvaPonderada > 0){\n            ajusteChuva = (chuvaAjuste-chuvaPonderada)/chuvaAjuste;\n            if(ajusteChuva < 0.1){\n                ajusteChuva = 0;\n            }\n            //node.warn(\"Ajuste de chuva = \" + ajusteChuva);\n            if(ajusteChuva > 1){\n                ajusteChuva = 1;\n            }\n        } else {\n            ajusteChuva = 1;\n        }    \n        ajuste = (((ajusteChuva)*100)*ajusteTemp).toFixed(0);\n        //node.warn(\"ajuste = \" + ajuste);\n    } else {\n        ajuste = 0; //Desliga irrigacao se choveu o suficiente\n    }    \n} else {\n    ajuste = 0; //Desliga irrigacao se estiver chovendo\n}    \n\nflow.set(\"ajuste\", ajuste);\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":320,"y":500,"wires":[["19b1cdf396829d9d","8297a195b04f46a0","c925d5506ca00a5e"]]},{"id":"b2155ba8.238478","type":"change","z":"c8b19fe3.e52d3","name":"Chuva Poderada","rules":[{"t":"move","p":"payload","pt":"msg","to":"chuva_ponderada","tot":"flow"}],"action":"","property":"","from":"","to":"","reg":false,"x":670,"y":380,"wires":[["ea2e7570.42d968"]]},{"id":"7cc82abf.c639d4","type":"change","z":"c8b19fe3.e52d3","name":"temperatura 5 dias","rules":[{"t":"move","p":"payload","pt":"msg","to":"temperatura_5_dias","tot":"flow"}],"action":"","property":"","from":"","to":"","reg":false,"x":670,"y":140,"wires":[["e58939e0.814aa8"]]},{"id":"7d999be9.dd2a34","type":"change","z":"c8b19fe3.e52d3","name":"Temperatura Ajuste","rules":[{"t":"move","p":"payload","pt":"msg","to":"temperatura_ajuste","tot":"flow"}],"action":"","property":"","from":"","to":"","reg":false,"x":670,"y":80,"wires":[["10751b44.da07f5"]]},{"id":"83b6814.4f2758","type":"api-current-state","z":"c8b19fe3.e52d3","name":"Temperatura Ajuste","server":"12097a98.a70645","version":3,"outputs":1,"halt_if":"","halt_if_type":"str","halt_if_compare":"is","entity_id":"input_number.temp_ajuste_irrigacao","state_type":"str","blockInputOverrides":false,"outputProperties":[