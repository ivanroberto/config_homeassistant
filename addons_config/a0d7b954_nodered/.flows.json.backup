e,"outputOnStateChange":true,"outputProperties":[{"property":"outputType","propertyType":"msg","value":"pgm_3","valueType":"str"},{"property":"payload","propertyType":"msg","value":"","valueType":"entityState"},{"property":"time","propertyType":"msg","value":"$moment(time).tz(\"America/Sao_Paulo\").format('D MMM HH:mm:ss - ') ","valueType":"jsonata"}],"x":1170,"y":2220,"wires":[["b646d2e9d6620898"],["b646d2e9d6620898"]]},{"id":"fa8e134516091440","type":"ha-switch","z":"77ee9ef7029ba7e3","g":"ebbe97f61bac706b","name":"Central AMT - Sirene","version":0,"debugenabled":false,"inputs":1,"outputs":2,"entityConfig":"0324dcb58ca681eb","enableInput":true,"outputOnStateChange":true,"outputProperties":[{"property":"outputType","propertyType":"msg","value":"sirene","valueType":"str"},{"property":"payload","propertyType":"msg","value":"","valueType":"entityState"},{"property":"time","propertyType":"msg","value":"$moment(time).tz(\"America/Sao_Paulo\").format('D MMM HH:mm:ss - ') ","valueType":"jsonata"}],"x":1170,"y":2280,"wires":[["b646d2e9d6620898"],["b646d2e9d6620898"]]},{"id":"1cc90c4a73eb67eb","type":"debug","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"debug 152","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":810,"y":820,"wires":[]},{"id":"468b34de9a319960","type":"switch","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"","property":"check_status","propertyType":"flow","rules":[{"t":"true"}],"checkall":"true","repair":false,"outputs":1,"x":710,"y":1080,"wires":[["ff4e1652c55373ea","2f2f6fdb9660de17"]]},{"id":"f36c9f8ada604d55","type":"debug","z":"77ee9ef7029ba7e3","name":"debug 154","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":1650,"y":1580,"wires":[]},{"id":"5d894d400c4ceb60","type":"function","z":"77ee9ef7029ba7e3","g":"5382b2d92857e002","name":"ACK","func":"var i;\nvar buffer;\nvar hex;\nvar erro;\nbuffer = Buffer.from(msg.payload);\nfor (i = 0; i < buffer.length; i++) {\n  if (i == 0) {\n    hex = buffer[i].toString(16);\n  } else {\n    hex = hex + \" \" + buffer[i].toString(16);\n  }\n}\nerro = \"Erro desconhecido \\\"\" + hex.toUpperCase() + \"\\\"\"\n\n       const states = msg.payload[2];\nconst text = {\n    0xFE: 'Comando recebido com sucesso',\n    0xE0: 'Formato de pacote inválido',\n    0xE1: 'Senha incorreta',\n    0xE2: 'Comando inválido',\n    0xE3: 'Central não particionada',\n    0xE4: 'Zonas abertas',\n    0xE5: 'Comando descontinuado',\n    0xE6: 'Usuário sem permissão para bypass',\n    0xE7: 'Usuário sem permissão para desativar',\n    0xE8: 'Bypass não permitido com a central ativada',\n    0xEA: 'Partição sem zonas habilitadas'\n    };\n\nconst result = text.hasOwnProperty(states) ? text[states] : erro\nconsole.log(msg.time + \"[AMT] Comando enviado: \" + msg.button_press + \", ACK: \" + result);\nmsg.payload = result;\nreturn msg;\n","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1670,"y":1060,"wires":[["064a7b0dcfa04b4e","56cde86119a1c6b8"]]},{"id":"b5ca1a5348c352ea","type":"debug","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"debug 194","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":570,"y":760,"wires":[]},{"id":"17dbc7f0dfddfa9b","type":"function","z":"77ee9ef7029ba7e3","g":"5382b2d92857e002","name":"AMT 2018 SMART (beta)","func":"if (global.get(\"homeassistant.homeAssistant.isConnected\") == true) {\n\nvar zone_ = Buffer.alloc(65);\nvar violated_ = Buffer.alloc(65);\nvar anulated_ = Buffer.alloc(65);\nvar lowbattery_ = Buffer.alloc(65);\nvar n_zone;\nvar i;\nvar j;\nfor (i = 0; i < 64 / 8; i++) {\n  for (j = 0; j < 8; j++) {\n    n_zone = ((i * 8) + 1 + j);\n    if (n_zone < 49) {\n      zone_[n_zone] = ((msg.payload[i + 1 + 1] >> j) & 1);\n      violated_[n_zone] = (msg.payload[i + 1 + 7] >> j) & 1;\n      anulated_[n_zone] = (msg.payload[i + 1 + 13] >> j) & 1;\n    } else {\n      zone_[n_zone] = 0;\n      violated_[n_zone] = 0;\n      anulated_[n_zone] = 0;\n    }\n    if (n_zone < 41) {\n      lowbattery_[n_zone] = (msg.payload[i + 1 + 39] >> j) & 1;\n      //lowbattery_[n_zone] = 0;\n    } else {\n      lowbattery_[n_zone] = 0;\n\n    }\n\n\n  }\n}\nmsg.zone_ = zone_;\nmsg.violated_ = violated_;\nmsg.anulated_ = anulated_;\nmsg.lowbattery_ = lowbattery_;\n\n\n\n\n\n\nvar tamper_ = Buffer.alloc(19);\nvar shortcircuit_ = Buffer.alloc(19);\nn_zone = 0;\nfor (i = 0; i < 8 / 8; i++) {\n  for (j = 0; j < 8; j++) {\n\n    n_zone = ((i * 8) + 1 + j);\n    tamper_[n_zone] = (msg.payload[i + 1 + 34] >> j) & 1;\n    shortcircuit_[n_zone] = (msg.payload[i + 1 + 36] >> j) & 1;\n\n    tamper_[n_zone + 10] = (msg.payload[i + 1 + 35] >> j) & 1;\n    shortcircuit_[n_zone + 10] = (msg.payload[i + 1 + 37] >> j) & 1;\n\n  }\n}\n\nmsg.tamper_ = tamper_;\nmsg.shortcircuit_ = shortcircuit_;\n\nvar fw1 = (msg.payload[20 + 1]) & 0xf0;\nvar fw2 = (msg.payload[20 + 1]) & 0x0f;\nfw1 = (fw1 / 16);\nmsg.fw = (fw1 + \".\" + fw2);\nif (msg.payload[19 + 1] == 0x34) {\n  msg.model = \"AMT 2018 E SMART\"\n// } else if (msg.payload[19 + 1] == 0x61) {\n//   msg.model = \"AMT 1016 NET\"\n} else {\n  msg.model = \"Desconhecido\"\n}\nmsg.partition_a = Boolean((msg.payload[22 + 1] >> 0) & 1);\nmsg.partition_b = Boolean((msg.payload[22 + 1] >> 1) & 1);\nmsg.partition_c = true;\nmsg.partition_d = true;\n\nmsg.pc = (msg.payload[23 + 1] >> 0) & 1;\nmsg.za = (msg.payload[23 + 1] >> 2) & 1;\nmsg.activated = Boolean((msg.payload[23 + 1] >> 3) & 1);\nmsg.cd = (msg.payload[23 + 1] >> 6) & 1;\n\nmsg.acpower = Boolean((msg.payload[29 + 1] >> 0) & 1);\nmsg.b_baixa = (msg.payload[29 + 1] >> 1) & 1;\nmsg.b_con = (msg.payload[29 + 1] >> 2) & 1;\nmsg.b_curto = (msg.payload[29 + 1] >> 3) & 1;\nmsg.s_aux = (msg.payload[29 + 1] >> 4) & 1;\n\nvar pt_ = Buffer.alloc(5);\nvar pr_ = Buffer.alloc(5);\nn_zone = 0;\nfor (i = 0; i < 4; i++) {\n  for (j = 0; j < 4; j++) {\n\n    n_zone = ((i * 8) + 1 + j);\n    pt_[n_zone] = (msg.payload[i + 1 + 30] >> j) & 1;\n    pr_[n_zone] = (msg.payload[i + 1 + 30] >> j + 4) & 1;\n  }\n}\n\nmsg.pt_ = pt_;\nmsg.pr_ = pr_;\n\nvar pep_ = Buffer.alloc(5);\nvar pez_ = Buffer.alloc(9);\nn_zone = 0;\nfor (i = 0; i < 4; i++) {\n  for (j = 0; j < 4; j++) {\n\n    n_zone = ((i * 8) + 1 + j);\n    pep_[n_zone] = 0;\n    pez_[n_zone + 4] = 0;\n    pez_[n_zone] = 0;\n  }\n}\n\nmsg.pep_ = pep_;\nmsg.pez_ = pez_;\n\nmsg.b_con = (msg.payload[29 + 1] >> 2) & 1;\nif (msg.b_con == 0) {\n  msg.bateria = (msg.payload[31 + 1]) & 0x0f;\n  if (msg.bateria == 0x0f) {\n    msg.bateria = 100;\n  } else if (msg.bateria == 0x07) {\n    msg.bateria = 75;\n  } else if (msg.bateria == 0x03) {\n    msg.bateria = 50;\n  } else if (msg.bateria == 0x01) {\n    msg.bateria = 25;\n  } else if (msg.bateria == 0x00) {\n    msg.bateria = 0;\n  }/* else {\n    msg.bateria = -10\n}*/\n} else {\n  msg.bateria = 0;\n}\n\nvar tc_ = Buffer.alloc(5);\nn_zone = 0;\nfor (i = 0; i < 4; i++) {\n  for (j = 0; j < 4; j++) {\n\n    n_zone = ((i * 8) + 1 + j);\n    tc_[n_zone] = (msg.payload[i + 1 + 32] >> j + 4) & 1;\n  }\n}\n\nmsg.tc_ = tc_;\n\nmsg.ss = (msg.payload[38 + 1] >> 3) & 1;\nmsg.pgm_1 = Boolean((msg.payload[38 + 1] >> 6) & 1);\nmsg.pgm_2 = Boolean((msg.payload[38 + 1] >> 5) & 1);\nmsg.pgm_3 = false;\n\nmsg.scf = (msg.payload[33 + 1] >> 0) & 1;\nmsg.sc = (msg.payload[33 + 1] >> 1) & 1;\nmsg.ct = (msg.payload[33 + 1] >> 2) & 1;\nmsg.fce = (msg.payload[33 + 1] >> 3) & 1;\n\n\n  var yy;\n  var mm;\n  var dd;\n  var hh;\n  var min;\n\n  //year\n  if (msg.payload[28 + 1] < 10) {\n    yy = \"0\" + msg.payload[28 + 1]\n  } else {\n    yy = msg.payload[28 + 1]\n  }\n  //month\n  if (msg.payload[27 + 1] < 10) {\n    mm = \"0\" + msg.payload[27 + 1]\n  } else {\n    mm = msg.payload[27 + 1]\n  }\n  //day\n  if (msg.payload[26 + 1] < 10) {\n    dd = \"0\" + msg.payload[26 + 1]\n  } else {\n    dd = msg.payload[26 + 1]\n  }\n  //hour\n  if (msg.payload[24 + 1] < 10) {\n    hh = \"0\" + msg.payload[24 + 1]\n  } else {\n    hh = msg.payload[24 + 1]\n  }\n  //minutes\n  if (msg.payload[25 + 1] < 10) {\n    min = \"0\" + msg.payload[25 + 1]\n  } else {\n    min = msg.payload[25 + 1]\n  }\n\n  var clock = (\n    \"20\" + yy + \"-\" +\n    mm + \"-\" +\n    dd + \"T\" +\n    hh + \":\" +\n    min + \":00+0000\"\n  )\n\n  var clock2 = Math.trunc((((Date.now() - 10800000) - (Date.parse(clock) - 0)) / 1000));\n\n  if (clock2 > -600 && clock2 < 600) {// se a diferença for mais que 10 minutos\n\n    msg.clock = \"Data e hora sincronizada\"\n\n  } else {\n\n    msg.clock = \"Data e hora desincronizada\"\n\n  }\n  msg.partition_size = 2;\n\ndelete msg.payload\ndelete msg.port\ndelete msg.host\n\nreturn msg;\n}","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1910,"y":900,"wires":[["ddcda6701bb7919f","77b8327fa83917ba"]]},{"id":"7b6b881ef8c8882c","type":"ha-button","z":"77ee9ef7029ba7e3","g":"86569d2d471da717","name":"Central AMT - PGM 1 Desativar","version":0,"debugenabled":false,"outputs":1,"entityConfig":"50f5c53f1b61b974","outputProperties":[{"property":"button_press","propertyType":"msg","value":"Desativar PGM 1","valueType":"str"},{"property":"payload","propertyType":"msg","value":"comando_pgm_1_des","valueType":"flow"},{"property":"time","propertyType":"msg","value":"$moment(time).tz(\"America/Sao_Paulo\").format('D MMM HH:mm:ss - ') ","valueType":"jsonata"}],"x":160,"y":2540,"wires":[["7992f49608eba2a1"]]},{"id":"bea49bfad19e08c7","type":"ha-button","z":"77ee9ef7029ba7e3","g":"86569d2d471da717","name":"Central AMT - PGM 2 Desativar","version":0,"debugenabled":false,"outputs":1,"entityConfig":"baf6eaecce83380c","outputProperties":[{"property":"button_press","propertyType":"msg","value":"Desativar PGM 2","valueType":"str"},{"property":"payload","propertyType":"msg","value":"comando_pgm_2_des","valueType":"flow"},{"property":"tim