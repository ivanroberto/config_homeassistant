7ee9ef7029ba7e3","g":"f90ef85f198ec59d","name":"Central AMT - Zona 63","entityConfig":"87d602f6518fd4e9","version":0,"state":"zone_[63]","stateType":"msg","attributes":[{"property":"Disparada","value":"violated_[63]","valueType":"msg"},{"property":"Anulada","value":"anulated_[63]","valueType":"msg"},{"property":"Bateria Baixa","value":"lowbattery_[63]","valueType":"msg"}],"inputOverride":"allow","outputProperties":[],"x":4860,"y":1080,"wires":[[]]},{"id":"1b3847e5505475e1","type":"ha-binary-sensor","z":"77ee9ef7029ba7e3","g":"f90ef85f198ec59d","name":"Central AMT - Zona 64","entityConfig":"5b110c24951cff61","version":0,"state":"zone_[64]","stateType":"msg","attributes":[{"property":"Disparada","value":"violated_[64]","valueType":"msg"},{"property":"Anulada","value":"anulated_[64]","valueType":"msg"},{"property":"Bateria Baixa","value":"lowbattery_[64]","valueType":"msg"}],"inputOverride":"allow","outputProperties":[],"x":4860,"y":1140,"wires":[[]]},{"id":"973fab4155a2423c","type":"link in","z":"77ee9ef7029ba7e3","g":"f90ef85f198ec59d","name":"Sensores","links":["ddcda6701bb7919f"],"x":4715,"y":940,"wires":[["9507c4de1c62c778","61db9aab3ec30aa9","c54addbd88fc157e","bdeac1299bf5494c","1f859b415932e9b7","f508234909ed359b","9a7b6d583ba32e88","1b3847e5505475e1"]]},{"id":"3ea73c089db934a1","type":"link out","z":"77ee9ef7029ba7e3","name":"Indisponivel no boot","mode":"link","links":["847c6a15f74f3e09","6f5d1799e51c11f4"],"x":425,"y":440,"wires":[]},{"id":"064a7b0dcfa04b4e","type":"ha-sensor","z":"77ee9ef7029ba7e3","g":"5382b2d92857e002","name":"Central AMT - ACK","entityConfig":"7be159e771fc19a2","version":0,"state":"payload","stateType":"msg","attributes":[{"property":"Comando","value":"button_press","valueType":"msg"}],"inputOverride":"allow","outputProperties":[],"x":1910,"y":1000,"wires":[[]]},{"id":"927f96275245def8","type":"function","z":"77ee9ef7029ba7e3","g":"34bd985dca9ec842","name":"Sensores Adicionais (Set State)","func":"var i;\nvar entities = [];\nvar partitions = [4];\n\nif (flow.get(\"temp_entities\") === undefined) {\n   \n    const haCtx = global.get(\"homeassistant\"); const configCtx = haCtx.homeAssistant;\n    for (i = 0; i < 65; i++) {\n        if (i < 10) {\n            if (i > 0) {\n                entities[i] = configCtx.states[\"binary_sensor.central_amt_zona_0\" + [i]];\n            }\n        } else {\n            entities[i] = configCtx.states[\"binary_sensor.central_amt_zona_\" + [i]];\n        }\n    }\n    partitions[0] = configCtx.states[\"binary_sensor.central_amt_particao_a\"];\n    partitions[1] = configCtx.states[\"binary_sensor.central_amt_particao_b\"];\n    partitions[2] = configCtx.states[\"binary_sensor.central_amt_particao_c\"];\n    partitions[3] = configCtx.states[\"binary_sensor.central_amt_particao_d\"];\n\n    msg.entities = entities;\n    flow.set(\"temp_entities\", entities);\n    msg.partitions = partitions;\n    flow.set(\"temp_entities_partitions\", partitions);\n  }\nvar i;\nentities = flow.get(\"temp_entities\");// pegar o valor do flow_name\n\npartitions = flow.get(\"temp_entities_partitions\");// pegar o valor do flow_name\nmsg.partitions = partitions;\n\nvar zone_ = msg.zone_\nvar violated_ = msg.violated_\nvar anulated_ = msg.anulated_\nvar lowbattery_ = msg.lowbattery_\nvar tamper_ = msg.tamper_\nvar shortcircuit_ = msg.shortcircuit_\nvar aberta_count = 0;\nvar disparada_count = 0;\nvar anulada_count = 0;\nvar bateria_baixa_count = 0;\nvar tamper_count = 0;\nvar curto_circuito_count = 0;\nvar particoes_ativadas_count = 0;\n\nmsg.aberta = \"NA\"\nmsg.disparada = \"NA\";\nmsg.anulada = \"NA\";\nmsg.tamper = \"NA\";\nmsg.curto_circuito = \"NA\";\nmsg.bateria_baixa = \"NA\";\nmsg.particoes_ativadas = \"NA\";\n\nfor (i = 0; i < 65; i++) {\n\n    if (i > 0) {\n\n        entities[i].state = zone_[i];\n        entities[i].attributes.disparada = violated_[i];\n        entities[i].attributes.anulada = anulated_[i];\n        entities[i].attributes.bateria_baixa = lowbattery_[i];\n\n        if (entities[i].state == 1) {\n            msg.aberta = msg.aberta + \", \" + entities[i].attributes.friendly_name\n            aberta_count++;\n        }\n\n        if (entities[i].attributes.disparada == 1) {\n            msg.disparada = msg.disparada + \", \" + entities[i].attributes.friendly_name;\n            disparada_count++;\n\n        }\n\n        if (entities[i].attributes.anulada == 1) {\n            msg.anulada = msg.anulada + \", \" + entities[i].attributes.friendly_name\n            anulada_count++;\n\n        }\n\n        if (entities[i].attributes.bateria_baixa == 1) {\n            msg.bateria_baixa = msg.bateria_baixa + \", \" + entities[i].attributes.friendly_name\n            bateria_baixa_count++;\n\n        }\n\n        if ((i < 19) && (i != 9) && (i != 10)) {\n            //if (i < 19) {\n            entities[i].attributes.tamper = tamper_[i]\n            entities[i].attributes.curto_circuito = shortcircuit_[i]\n\n            if (entities[i].attributes.tamper == 1) {\n                msg.tamper = msg.tamper + \", \" + entities[i].attributes.friendly_name\n                tamper_count++;\n\n            }\n\n            if (entities[i].attributes.curto_circuito == 1) {\n                msg.curto_circuito = msg.curto_circuito + \", \" + entities[i].attributes.friendly_name\n                curto_circuito_count++;\n\n            }\n        }\n\n\n\n    }\n}\n\n\npartitions[0].state = msg.partition_a;\npartitions[1].state = msg.partition_b;\npartitions[2].state = msg.partition_c;\npartitions[3].state = msg.partition_d;\n\nfor (i = 0; i < partitions.length; i++) {\n\n    if (partitions[i].state == true) {\n        msg.particoes_ativadas = msg.particoes_ativadas + \", \" + partitions[i].attributes.friendly_name.replace(\"Central AMT - PARTIÇÃO \", \"\")\n        particoes_ativadas_count++;\n    }\n\n}\nmsg.particoes_ativadas = msg.particoes_ativadas.replace(\"NA, \", \"\");\n\nmsg.entities = entities; // apenas para teste\nmsg.aberta = msg.aberta.replace(\"NA, \", \"\");\nmsg.disparada = msg.disparada.replace(\"NA, \", \"\");\nmsg.anulada = msg.anulada.replace(\"NA, \", \"\");\nmsg.tamper = msg.tamper.replace(\"NA, \", \"\");\nmsg.curto_circuito = msg.curto_circuito.replace(\"NA, \", \"\");\nmsg.bateria_baixa = msg.bateria_baixa.replace(\"NA, \", \"\");\n\nmsg.aberta_count = aberta_count;\nmsg.disparada_count = disparada_count;\nmsg.anulada_count = anulada_count;\nmsg.bateria_baixa_count = bateria_baixa_count;\nmsg.tamper_count = tamper_count;\nmsg.curto_circuito_count = curto_circuito_count;\nmsg.particoes_ativadas_count = particoes_ativadas_count;\n\ndelete msg.entities\ndelete msg.partitions\n\n\ndelete msg.zone_\ndelete msg.violated_\ndelete msg.anulated_\ndelete msg.lowbattery_\ndelete msg.tamper_\ndelete msg.shortcircuit_\ndelete msg.fw\ndelete msg.model\ndelete msg.partition_a\ndelete msg.partition_b\ndelete msg.partition_c\ndelete msg.partition_d\ndelete msg.pc\ndelete msg.za\ndelete msg.activated\ndelete msg.cd\ndelete msg.acpower\ndelete msg.b_baixa\ndelete msg.b_con\ndelete msg.b_curto\ndelete msg.s_aux\ndelete msg.pt_\ndelete msg.pr_\ndelete msg.pep_\ndelete msg.pez_\ndelete msg.bateria\ndelete msg.tc_\ndelete msg.ss\ndelete msg.pgm_1\ndelete msg.pgm_2\ndelete msg.pgm_3\ndelete msg.scf\ndelete msg.sc\ndelete msg.ct\ndelete msg.fce\ndelete msg.clock\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":2550,"y":260,"wires":[["240968693361e71a","0702aca098381626","7cb71b9c8e232ec1","89696e6457158bd8","f09b068fb0caa766","dec379c7f3c41596","e62be6ea86f43823","31cfedc7055e3aa9"]]},{"id":"dec379c7f3c41596","type":"ha-sensor","z":"77ee9ef7029ba7e3","g":"4781abea0e422d71","name":"Central AMT - Zonas Abertas","entityConfig":"30a5d2643ae1ffbb","version":0,"state":"aberta","stateType":"msg","attributes":[{"property":"Abertas","value":"aberta_count","valueType":"msg"}],"inputOverride":"allow","outputProperties":[],"x":2880,"y":100,"wires":[[]]},{"id":"f09b068fb0caa766",