   return { payload: \"on\" };\n\nif (msg.payload === \"off\")\n    return { payload: \"off\" };\n\nreturn null;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":390,"y":440,"wires":[["ha_input_boolean"]]},{"id":"ha_input_boolean","type":"api-call-service","z":"dw_tab_001","name":"Lembrete Ligar Lava Louças","server":"home_assistant","version":7,"debugenabled":false,"action":"input_boolean.turn_{{payload}}","floorId":[],"areaId":[],"deviceId":[],"entityId":["input_boolean.lembrete_ligar_lava_loucas"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"input_boolean","service":"turn_{{payload}}","x":660,"y":440,"wires":[[]]},{"id":"debug_v31","type":"debug","z":"dw_tab_001","name":"DEBUG LAVA v4.0","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":410,"y":500,"wires":[]},{"id":"1de31472921a6cca","type":"link in","z":"dw_tab_001","name":"link in 7","links":["89038c1268f6dcf8"],"x":55,"y":440,"wires":[["engine_v31"]]},{"id":"89038c1268f6dcf8","type":"link out","z":"dw_tab_001","name":"link out 9","mode":"link","links":["1de31472921a6cca"],"x":415,"y":260,"wires":[]},{"id":"038a5183fdd51d01","type":"server-state-changed","z":"dw_tab_001","name":"Movimento","server":"12097a98.a70645","version":6,"outputs":2,"exposeAsEntityConfig":"","entities":{"entity":["binary_sensor.presenca_sala_tv_presence","binary_sensor.mmwave_cozinha_presence"],"substring":[],"regex":[]},"outputInitially":false,"stateType":"str","ifState":"on","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"","forType":"num","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"topic","propertyType":"msg","value":"motion","valueType":"str"},{"property":"payload","propertyType":"msg","value":"on","valueType":"str"}],"x":100,"y":120,"wires":[["89038c1268f6dcf8"],[]]},{"id":"engine_v31","type":"function","z":"dw_tab_001","name":"Lava Engine v5.6","func":"/**\n * ============================================================\n * LAVA ENGINE v5.6 (COMPLETO E DOCUMENTADO)\n * ============================================================\n *\n * FINALIDADE\n * ------------------------------------------------------------\n * Automatizar avisos da lava-louças via Node-RED.\n *\n * FUNÇÕES:\n *\n * 1) Detecta máquina ligada por consumo sustentado, mas somente\n *      considera a máquina efetivamente em funcionamento se a\n *      potência alta for observada com a porta já fechada.\n * 2) Após deploy/restart, o estado da porta só é considerado\n *      confiável depois do primeiro evento real do sensor de\n *      porta. Enquanto isso, potência alta não pode iniciar\n *      o processo de partida.\n * 3) Se a potência alta ocorrer com a porta aberta, essa condição\n *      é ignorada e não pode ser reaproveitada após o fechamento\n *      da porta; nesse caso, o sistema aguarda um novo evento de\n *      potência alta com a porta já fechada.\n * 4) Detecta fim do ciclo apenas após potência baixa sustentada\n *      por tempo suficiente, evitando falsos positivos causados\n *      por oscilações normais durante a lavagem.\n * 5) Após fim do ciclo:\n *      entra em estado de espera para abertura da porta.\n * 6) Nesse estado de espera:\n *      envia alerta para abrir porta imediatamente ao confirmar\n *      o fim do ciclo.\n * 7) Repete alerta de abrir porta no intervalo configurado\n *      como fallback.\n * 8) Enquanto estiver aguardando abrir a porta, se houver\n *      movimento também envia o alerta para abrir a porta,\n *      aproveitando a presença de alguém no ambiente.\n * 9) Se o alerta de abrir porta for enviado por movimento,\n *      o timer do fallback periódico é reiniciado a partir\n *      desse novo aviso.\n * 10) Se a porta for aberta durante RUNNING, isso é tratado como\n *      interrupção prematura/erro:\n *      - envia aviso específico apenas para fala\n *      - encerra o ciclo imediatamente\n *      - não passa por confirmação de fim\n *      - deixa o sistema pronto para um novo ciclo\n * 11) Quando a porta fecha com máquina desligada, entra\n *      imediatamente no modo \"pronta para ligar\".\n * 12) Após entrar no modo \"pronta para ligar\", aguarda um\n *      atraso inicial configurável antes de permitir avisos\n *      por movimento para lembrar de ligar.\n * 13) Se a porta for aberta enquanto estiver no modo\n *      \"pronta para ligar\", aborta o processo sem enviar alerta.\n * 14) Quando houver movimento e a flag ON, só envia lembrete\n *      de ligar se o atraso inicial já tiver expirado.\n * 15) Quando máquina liga:\n *      remove flag lembrete ligar.\n * 16) No system_init, a engine executa uma normalização\n *      defensiva do contexto persistido para evitar resíduos\n *      de deploys/reinícios anteriores.\n *\n *\n * ENTRADAS ESPERADAS\n * ------------------------------------------------------------\n * msg.topic = \"power\"          payload = potência numérica\n * msg.topic = \"door\"           payload = on/off\n * msg.topic = \"motion\"         payload = on\n * msg.topic = \"reminder_flag\"  payload = on/off\n * msg.topic = \"system_init\"\n *\n * Convenção da porta:\n *   door = on  -> porta aberta\n *   door = off -> porta fechada\n *\n *\n * SAÍDAS\n * ------------------------------------------------------------\n * saída 1 = ações para Router\n * saída 2 = ligar/desligar input_boolean\n * saída 3 = debug/log\n *\n *\n * ESTADOS INTERNOS\n * ------------------------------------------------------------\n * IDLE              = desligada aguardando uso\n * START_PENDING     = potência alta aguardando confirmação\n * RUNNING           = ligada lavando\n * STOP_PENDING      = potência baixa aguardando confirmação\n * WAITING_DOOR      = terminou e aguardando abrir porta\n *\n *\n * CONFIGURAÇÕES\n * ------------------------------------------------------------\n */\n\nconst CFG = {\n    POWER_ON_W: 20,\n    POWER_OFF_W: 10,\n    POWER_ON_CONFIRM_SEC: 10,\n    POWER_OFF_CONFIRM_SEC: 65,\n    POWER_MIN_DELTA_W: 5,\n    ALERT_OPEN_DOOR_EVERY_SEC: 15*60,\n    ALERT_START_EVERY_SEC: 20*60,\n    START_REMINDER_ARM_DELAY_SEC: 20*60,\n    DEBUG: false\n};\n\nconst TXT = {\n    OPEN_DOOR: \"remind_open_door\",\n    START: \"remind_launch\",\n    ACK: \"cycle_complete_ack\",\n    DOOR_OPEN_ERROR: \"door_open_premature_error\"\n};\n\nfunction baseState(){\n    return {\n        state: \"IDLE\",\n        reminderFlag: false,\n        doorOpen: false,\n        doorStateKnown: false,\n\n        powerOnTimer: null,\n        powerOffTimer: null,\n        doorTimer: null,\n\n        powerOnSince: 0,\n        powerOffSince: 0,\n\n        lastStartAlert: 0,\n        reminderArmAt: 0,\n\n        lastPower: null,\n        awaitingFreshPowerHighAfterDoorClose: false\n    };\n}\n\nfunction normalizeState(raw){\n    const b = baseState();\n    const src = raw || {};\n\n    return {\n        state: [\"IDLE\", \"START_PENDING\", \"RUNNING\", \"STOP_PENDING\", \"WAITING_DOOR\"].includes(src.state)\n            ? src.state\n            : b.state,\n\n        reminderFlag: typeof src.reminderFlag === \"boolean\" ? src.reminderFlag : b.reminderFlag,\n        doorOpen: typeof src.doorOpen === \"boolean\" ? src.doorOpen : b.doorOpen,\n        doorStateKnown: typeof src.doorStateKnown === \"boolean\" ? src.doorStateKnown : b.doorStateKnown,\n\n        powerOnTimer: null,\n        powerOffTimer: null,\n        doorTimer: null,\n\n        powerOnSince: Number(src.powerOnSince || 0),\n        powerOffSince: Number(src.powerOffSince || 0),\n\n        lastStartAlert: Number(src.lastStartAlert || 0),\n        reminderArmAt: Number(src.reminderArmAt || 0),\n\n        lastPower: (src.lastPower === null || src.lastPower === undefined || Number.isNaN(Number(src.lastPower)))\n            ? null\n            : Number(src.lastPower),\n\n        awaitingFreshPowerHighAfterDoorClose: typeof src.awaitingFreshPowerHighAfterDoorClose === \"boolean\"\n            ? src.awaitingFreshPowerHighAfterDoorClose\n            : b.awaitingFreshPowerHighAfterDoorClose\n    };\n}\n\nlet s = normalizeState(flow.get(\"lava_v56\"));\n\nconst now = Date.now();\nconst topic = msg.topic || \"\";\nconst val = String(msg.payload || \"\").toLowerCase();\n\nlet out1 = null;\nlet out2 = null;\nlet out3 = null;\n\nfunction save(){\n    flow.set(\"lava_v56\", s);\n}\n\nfunction log(txt){\n    if(!CFG.DEBUG) return null;\n    return {payload: txt};\n}\n\nfunction actionMsg(action, origin){\n    return { payload: { action, origin } };\n}\n\nfunction secElapsed(ts){\n    if(!ts) return 0;\n    return Math.floor((Date.now() - ts) / 1000);\n}\n\nfunction secRemaining(ts, totalSec){\n    if(!ts) return totalSec;\n    const remain = totalSec - secElapsed(ts);\n    return remain > 0 ? remain : 0;\n}\n\nfunction clearPowerOnTimer(){\n    if(s.powerOnTimer){\n        clearTimeout(s.powerOnTimer);\n        s.powerOnTimer = null;\n    }\n    s.powerOnSince = 0;\n}\n\nfunction clearPowerOffTimer(){\n    if(s.powerOffTimer){\n        clearTimeout(s.powerOffTimer);\n        s.powerOffTimer = null;\n    }\n    s.powerOffSince = 0;\n}\n\nfunction clearDoorTimer(){\n    if(s.doorTimer){\n        clearInterval(s.doorTimer);\n        s.doorTimer = null;\n    }\n}\n\nfunction clearAllCycleTimers(){\n    clearPowerOnTimer();\n    clearPowerOffTimer();\n    clearDoorTimer();\n}\n\nfunction resetStartReminderState(){\n    s.reminderFlag = false;\n    s.reminderArmAt = 0;\n    s.lastStartAlert = 0;\n}\n\nfunction abortStartReminderMode(){\n    resetStartReminderState();\n    if(s.state === \"IDLE\") return;\n    if(s.state !== \"START_PENDING\" && s.state !== \"RUNNING\" && s.state !== \"STOP_PENDING\" && s.state !== \"WAITING_DOOR\") {\n        s.state = \"IDLE\";\n    }\n}\n\nfunction startDoorReminder(){\n    clearDoorTimer();\n\n    s.doorTimer = setInterval(()=>{\n        let st = normalizeState(flow.get(\"lava_v56\"));\n\n        if(!st || st.state !== \"WAITING_DOOR\"){\n            if(st && st.doorTimer){\n                clearInterval(st.doorTimer);\n                st.doorTimer = null;\n                flow.set(\"lava_v56\", st);\n            }\n            return;\n        }\n\n        node.send([\n            actionMsg(TXT.OPEN_DOOR, \"timer\"),\n            null,\n            {payload:\"[ALERT] lembrar abrir porta\"}\n        ]);\n\n    }, CFG.ALERT_OPEN_DOOR_EVERY_SEC * 1000);\n}\n\nfunction restartDoorReminder(){\n    if(s.state === \"WAITING_DOOR\"){\n        startDoorReminder();\n    }\n}\n\nfunction startPowerOnConfirmation(){\n    if(s.powerOnTimer) return;\n\n    s.state = \"START_PENDING\";\n    s.powerOnSince = Date.now();\n\n    s.powerOnTimer = setTimeout(()=>{\n        let st = normalizeState(flow.get(\"lava_v56\"));\n\n        if(!st) return;\n        if(st.state !== \"START_PENDING\") return;\n        if(!st.doorStateKnown) return;\n        if(st.doorOpen) return;\n        if(Number(st.lastPower || 0) <= CFG.POWER_ON_W) return;\n\n        st.state = \"RUNNING\";\n        st.powerOnTimer = null;\n        st.powerOnSince = 0;\n        st.reminderFlag = false;\n        st.reminderArmAt = 0;\n        st.lastStartAlert = 0;\n        st.awaitingFreshPowerHighAfterDoorClose = false;\n        flow.set(\"lava_v56\", st);\n\n        node.send([\n            null,\n            {payload:\"off\"},\n            {payload:\"[STATE] RUNNING confirmado por potência alta sustentada\"}\n        ]);\n\n    }, CFG.POWER_ON_CONFIRM_SEC * 1000);\n}\n\nfunction startPowerOffConfirmation(){\n    if(s.powerOffTimer) return;\n\n    s.state = \"STOP_PENDING\";\n    s.powerOffSince = Date.now();\n\n    s.powerOffTimer = setTimeout(()=>{\n        let st = normalizeState(flow.get(\"lava_v56\"));\n\n        if(!st) return;\n        if(st.state !== \"STOP_PENDING\") return;\n        if(Number(st.lastPower || 0) > CFG.POWER_OFF_W) return;\n\n        st.state = \"WAITING_DOOR\";\n        st.powerOffTimer = null;\n        st.powerOffSince = 0;\n        flow.set(\"lava_v56\", st);\n\n        node.send([\n            actionMsg(TXT.OPEN_DOOR, \"timer\"),\n            null,\n            {payload:\"[ALERT] lembrar abrir porta (fim ciclo confirmado)\"}\n        ]);\n\n        startDoorReminder();\n\n    }, CFG.POWER_OFF_CONFIRM_SEC * 1000);\n}\n\nfunction enterReadyToStartMode(){\n    s.state = \"IDLE\";\n    s.reminderFlag = true;\n    s.reminderArmAt = Date.now() + (CFG.START_REMINDER_ARM_DELAY_SEC * 1000);\n    s.lastStartAlert = 0;\n}\n\nfunction startReminderArmed(){\n    return s.reminderFlag && now >= Number(s.reminderArmAt || 0);\n}\n\nif(topic === \"system_init\"){\n    const preservedLastPower = s.lastPower;\n\n    s = baseState();\n    s.lastPower = preservedLastPower;\n\n    save();\n    out2 = {payload:\"off\"};\n    out3 = log(`[INIT] engine normalizado com reset defensivo; aguardando primeiro evento real da porta (lastPower=${s.lastPower})`);\n}\n\nelse if(topic === \"power\"){\n\n    const p = Number(val);\n\n    if(Number.isNaN(p)){\n        out3 = log(\"[BLOCK] leitura de potência inválida\");\n    }\n    else {\n\n        const prevPower = s.lastPower;\n        s.lastPower = p;\n\n        const delta = (prevPower === null || prevPower === undefined)\n            ? null\n            : Math.abs(p - prevPower);\n\n        const meaningfulChange = (delta === null) || (delta >= CFG.POWER_MIN_DELTA_W);\n\n        if(!s.doorStateKnown){\n            out3 = log(\"[BLOCK] potência ignorada para partida: estado da porta ainda não foi confirmado após o deploy\");\n        }\n\n        else if(p > CFG.POWER_ON_W){\n\n            if(s.doorOpen){\n                if(s.state === \"START_PENDING\"){\n                    clearPowerOnTimer();\n                    s.state = \"IDLE\";\n                }\n                s.awaitingFreshPowerHighAfterDoorClose = true;\n                out3 = log(\"[BLOCK] consumo alto ignorado: porta aberta\");\n            }\n            else {\n                if(s.awaitingFreshPowerHighAfterDoorClose){\n                    s.awaitingFreshPowerHighAfterDoorClose = false;\n                    out3 = log(\"[STATE] novo evento de potência alta detectado com porta fechada -> início agora permitido\");\n                }\n\n                if(s.powerOffTimer){\n                    const elapsed = secElapsed(s.powerOffSince);\n                    clearPowerOffTimer();\n                    if(s.state === \"STOP_PENDING\"){\n                        s.state = \"RUNNING\";\n                        out3 = log(`[STATE] STOP_PENDING cancelado: potência voltou a subir após ${elapsed}s em baixa`);\n                    }\n                }\n\n                if(s.state === \"IDLE\"){\n                    startPowerOnConfirmation();\n                    out3 = log(`[STATE] START_PENDING iniciado: potência > ${CFG.POWER_ON_W}W por ${CFG.POWER_ON_CONFIRM_SEC}s`);\n                }\n\n                else if(s.state === \"START_PENDING\" && meaningfulChange){\n                    out3 = log(`[TRACE] START_PENDING em andamento: potência=${p}W, falta ~${secRemaining(s.powerOnSince, CFG.POWER_ON_CONFIRM_SEC)}s para confirmar RUNNING`);\n                }\n            }\n        }\n\n        else if(p <= CFG.POWER_OFF_W){\n\n            if(s.state === \"START_PENDING\"){\n                const elapsed = secElapsed(s.powerOnSince);\n                clearPowerOnTimer();\n                s.state = \"IDLE\";\n                out3 = log(`[STATE] START_PENDING cancelado: potência caiu antes da confirmação após ${elapsed}s`);\n            }\n\n            else if(s.state === \"RUNNING\"){\n                startPowerOffConfirmation();\n                out3 = log(`[STATE] STOP_PENDING iniciado: potência <= ${CFG.POWER_OFF_W}W por ${CFG.POWER_OFF_CONFIRM_SEC}s`);\n            }\n\n            else if(s.state === \"STOP_PENDING\" && meaningfulChange){\n                out3 = log(`[TRACE] STOP_PENDING em andamento: potência=${p}W, falta ~${secRemaining(s.powerOffSince, CFG.POWER_OFF_CONFIRM_SEC)}s para confirmar fim do ciclo`);\n            }\n        }\n\n        else {\n            if(s.state === \"START_PENDING\"){\n                const elapsed = secElapsed(s.powerOnSince);\n                clearPowerOnTimer();\n                s.state = \"IDLE\";\n                out3 = log(`[STATE] START_PENDING cancelado: potência saiu da faixa de partida após ${elapsed}s`);\n            }\n\n            else if(s.state === \"STOP_PENDING\"){\n                const elapsed = secElapsed(s.powerOffSince);\n                clearPowerOffTimer();\n                s.state = \"RUNNING\";\n                out3 = log(`[STATE] STOP_PENDING cancelado: potência saiu da faixa de fim após ${elapsed}s`);\n            }\n\n            else if(meaningfulChange){\n                out3 = log(`[TRACE] potência em faixa intermediária: ${p}W`);\n            }\n        }\n    }\n}\n\nelse if(topic === \"door\"){\n\n    s.doorStateKnown = true;\n    s.doorOpen = (val === \"on\");\n\n    if(val === \"off\"){\n\n        clearPowerOnTimer();\n        clearPowerOffTimer();\n\n        if(s.state !== \"RUNNING\" && s.state !== \"WAITING_DOOR\"){\n            s.state = \"IDLE\";\n        }\n\n        if(s.state === \"IDLE\"){\n            enterReadyToStartMode();\n            out2 = {payload:\"on\"};\n\n            if(Number(s.lastPower || 0) > CFG.POWER_ON_W){\n                s.awaitingFreshPowerHighAfterDoorClose = true;\n                out3 = log(\"[RULE] porta fechada -> modo pronta para ligar ativado; potência já está alta, mas será ignorada até ocorrer um novo evento de potência com a porta fechada\");\n            } else {\n                s.awaitingFreshPowerHighAfterDoorClose = false;\n                out3 = log(\"[RULE] porta fechada -> modo pronta para ligar ativado (mensagens após atraso inicial)\");\n            }\n        }\n    }\n\n    if(val === \"on\"){\n\n        if(s.state === \"RUNNING\" || s.state === \"STOP_PENDING\"){\n\n            clearAllCycleTimers();\n\n            s.state = \"IDLE\";\n            resetStartReminderState();\n            s.awaitingFreshPowerHighAfterDoorClose = false;\n\n            out1 = actionMsg(TXT.DOOR_OPEN_ERROR, \"event\");\n            out2 = {payload:\"off\"};\n            out3 = log(\"[ERROR] porta aberta prematuramente durante lavagem\");\n        }\n\n        else if(s.state === \"WAITING_DOOR\"){\n\n            clearAllCycleTimers();\n\n            s.state = \"IDLE\";\n            resetStartReminderState();\n            s.awaitingFreshPowerHighAfterDoorClose = false;\n\n            out1 = actionMsg(TXT.ACK, \"event\");\n            out2 = {payload:\"off\"};\n            out3 = log(\"[RULE] porta aberta após ciclo\");\n        }\n\n        else if(s.state === \"START_PENDING\"){\n\n            const elapsed = secElapsed(s.powerOnSince);\n            clearPowerOnTimer();\n            s.state = \"IDLE\";\n            resetStartReminderState();\n            s.awaitingFreshPowerHighAfterDoorClose = false;\n\n            out2 = {payload:\"off\"};\n            out3 = log(`[RULE] porta aberta -> cancelar confirmação de início após ${elapsed}s`);\n        }\n\n        else if(s.reminderFlag){\n\n            abortStartReminderMode();\n            s.awaitingFreshPowerHighAfterDoorClose = false;\n            out2 = {payload:\"off\"};\n            out3 = log(\"[RULE] porta aberta -> abortar modo pronta para ligar\");\n        }\n    }\n}\n\nelse if(topic === \"motion\"){\n\n    out3 = log(`[MOTION] state=${s.state} flag=${s.reminderFlag}`);\n\n    if(s.state === \"WAITING_DOOR\"){\n        out1 = actionMsg(TXT.OPEN_DOOR, \"motion\");\n        restartDoorReminder();\n        out3 = log(\"[RULE] movimento detectado -> lembrar abrir porta + reset fallback\");\n    }\n\n    else if(s.reminderFlag){\n\n        if(!startReminderArmed()){\n            const remainMs = Number(s.reminderArmAt || 0) - now;\n            const remainSec = remainMs > 0 ? Math.ceil(remainMs / 1000) : 0;\n            out3 = log(`[BLOCK] movimento ignorado: atraso inicial do modo pronta para ligar ainda ativo (~${remainSec}s restantes)`);\n        }\n        else if(now - s.lastStartAlert >= CFG.ALERT_START_EVERY_SEC*1000){\n\n            s.lastStartAlert = now;\n            out1 = actionMsg(TXT.START, \"motion\");\n            out3 = log(\"[RULE] movimento detectado -> lembrar ligar\");\n        }\n        else {\n            const remainSec = Math.ceil((CFG.ALERT_START_EVERY_SEC*1000 - (now - s.lastStartAlert)) / 1000);\n            out3 = log(`[BLOCK] movimento ignorado: limiter interno do remind_launch ainda ativo (~${remainSec}s restantes)`);\n        }\n    }\n}\n\nelse if(topic === \"reminder_flag\"){\n\n    s.reminderFlag = (val === \"on\");\n    if(!s.reminderFlag){\n        s.reminderArmAt = 0;\n        s.lastStartAlert = 0;\n    }\n    out3 = log(\"[IN] reminder_flag=\" + val);\n}\n\nsave();\nreturn [out1,out2,out3];","outputs":3,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":190,"y":440,"wires":[["router_v31"],["side_effects_v31"],["debug_v31"]]},{"id":"router_v31","type":"function","z":"dw_tab_001","name":"Router Ações v5.5","func":"/**\n * ============================================================\n * ROUTER AÇÕES v5.5\n * ------------------------------------------------------------\n * Recebe:\n *   msg.payload.action\n *   msg.payload.origin\n *\n * E distribui para 3 saídas:\n *\n * OUTPUT 1 -> FALA (Google Home / Alexa / TTS)\n * OUTPUT 2 -> DISPLAYS (NSPanel / LCD / Telegram / etc)\n * OUTPUT 3 -> SIRENE / BEEP / CAMPAINHA\n *\n * ============================================================\n * MATRIZ DE ENTREGA\n * ------------------------------------------------------------\n * Google Home:\n *   recebe todas as mensagens\n *\n * Display:\n *   recebe somente:\n *     - remind_launch\n *     - remind_open_door\n *\n * Sirene:\n *   recebe somente:\n *     - remind_open_door\n *\n * ============================================================\n * AÇÕES SUPORTADAS\n * ------------------------------------------------------------\n * remind_launch              -> lembrar ligar lava louças\n * cycle_finished             -> ciclo terminou\n * remind_open_door           -> abrir porta\n * cycle_complete_ack         -> porta aberta confirmada\n * door_open_premature_error  -> porta aberta durante lavagem\n *\n * ============================================================\n * RATE LIMIT POR DISPOSITIVO\n * ------------------------------------------------------------\n * O limiter é aplicado somente para mensagens com origem\n * \"motion\".\n *\n * Mensagens com origem diferente de \"motion\" não entram no\n * limiter, como por exemplo mensagens periódicas de fallback\n * e eventos imediatos do fluxo.\n *\n * Há um limiter independente para:\n *   - fala\n *   - display\n *   - sirene\n *\n * A configuração é feita por intervalo mínimo, em segundos,\n * entre mensagens originadas por movimento.\n *\n * Use 0 para desabilitar o limiter de um canal.\n *\n * Se a action mudar, os limitadores são resetados para que a\n * nova mensagem importante possa ser entregue imediatamente.\n *\n * ============================================================\n * CONFIGURAÇÃO DA SIRENE\n * ------------------------------------------------------------\n * Para mensagens que devem acionar a sirene, o router envia\n * parâmetros extras no msg para permitir configuração por ação:\n *\n *   msg.payload   = \"on\"\n *   msg.volume    = volume desejado\n *   msg.melodia   = melodia desejada\n *   msg.duracao_s = duração desejada em segundos\n *\n * IMPORTANTE:\n * O subflow da sirene precisa estar preparado para ler esses\n * campos da msg e usá-los como override das variáveis de env.\n *\n * ============================================================\n * FRASES E PARÂMETROS CONFIGURÁVEIS\n * ------------------------------------------------------------\n * Ajuste os textos e parâmetros abaixo livremente.\n */\n\nconst CFG = {\n\n    // ===== LIMITER DE MENSAGENS VIA MOVIMENTO =====\n    SPEECH_MOTION_MIN_INTERVAL_SEC: 60,\n    DISPLAY_MOTION_MIN_INTERVAL_SEC: 60,\n    SIREN_MOTION_MIN_INTERVAL_SEC: 60,\n\n\n    // ===== FALA =====\n    SPEECH_REMIND_LAUNCH:\n        \"Atenção! Lava louças porta fechada\",\n\n    SPEECH_CYCLE_FINISHED:\n        \"Lava louças terminou.\",\n\n    SPEECH_REMIND_OPEN_DOOR:\n        \"Atenção. Lava louças terminou.\",\n\n    SPEECH_ACK:\n        \"Porta aberta.\",\n\n    SPEECH_DOOR_OPEN_PREMATURE_ERROR:\n        \"Atenção. Porta lava-louças aberta prematuramente!\",\n\n\n    // ===== DISPLAY =====\n    LCD_REMIND_LAUNCH:\n        \"LIGAR LAVA LOUCAS\",\n\n    LCD_CYCLE_FINISHED:\n        \"LAVAGEM FINALIZADA\",\n\n    LCD_REMIND_OPEN_DOOR:\n        \"ABRIR PORTA\",\n\n    LCD_ACK:\n        \"PORTA ABERTA OK\",\n\n\n    // ===== SIRENE =====\n    // Sirene só é enviada para remind_open_door.\n    // Estes parâmetros são encaminhados via msg.\n    SIREN_REMIND_OPEN_DOOR_VOLUME: \"medium\",\n    SIREN_REMIND_OPEN_DOOR_MELODIA: 15,\n    SIREN_REMIND_OPEN_DOOR_DURACAO_S: 4\n};\n\nconst action = msg.payload?.action;\nconst origin = msg.payload?.origin || \"event\";\n\nif (!action) return null;\n\nlet rl = flow.get(\"lava_router_rl_v55\") || {\n    lastAction: null,\n    speechLastTs: 0,\n    displayLastTs: 0,\n    sirenLastTs: 0\n};\n\nconst now = Date.now();\n\nfunction resetLimiters() {\n    rl.speechLastTs = 0;\n    rl.displayLastTs = 0;\n    rl.sirenLastTs = 0;\n}\n\nif (rl.lastAction !== action) {\n    resetLimiters();\n    rl.lastAction = action;\n}\n\nfunction buildSpeechMsg(text) {\n    if (!text) return null;\n    return { payload: text };\n}\n\nfunction buildDisplayMsg(text) {\n    if (!text) return null;\n    return { payload: text };\n}\n\nfunction buildSirenMsg(cfg) {\n    if (!cfg) return null;\n    return {\n        payload: \"on\",\n        volume: cfg.volume,\n        melodia: cfg.melodia,\n        duracao_s: cfg.duracao_s\n    };\n}\n\nfunction allowMotionByInterval(minIntervalSec, lastTsKey) {\n    if (origin !== \"motion\") {\n        return true;\n    }\n\n    const sec = Number(minIntervalSec || 0);\n\n    if (sec <= 0) {\n        rl[lastTsKey] = now;\n        return true;\n    }\n\n    const minIntervalMs = sec * 1000;\n    const lastTs = Number(rl[lastTsKey] || 0);\n    const elapsed = now - lastTs;\n\n    if (lastTs === 0 || elapsed >= minIntervalMs) {\n        rl[lastTsKey] = now;\n        return true;\n    }\n\n    return false;\n}\n\nfunction routeWithLimiter(speechText, lcdText, sirenCfg) {\n    const speechAllowed = !!speechText && allowMotionByInterval(CFG.SPEECH_MOTION_MIN_INTERVAL_SEC, \"speechLastTs\");\n    const displayAllowed = !!lcdText && allowMotionByInterval(CFG.DISPLAY_MOTION_MIN_INTERVAL_SEC, \"displayLastTs\");\n    const sirenAllowed = !!sirenCfg && allowMotionByInterval(CFG.SIREN_MOTION_MIN_INTERVAL_SEC, \"sirenLastTs\");\n\n    flow.set(\"lava_router_rl_v55\", rl);\n\n    return [\n        speechAllowed ? buildSpeechMsg(speechText) : null,\n        displayAllowed ? buildDisplayMsg(lcdText) : null,\n        sirenAllowed ? buildSirenMsg(sirenCfg) : null\n    ];\n}\n\nswitch (action) {\n\n    case \"remind_launch\":\n        return routeWithLimiter(\n            CFG.SPEECH_REMIND_LAUNCH,\n            CFG.LCD_REMIND_LAUNCH,\n            null\n        );\n\n    case \"cycle_finished\":\n        return routeWithLimiter(\n            CFG.SPEECH_CYCLE_FINISHED,\n            null,\n            null\n        );\n\n    case \"remind_open_door\":\n        return routeWithLimiter(\n            CFG.SPEECH_REMIND_OPEN_DOOR,\n            CFG.LCD_REMIND_OPEN_DOOR,\n            {\n                volume: CFG.SIREN_REMIND_OPEN_DOOR_VOLUME,\n                melodia: CFG.SIREN_REMIND_OPEN_DOOR_MELODIA,\n                duracao_s: CFG.SIREN_REMIND_OPEN_DOOR_DURACAO_S\n            }\n        );\n\n    case \"cycle_complete_ack\":\n        return routeWithLimiter(\n            CFG.SPEECH_ACK,\n            null,\n            null\n        );\n\n    case \"door_open_premature_error\":\n        flow.set(\"lava_router_rl_v55\", rl);\n        return [\n            buildSpeechMsg(CFG.SPEECH_DOOR_OPEN_PREMATURE_ERROR),\n            null,\n            null\n        ];\n}\n\nflow.set(\"lava_router_rl_v55\", rl);\nreturn null;","outputs":3,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":410,"y":380,"wires":[["gh_fala"],["lcd_dw"],["4d0d1d77277218e5"]]},{"id":"4d0d1d77277218e5","type":"subflow:45ac7027649c1693","z":"dw_tab_001","name":"","x":620,"y":400,"wires":[]},{"id":"3313c84d.bd4528","type":"link in","z":"8dba0687.56c238","name":"Dispositivo 1º Andar","links":["5bf6b75a.2d2f28","b58b9d382574c968","f898bfd08564d164","43e968cbebd82fad"],"x":55,"y":120,"wires":[["46943032.3feb6"]]},{"id":"46943032.3feb6","type":"switch","z":"8dba0687.56c238","name":"","property":"payload","propertyType":"msg","rules":[{"t":"eq","v":"on","vt":"str"},{"t":"else"}],"checkall":"true","repair":false,"outputs":2,"x":170,"y":120,"wires":[["90628e4d.23092","a814558a.61ffa8","2e158393.03978c","87ee0996.c63f48"],["53f1731e.8a6c4c","3c2b4f2d.808c9","922163fc.64aef","584119ed.3e8318"]]},{"id":"90628e4d.23092","type":"api-call-service","z":"8dba0687.56c238","name":"Tv Sala","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"switch.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["switch.pow_sala_tv_tv_sala"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"switch","service":"turn_on","x":700,"y":40,"wires":[[]]},{"id":"a814558a.61ffa8","type":"api-call-service","z":"8dba0687.56c238","name":"Som TV","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"media_player.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["media_player.som_tv"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"media_player","service":"turn_on","x":700,"y":100,"wires":[[]]},{"id":"2e158393.03978c","type":"api-call-service","z":"8dba0687.56c238","name":"Som Jantar","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"media_player.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["media_player.som_sala_jantar"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"media_player","service":"turn_on","x":710,"y":160,"wires":[[]]},{"id":"87ee0996.c63f48","type":"api-call-service","z":"8dba0687.56c238","name":"Tela Cozinha","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"media_player.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["media_player.cozinha"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"media_player","service":"turn_on","x":710,"y":220,"wires":[[]]},{"id":"53f1731e.8a6c4c","type":"api-call-service","z":"8dba0687.56c238","name":"Tv Sala","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"switch.turn_off","floorId":[],"areaId":[],"deviceId":[],"entityId":["switch.pow_sala_tv_tv_sala"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"switch","service":"turn_off","x":860,"y":60,"wires":[[]]},{"id":"3c2b4f2d.808c9","type":"api-call-service","z":"8dba0687.56c238","name":"Som TV","server":"12097a98.a70645","version":7,"debugenabled":false,"ac