ode.warn(\"nivel-\");\n            nivel_baixo = true;\n            context.set('nivel_baixo', nivel_baixo);\n            novo_nivel = nivel_caixa;\n            nivel_teste = (Math.ceil(nivel_caixa/10)*10)-10;\n            context.set('nivel_teste', nivel_teste);\n            //node.warn(\"nivel_teste=\" + nivel_teste);\n        } else {\n            if (nivel_teste && (nivel_caixa < nivel_teste)){   \n                nivel_teste = (Math.ceil(nivel_caixa / 10) * 10) - 10;\n                context.set('nivel_teste', nivel_teste);\n                //node.warn(\"nivel--\");   \n                //node.warn(\"nivel_teste=\" + nivel_teste);          \n                novo_nivel = nivel_caixa;\n            }\n        }\n    }\n} else {\n    if (nivel_baixo && (nivel_caixa > nivel_inicial_alerta+3)){\n        nivel_baixo = false;\n        context.set('nivel_baixo', nivel_baixo);\n        context.set('caixa_nivel_anterior', nivel_caixa);\n        novo_nivel = nivel_caixa;\n        msg.normalizado = true;\n    }\n}\n\n//node.warn(\"novo_nivel=\" + novo_nivel);\n\nif (novo_nivel) {\n    context.set('caixa_nivel_anterior', Math.round(novo_nivel));\n    msg.nivel = novo_nivel;\n    msg.payload = \"on\";\n}\nmsg.nivel_baixo = nivel_baixo;\nreturn msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":770,"y":80,"wires":[["fc23d1f51de64d22"]]},{"id":"fc23d1f51de64d22","type":"switch","z":"8ea01d9a.8987c","name":"Novo Nivel?","property":"payload","propertyType":"msg","rules":[{"t":"eq","v":"on","vt":"str"}],"checkall":"true","repair":false,"outputs":1,"x":130,"y":140,"wires":[["2231861727e16f10"]]},{"id":"e6299d3f0d852b80","type":"switch","z":"8ea01d9a.8987c","name":"Normalizado?","property":"normalizado","propertyType":"msg","rules":[{"t":"true"},{"t":"else"}],"checkall":"false","repair":false,"outputs":2,"x":180,"y":200,"wires":[["4af612a1c4a6e45a"],["193d394b3b048a80","055a84d44e8ba4ec","c5c4ca6a8b57372c","938f864cfdbefd6b"]]},{"id":"938f864cfdbefd6b","type":"sw