yId":[],"labelId":[],"data":"{\"notification_id\":\"central_amt\"}","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"persistent_notification","service":"dismiss","x":1690,"y":1340,"wires":[["0d589005f14326cf"]]},{"id":"0bf4e5e16fba339d","type":"ha-switch","z":"77ee9ef7029ba7e3","g":"94736602a22b03aa","name":"Central AMT - Requisição de Status","version":0,"inputs":1,"outputs":2,"entityConfig":"91fc58085d08e75e","enableInput":true,"outputOnStateChange":true,"outputProperties":[{"property":"swicth","propertyType":"msg","value":"","valueType":"entityState"},{"property":"check_status","propertyType":"flow","value":"","valueType":"entityState"}],"x":1700,"y":1520,"wires":[["4eaf75c2cf046a1e"],["4eaf75c2cf046a1e"]]},{"id":"847c6a15f74f3e09","type":"link in","z":"77ee9ef7029ba7e3","g":"94736602a22b03aa","name":"Indisponivel no boot","links":["3ea73c089db934a1","cc3a37142b2a86b9"],"x":1155,"y":1300,"wires":[["3899fe8e4d51a871","ccaaf350762969ed"]]},{"id":"dced2d26ff8a4ad7","type":"switch","z":"77ee9ef7029ba7e3","g":"5382b2d92857e002","name":"Verificação do Modelo","property":"payload[0]","propertyType":"msg","rules":[{"t":"eq","v":"0x37","vt":"str"},{"t":"eq","v":"0x2C","vt":"str"},{"t":"eq","v":"0x60","vt":"str"},{"t":"else"}],"checkall":"true","repair":false,"outputs":4,"x":1620,"y":920,"wires":[["e5c6a40a3f38d27f"],["def3cd2c584913fa"],["17dbc7f0dfddfa9b"],[]]},{"id":"e5c6a40a3f38d27f","type":"function","z":"77ee9ef7029ba7e3","g":"5382b2d92857e002","name":"AMT 4010","func":"if (global.get(\"homeassistant.homeAssistant.isConnected\") == true) {\n\n  var zone_ = Buffer.alloc(65);\n  var violated_ = Buffer.alloc(65);\n  var anulated_ = Buffer.alloc(65);\n  var lowbattery_ = Buffer.alloc(65);\n  var n_zone;\n  var i;\n  var j;\n  for (i = 0; i < 64 / 8; i++) {\n    for (j = 0; j < 8; j++) {\n\n      n_zone = ((i * 8) + 1 + j);\n      zone_[n_zone] = ((msg.payload[i + 1 + 1] >> j) & 1);\n      violated_[n_zone] = (msg.payload[i + 1 + 9] >> j) & 1;\n      anulated_[n_zone] = (msg.payload[i + 1 + 17] >> j) & 1;\n\n      if (n_zone < 17) {\n        lowbattery_[n_zone] = 0;\n      } else {\n\n        lowbattery_[n_zone] = (msg.payload[i + 1 + 45] >> j) & 1;\n\n      }\n    }\n  }\n  msg.zone_ = zone_;\n  msg.violated_ = violated_;\n  msg.anulated_ = anulated_;\n  msg.lowbattery_ = lowbattery_;\n\n  var tamper_ = Buffer.alloc(19);\n  var shortcircuit_ = Buffer.alloc(19);\n  n_zone = 0;\n  for (i = 0; i < 8 / 8; i++) {\n    for (j = 0; j < 8; j++) {\n\n      n_zone = ((i * 8) + 1 + j);\n      tamper_[n_zone] = (msg.payload[i + 1 + 44] >> j) & 1;\n      shortcircuit_[n_zone] = (msg.payload[i + 1 + 45] >> j) & 1;\n      tamper_[n_zone + 10] = 0;\n      shortcircuit_[n_zone + 10] = 0;\n    }\n  }\n\n  msg.tamper_ = tamper_;\n  msg.shortcircuit_ = shortcircuit_;\n\n  var fw1 = (msg.payload[26 + 1]) & 0xf0;\n  var fw2 = (msg.payload[26 + 1]) & 0x0f;\n  fw1 = (fw1 / 16);\n  msg.fw = (fw1 + \".\" + fw2);\n  if (msg.payload[25 + 1] == 0x41) {\n    msg.model = \"AMT 4010 SMART\"\n  } else {\n    msg.model = \"Desconhecido\"\n  }\n\n  msg.partition_a = Boolean((msg.payload[28 + 1] >> 0) & 1);\n  msg.partition_b = Boolean((msg.payload[28 + 1] >> 1) & 1);\n  msg.partition_c = Boolean((msg.payload[29 + 1] >> 0) & 1);\n  msg.partition_d = Boolean((msg.payload[29 + 1] >> 1) & 1);\n\n  msg.pc = (msg.payload[30 + 1] >> 0) & 1;\n  msg.za = (msg.payload[30 + 1] >> 2) & 1;\n  msg.activated = Boolean((msg.payload[30 + 1] >> 3) & 1);\n  msg.cd = (msg.payload[30 + 1] >> 6) & 1;\n\n  msg.acpower = Boolean((msg.payload[36 + 1] >> 0) & 1);\n  msg.b_baixa = (msg.payload[36 + 1] >> 1) & 1;\n  msg.b_con = (msg.payload[36 + 1] >> 2) & 1;\n  msg.b_curto = (msg.payload[36 + 1] >> 3) & 1;\n  msg.s_aux = (msg.payload[36 + 1] >> 4) & 1;\n\n  var pt_ = Buffer.alloc(5);\n  var pr_ = Buffer.alloc(5);\n  n_zone = 0;\n  for (i = 0; i < 4; i++) {\n    for (j = 0; j < 4; j++) {\n\n      n_zone = ((i * 8) + 1 + j);\n      pt_[n_zone] = (msg.payload[i + 1 + 37] >> j) & 1;\n      pr_[n_zone] = (msg.payload[i + 1 + 37] >> j + 4) & 1;\n    }\n  }\n\n  msg.pt_ = pt_;\n  msg.pr_ = pr_;\n\n  var pep_ = Buffer.alloc(5);\n  var pez_ = Buffer.alloc(9);\n  n_zone = 0;\n  for (i = 0; i < 4; i++) {\n    for (j = 0; j < 4; j++) {\n\n      n_zone = ((i * 8) + 1 + j);\n      pep_[n_zone] = (msg.payload[i + 1 + 38] >> j) & 1;\n      pez_[n_zone + 4] = (msg.payload[i + 1 + 39] >> j) & 1;\n      pez_[n_zone] = (msg.payload[i + 1 + 38] >> j + 4) & 1;\n    }\n  }\n\n  msg.pep_ = pep_;\n  msg.pez_ = pez_;\n\n  msg.b_con = (msg.payload[36 + 1] >> 2) & 1;\n  if (msg.b_con == 0) {\n    msg.bateria = (msg.payload[41 + 1]) & 0x0f;\n    if (msg.bateria == 0x0f) {\n      msg.bateria = 100;\n    } else if (msg.bateria == 0x07) {\n      msg.bateria = 75;\n    } else if (msg.bateria == 0x03) {\n      msg.bateria = 50;\n    } else if (msg.bateria == 0x01) {\n      msg.bateria = 25;\n    } else if (msg.bateria == 0x00) {\n      msg.bateria = 0;\n    }/* else {\nmsg.bateria = -10\n}*/\n  } else {\n    msg.bateria = 0;\n  }\n\n  var tc_ = Buffer.alloc(5);\n  n_zone = 0;\n  for (i = 0; i < 4; i++) {\n    for (j = 0; j < 4; j++) {\n\n      n_zone = ((i * 8) + 1 + j);\n      tc_[n_zone] = (msg.payload[i + 1 + 42] >> j + 4) & 1;\n    }\n  }\n\n  msg.tc_ = tc_;\n\n  msg.ss = Boolean((msg.payload[46 + 1] >> 3) & 1);\n  msg.pgm_1 = Boolean((msg.payload[46 + 1] >> 6) & 1);\n  msg.pgm_2 = Boolean((msg.payload[46 + 1] >> 5) & 1);\n  msg.pgm_3 = Boolean((msg.payload[46 + 1] >> 4) & 1);\n\n  msg.scf = (msg.payload[43 + 1] >> 0) & 1;\n  msg.sc = (msg.payload[43 + 1] >> 1) & 1;\n  msg.ct = (msg.payload[43 + 1] >> 2) & 1;\n  msg.fce = (msg.payload[43 + 1] >> 3) & 1;\n\n  var yy;\n  var mm;\n  var dd;\n  var hh;\n  var min;\n\n  //year\n  if (msg.payload[35 + 1] < 10) {\n    yy = \"0\" + msg.payload[35 + 1]\n  } else {\n    yy = msg.payload[35 + 1]\n  }\n  //month\n  if (msg.payload[34 + 1] < 10) {\n    mm = \"0\" + msg.payload[34 + 1]\n  } else {\n    mm = msg.payload[34 + 1]\n  }\n  //day\n  if (msg.payload[33 + 1] < 10) {\n    dd = \"0\" + msg.payload[33 + 1]\n  } else {\n    dd = msg.payload[33 + 1]\n  }\n  //hour\n  if (msg.payload[31 + 1] < 10) {\n    hh = \"0\" + msg.payload[31 + 1]\n  } else {\n    hh = msg.payload[31 + 1]\n  }\n  //minutes\n  if (msg.payload[32 + 1] < 10) {\n    min = \"0\" + msg.payload[32 + 1]\n  } else {\n    min = msg.payload[32 + 1]\n  }\n\n  var clock = (\n    \"20\" + yy + \"-\" +\n    mm + \"-\" +\n    dd + \"T\" +\n    hh + \":\" +\n    min + \":00+0000\"\n  )\n\n  var clock2 = Math.trunc((((Date.now() - 10800000) - (Date.parse(clock) - 0)) / 1000));\n\n  if (clock2 > -600 && clock2 < 600) {// se a diferença for mais que 10 minutos\n\n    msg.clock = \"Data e hora sincronizada\"\n\n  } else {\n\n    msg.clock = \"Data e hora desincronizada\"\n\n  }\n\n  //msg.frombuffer = Date.parse(clock);\n  //msg.fromnow = Date.now();\n\n  delete msg.payload\n  delete msg.port\n  delete msg.host\n\n  return msg;\n}","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1870,"y":820,"wires":[["ddcda6701bb7919f","77b8327fa83917ba"]]},{"id":"def3cd2c584913fa","type":"function","z":"77ee9ef7029ba7e3","g":"5382b2d92857e002","name":"AMT 2018 1016","func":"if (global.get(\"homeassistant.homeAssistant.isConnected\") == true) {\n\nvar zone_ = Buffer.alloc(65);\nvar violated_ = Buffer.alloc(65);\nvar anulated_ = Buffer.alloc(65);\nvar lowbattery_ = Buffer.alloc(65);\nvar n_zone;\nvar i;\nvar j;\nfor (i = 0; i < 64 / 8; i++) {\n  for (j = 0; j < 8; j++) {\n    n_zone = ((i * 8) + 1 + j);\n    if (n_zone < 49) {\n      zone_[n_zone] = ((msg.payload[i + 1 + 1] >> j) & 1);\n      violated_[n_zone] = (msg.payload[i + 1 + 7] >> j) & 1;\n      anulated_[n_zone] = (msg.payload[i + 1 + 13] >> j) & 1;\n    } else {\n      zone_[n_zone] = 0;\n      violated_[n_zone] = 0;\n      anulated_[n_zone] = 0;\n    }\n    if (n_zone < 41) {\n      lowbattery_[n_zone] = (msg.payload[i + 1 + 39] >> j) & 1;\n      //lowbattery_[n_zone] = 0;\n    } else {\n      lowbattery_[n_zone] = 0;\n\n    }\n\n\n  }\n}\nmsg.zone_ = zone_;\nmsg.violated_ = violated_;\nmsg.anulated_ = anulated_;\nmsg.lowbattery_ = lowbattery_;\n\n\n\n\n\n\nvar tamper_ = Buffer.alloc(19);\nvar shortcircuit_ = Buffer.alloc(19);\nn_zone = 0;\nfor (i = 0; i < 8 / 8; i++) {\n  for (j = 0; j < 8; j++) {\n\n    n_zone = ((i * 8) + 1 + j);\n    tamper_[n_zone] = (msg.payload[i + 1 + 34] >> j) & 1;\n    shortcircuit_[n_zone] = (msg.payload[i + 1 + 36] >> j) & 1;\n\n    tamper_[n_zone + 10] = (msg.payload[i + 1 + 35] >> j) & 1;\n    shortcircuit_[n_zone + 10] = (msg.payload[i + 1 + 37] >> j) & 1;\n\n  }\n}\n\nmsg.tamper_ = tamper_;\nmsg.shortcircuit_ = shortcircuit_;\n\nvar fw1 = (msg.payload[20 + 1]) & 0xf0;\nvar fw2 = (msg.payload[20 + 1]) & 0x0f;\nfw1 = (fw1 / 16);\nmsg.fw = (fw1 + \".\" + fw2);\nif (msg.payload[19 + 1] == 0x1E) {\n  msg.model = \"AMT 2018 E/EG\"\n} else if (msg.payload[19 + 1] == 0x61) {\n  msg.model = \"AMT 1016 NET\"\n} else if (msg.payload[19 + 1] == 0x24) {\n  msg.model = \"AMN 24 NET\"\n} else {\n  msg.model = \"Desconhecido\"\n}\nmsg.partition_a = Boolean((msg.payload[22 + 1] >> 0) & 1);\nmsg.partition_b = Boolean((msg.payload[22 + 1] >> 1) & 1);\nmsg.partition_c = true;\nmsg.partition_d = true;\n\nmsg.pc = (msg.payload[23 + 1] >> 0) & 1;\nmsg.za = (msg.payload[23 + 1] >> 2) & 1;\nmsg.activated = Boolean((msg.payload[23 + 1] >> 3) & 1);\nmsg.cd = (msg.payload[23 + 1] >> 6) & 1;\n\nmsg.acpower = Boolean((msg.payload[29 + 1] >> 0) & 1);\nmsg.b_baixa = (msg.payload[29 + 1] >> 1) & 1;\nmsg.b_con = (msg.payload[29 + 1] >> 2) & 1;\nmsg.b_curto = (msg.payload[29 + 1] >> 3) & 1;\nmsg.s_aux = (msg.payload[29 + 1] >> 4) & 1;\n\nvar pt_ = Buffer.alloc(5);\nvar pr_ = Buffer.alloc(5);\nn_zone = 0;\nfor (i = 0; i < 4; i++) {\n  for (j = 0; j < 4; j++) {\n\n    n_zone = ((i * 8) + 1 + j);\n    pt_[n_zone] = (msg.payload[i + 1 + 30] >> j) & 1;\n    pr_[n_zone] = (msg.payload[i + 1 + 30] >> j + 4) & 1;\n  }\n}\n\nmsg.pt_ = pt_;\nmsg.pr_ = pr_;\n\nvar pep_ = Buffer.alloc(5);\nvar pez_ = Buffer.alloc(9);\nn_zone = 0;\nfor (i = 0; i < 4; i++) {\n  for (j = 0; j < 4; j++) {\n\n    n_zone = ((i * 8) + 1 + j);\n    pep_[n_zone] = 0;\n    pez_[n_zone + 4] = 0;\n    pez_[n_zone] = 0;\n  }\n}\n\nmsg.pep_ = pep_;\nmsg.pez_ = pez_;\n\nmsg.b_con = (msg.payload[29 + 1] >> 2) & 1;\nif (msg.b_con == 0) {\n  msg.bateria = (msg.payload[31 + 1]) & 0x0f;\n  if (msg.bateria == 0x0f) {\n    msg.bateria = 100;\n  } else if (msg.bateria == 0x07) {\n    msg.bateria = 75;\n  } else if (msg.bateria == 0x03) {\n    msg.bateria = 50;\n  } else if (msg.bateria == 0x01) {\n    msg.bateria = 25;\n  } else if (msg.bateria == 0x00) {\n    msg.bateria = 0;\n  }/* else {\n    msg.bateria = -10\n}*/\n} else {\n  msg.bateria = 0;\n}\n\nvar tc_ = Buffer.alloc(5);\nn_zone = 0;\nfor (i = 0; i < 4; i++) {\n  for (j = 0; j < 4; j++) {\n\n    n_zone = ((i * 8) + 1 + j);\n    tc_[n_zone] = (msg.payload[i + 1 + 32] >> j + 4) & 1;\n  }\n}\n\nmsg.tc_ = tc_;\n\nmsg.ss = (msg.payload[38 + 1] >> 3) & 1;\nmsg.pgm_1 = Boolean((msg.payload[38 + 1] >> 6) & 1);\nmsg.pgm_2 = Boolean((msg.payload[38 + 1] >> 5) & 1);\nmsg.pgm_3 = false;\n\nmsg.scf = (msg.payload[33 + 1] >> 0) & 1;\nmsg.sc = (msg.payload[33 + 1] >> 1) & 1;\nmsg.ct = (msg.payload[33 + 1] >> 2) & 1;\nmsg.fce = (msg.payload[33 + 1] >> 3) & 1;\n\n\n  var yy;\n  var mm;\n  var dd;\n  var hh;\n  var min;\n\n  //year\n  if (msg.payload[28 + 1] < 10) {\n    yy = \"0\" + msg.payload[28 + 1]\n  } else {\n    yy = msg.payload[28 + 1]\n  }\n  //month\n  if (msg.payload[27 + 1] < 10) {\n    mm = \"0\" + msg.payload[27 + 1]\n  } else {\n    mm = msg.payload[27 + 1]\n  }\n  //day\n  if (msg.payload[26 + 1] < 10) {\n    dd = \"0\" + msg.payload[26 + 1]\n  } else {\n    dd = msg.payload[26 + 1]\n  }\n  //hour\n  if (msg.payload[24 + 1] < 10) {\n    hh = \"0\" + msg.payload[24 + 1]\n  } else {\n    hh = msg.payload[24 + 1]\n  }\n  //minutes\n  if (msg.payload[25 + 1] < 10) {\n    min = \"0\" + msg.payload[25 + 1]\n  } else {\n    min = msg.payload[25 + 1]\n  }\n\n  var clock = (\n    \"20\" + yy + \"-\" +\n    mm + \"-\" +\n    dd + \"T\" +\n    hh + \":\" +\n    min + \":00+0000\"\n  )\n\n  var clock2 = Math.trunc((((Date.now() - 10800000) - (Date.parse(clock) - 0)) / 1000));\n\n  if (clock2 > -600 && clock2 < 600) {// se a diferença for mais que 10 minutos\n\n    msg.clock = \"Data e hora sincronizada\"\n\n  } else {\n\n    msg.clock = \"Data e hora desincronizada\"\n\n  }\n\ndelete msg.payload\ndelete msg.port\ndelete msg.host\n\nreturn msg;\n}","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1880,"y":860,"wires":[["ddcda6701bb7919f","77b8327fa83917ba"]]},{"id":"269f05a2d7accf69","type":"link out","z":"77ee9ef7029ba7e3","g":"5382b2d92857e002","name":"Anular Zonas","mode":"link","links":["59ddf272b4b5fd87"],"x":1445,"y":840,"wires":[]},{"id":"77b8327fa83917ba","type":"debug","z":"77ee9ef7029ba7e3","g":"5382b2d92857e002","name":"Processamento da resposta","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1920,"y":760,"wires":[]},{"id":"4eaf75c2cf046a1e","type":"function","z":"77ee9ef7029ba7e3","g":"94736602a22b03aa","name":"Entidades para ===>","func":"\nif (msg.swicth == false || msg.payload == false || msg.ha_connected == true) {\n\n\n    // flow.set(\"check_status\", 0);\n    if (flow.get(\"entidades_indisponiveis\") !== undefined) {\n\n    var entidades_indisponiveis = flow.get(\"entidades_indisponiveis\");// pegar o valor do flow_name\n\n    for (var i = 0; i < entidades_indisponiveis.length; i++) {\n\n        msg.payload = entidades_indisponiveis[i];\n        // msg.payload = entidades_indisponiveis[i].entity_id;\n\n        node.send([null,msg]);\n    }\n    }\n} else if (msg.swicth == true || msg.payload == true) {\n\n\n}","outputs":2,"timeout":"","noe