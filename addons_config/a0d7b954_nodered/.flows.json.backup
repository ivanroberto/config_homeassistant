620f059b3d","type":"delay","z":"bc586eb2861822af","name":"","pauseType":"rate","timeout":"5","timeoutUnits":"seconds","rate":"1","nbRateUnits":"5","rateUnits":"minute","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":true,"allowrate":false,"outputs":1,"x":720,"y":3900,"wires":[["70291e22f1380ea6"]]},{"id":"851b42cb0e407b6c","type":"api-current-state","z":"bc586eb2861822af","name":"Porta suite master aberta?","server":"12097a98.a70645","version":3,"outputs":2,"halt_if":"on","halt_if_type":"str","halt_if_compare":"is","entity_id":"binary_sensor.porta_suite_master_contact","state_type":"str","blockInputOverrides":true,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"entity"}],"for":"","forType":"num","forUnits":"seconds","override_topic":false,"state_location":"payload","override_payload":"msg","entity_location":"data","override_data":"msg","x":460,"y":3900,"wires":[["8296c0620f059b3d"],["fc0fb16cfaef1a4e"]]},{"id":"2805b204c34c7fa2","type":"switch","z":"bc586eb2861822af","name":"Na hora?","property":"payload","propertyType":"msg","rules":[{"t":"eq","v":"1","vt":"num"},{"t":"else"}],"checkall":"true","repair":false,"outputs":2,"x":560,"y":3740,"wires":[["5e8a6593889c7eda"],["fc0fb16cfaef1a4e"]]},{"id":"5f1f4d97bba8c290","type":"server-state-changed","z":"bc586eb2861822af","name":"Portão escada superior abriu?","server":"12097a98.a70645","version":6,"outputs":2,"exposeAsEntityConfig":"","entities":{"entity":["binary_sensor.portao_escada_superior_contact"],"substring":[],"regex":[]},"outputInitially":false,"stateType":"str","ifState":"on","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"10","forType":"num","forUnits":"seconds","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"eventData"},{"property":"topic","propertyType":"msg","value":"","valueType":"triggerId"}],"x":160,"y":3660,"wires":[["0fe48edef93fba2e"],["fc0fb16cfaef1a4e"]]},{"id":"c59f32d78e0e8cc6","type":"server-state-changed","z":"bc586eb2861822af","name":"Porta suite master abriu?","server":"12097a98.a70645","version":6,"outputs":2,"exposeAsEntityConfig":"","entities":{"entity":["binary_sensor.porta_suite_master_contact"],"substring":[],"regex":[]},"outputInitially":false,"stateType":"str","ifState":"on","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"10","forType":"num","forUnits":"seconds","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"eventData"},{"property":"topic","propertyType":"msg","value":"","valueType":"triggerId"}],"x":450,"y":3660,"wires":[["0fe48edef93fba2e"],["fc0fb16cfaef1a4e"]]},{"id":"fc0fb16cfaef1a4e","type":"change","z":"bc586eb2861822af","name":"Reset","rules":[{"t":"set","p":"reset","pt":"msg","to":"1","tot":"num"}],"action":"","property":"","from":"","to":"","reg":false,"x":690,"y":3960,"wires":[["8296c0620f059b3d"]]},{"id":"d33a019de09f0557","type":"inject","z":"bc586eb2861822af","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":160,"y":3620,"wires":[["0fe48edef93fba2e"]]},{"id":"0fe48edef93fba2e","type":"change","z":"bc586eb2861822af","name":"","rules":[{"t":"set","p":"sync","pt":"msg","to":"","tot":"str"},{"t":"delete","p":"payload","pt":"msg"}],"action":"","property":"","from":"","to":"","reg":false,"x":120,"y":3740,"wires":[["771b347b24532e1b"]]},{"id":"maquina_estados","type":"function","z":"bc586eb2861822af","name":"Lógica da Cafeteira","func":"const POWER_THRESHOLD = 30; // Potência em Watts para considerar ligada\nconst MAX_ON_TIME_MS = 20 * 60 * 1000; // Tempo máximo de uso contínuo (Ex: 60 min)\nconst IDLE_TIMEOUT_MS = 10 * 60 * 1000; // Tempo inativo para considerar desligada (Ex: 20 min)\n\nlet state = context.get('cafeteira_state') || 'IDLE'; \nlet maxTimer = context.get('maxTimer') || null;\nlet idleTimer = context.get('idleTimer') || null;\n\nconst clearTimers = () => {\n    if (maxTimer) clearTimeout(maxTimer);\n    if (idleTimer) clearTimeout(idleTimer);\n    context.set('maxTimer', null);\n    context.set('idleTimer', null);\n};\n\nconst resetSystem = () => {\n    clearTimers();\n    context.set('cafeteira_state', 'IDLE');\n    context.set('maxTimeExceeded', false);\n};\n\n// Função para disparar a proteção\nconst triggerSafetyTurnOff = () => {\n    resetSystem();\n    node.status({fill:\"red\", shape:\"dot\", text:\"Desligamento Forçado!\"});\n    // Envia mensagem para Desligar a Tomada (saída 1) e Acionar Notificação (saída 2)\n    node.send([ { payload: \"off\" }, { payload: \"on\" } ]);\n};\n\n// 1. Tratamento para se a tomada for desligada manualmente (pelo HA, app, etc)\nif (msg.topic === \"switch.cafeteira\") {\n    if (msg.payload === \"off\") {\n        resetSystem();\n        node.status({fill:\"grey\", shape:\"ring\", text:\"Tomada Desligada (Reset)\"});\n    }\n    return null;\n}\n\n// 2. Lógica com base no consumo de energia\nif (msg.topic === \"sensor.cafeteira_power\") {\n    let power = parseFloat(msg.payload) || 0;\n\n    if (state === 'IDLE' && power >= POWER_THRESHOLD) {\n        // Iniciou o uso\n        state = 'ACTIVE';\n        node.status({fill:\"green\", shape:\"dot\", text:\"Ativa (Aquecendo)\"});\n        \n        maxTimer = setTimeout(() => {\n            let currentState = context.get('cafeteira_state');\n            if (currentState === 'ACTIVE') {\n                // Se o tempo estourou e ela está puxando energia agora: CORTA!\n                triggerSafetyTurnOff();\n            } else if (currentState === 'IDLE_WAIT') {\n                // Se estourou mas está em 0W, apenas \"marca\" que o tempo estourou.\n                // A decisão final fica para quando ela tentar religar ou quando der os 20 min.\n                context.set('maxTimeExceeded', true);\n                node.status({fill:\"red\", shape:\"ring\", text:\"Max Tempo. Aguardando prova de desligamento...\"});\n            }\n        }, MAX_ON_TIME_MS);\n        \n        context.set('maxTimer', maxTimer);\n        context.set('cafeteira_state', state);\n        \n    } else if (state === 'ACTIVE' && power < POWER_THRESHOLD) {\n        // Parou de consumir. Inicia a janela de 20 min.\n        state = 'IDLE_WAIT';\n        \n        // Só muda o status se não estiver já marcado como tempo estourado\n        if (!context.get('maxTimeExceeded')) {\n            node.status({fill:\"yellow\", shape:\"dot\", text:\"Aguardando (Ciclo ou Fim?)\"});\n        }\n        \n        idleTimer = setTimeout(() => {\n            // Passaram os 20 minutos de 0W absoluto. O usuário desligou a chave!\n            resetSystem();\n            node.status({fill:\"blue\", shape:\"ring\", text:\"Uso Finalizado Corretamente\"});\n        }, IDLE_TIMEOUT_MS);\n        \n        context.set('idleTimer', idleTimer);\n        context.set('cafeteira_state', state);\n\n    } else if (state === 'IDLE_WAIT' && power >= POWER_THRESHOLD) {\n        // Tentou puxar energia novamente (O termostato armou)\n        \n        // Verifica se o tempo de segurança não tinha estourado enquanto esperávamos\n        if (context.get('maxTimeExceeded')) {\n            triggerSafetyTurnOff();\n            return null; // Encerra a execução aqui\n        }\n\n        // Se o tempo não estourou, é só o ciclo normal mantendo a água quente\n        state = 'ACTIVE';\n        node.status({fill:\"green\", shape:\"dot\", text:\"Ativa (Reaquecendo)\"});\n        \n        // Cancela o timer de inatividade de 20 min\n        if (idleTimer) {\n            clearTimeout(idleTimer);\n            context.set('idleTimer', null);\n        }\n        context.set('cafeteira_state', state);\n    }\n}\n\nreturn null;","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":380,"y":3160,"wires":[["0956ef57e2c35f2e"],["78698bc569d5a7b3"]],"outputLabels":["Desligar Tomada","Notificar / TTS"]},{"id":"6e5f7978a139c38c","type":"server-state-changed","z":"bc586eb2861822af","name":"Consumo Cafeteira","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["sensor.tomada_cafeteira_power"],"substring":[],"regex":[]},"outputInitially":false,"stateType":"str","ifState":"","ifStateType":"str","outputOnlyOnStateChange":false,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"topic","propertyType":"msg","value":"sensor.cafeteira_power","valueType":"str"}],"x":130,"y":3120,"wires":[["maquina_estados"]]},{"id":"7297a8058cce5c02","type":"server-state-changed","z":"bc586eb2861822af","name":"Tomada Inteligente","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["switch.tomada_cafeteira_cafeteira"],"substring":[],"regex":[]},"outputInitially":false,"stateType":"str","ifState":"","ifStateType":"str","outputOnlyOnStateChange":false,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,