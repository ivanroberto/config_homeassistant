me":"input_entidade","value":"light.luz_rua","type":"str"},{"name":"lux_entidade","value":"sensor.lux_fundos_illuminance","type":"str"},{"name":"lux_min","value":"20","type":"num"},{"name":"lux_max","value":"200","type":"num"},{"name":"lux_max_manual","value":"210","type":"str"},{"name":"t_max_on_m","value":"60","type":"num"},{"name":"t_off_s","value":"90","type":"num"},{"name":"t_manual_ignora_s","value":"10","type":"num"},{"name":"desativa_entidade","value":"input_boolean.bateria_casa_soc_baixo","type":"str"}],"x":670,"y":1520,"wires":[["b27b70563c11c3e9"],["0fae1865852504c6"],[]]},{"id":"99f0fb4776849f05","type":"api-current-state","z":"dbdba0a9.b19f3","name":"Superior OFF?","server":"12097a98.a70645","version":3,"outputs":2,"halt_if":"off","halt_if_type":"str","halt_if_compare":"is","entity_id":"binary_sensor.presenca_escada_superior_presence","state_type":"str","blockInputOverrides":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"entity"}],"for":0,"forType":"num","forUnits":"minutes","x":380,"y":1360,"wires":[["c1f781b5cdc35322"],[]]},{"id":"ece0ad86d61f26fc","type":"api-current-state","z":"dbdba0a9.b19f3","name":"Inferior OFF?","server":"12097a98.a70645","version":3,"outputs":2,"halt_if":"off","halt_if_type":"str","halt_if_compare":"is","entity_id":"binary_sensor.presenca_escada_inferior_presence","state_type":"str","blockInputOverrides":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"entity"}],"for":0,"forType":"num","forUnits":"minutes","x":370,"y":1420,"wires":[["c1f781b5cdc35322"],[]]},{"id":"52efac3f5f10dcb1","type":"server-state-changed","z":"dbdba0a9.b19f3","name":"Sensor 1","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["binary_sensor.presenca_pergolado_presence"],"substring":[],"regex":[]},"outputInitially":true,"stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":true,"ignoreCurrentStateUnavailable":true,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"topic","propertyType":"msg","value":"sensor1","valueType":"str"}],"x":100,"y":580,"wires":[["fcb7ad885c212d92"]]},{"id":"5fb44dc4b65913a4","type":"server-state-changed","z":"dbdba0a9.b19f3","name":"Sensor 2","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["binary_sensor.presenca_pergolado_fundos_presence"],"substring":[],"regex":[]},"outputInitially":true,"stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":true,"ignoreCurrentStateUnavailable":true,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"topic","propertyType":"msg","value":"sensor2","valueType":"str"}],"x":100,"y":620,"wires":[["fcb7ad885c212d92"]]},{"id":"fcb7ad885c212d92","type":"function","z":"dbdba0a9.b19f3","name":"Trava 2 sensores","func":"const cfg = context.get('cfg') || {\n    sensor1Topic: 'sensor1',\n    sensor2Topic: 'sensor2',\n    windowMs: 8000,\n    dbg: true\n};\n\nlet state = context.get('state') || {\n    armed: false,\n    sensor1: false,\n    sensor2: false,\n    lightOn: false,\n    bootMode: 'idle',\n    firstOnAt: 0,\n    firstSensor: null\n};\n\nlet timer = context.get('timer');\n\nfunction log(txt) {\n    if (cfg.dbg) node.send([null, null, { payload: txt }]);\n}\n\nfunction save() {\n    context.set('state', state);\n    context.set('cfg', cfg);\n    context.set('timer', timer || null);\n}\n\nfunction clearWindow() {\n    if (timer) {\n        clearTimeout(timer);\n        timer = null;\n    }\n    state.firstOnAt = 0;\n    state.firstSensor = null;\n}\n\nfunction sendOn(reason) {\n    log(`[SEND] on (${reason})`);\n    node.send([{ payload: 'on', reason }, null, null]);\n}\n\nfunction sendOff(reason) {\n    log(`[SEND] off (${reason})`);\n    node.send([null, { payload: 'off', reason }, null]);\n}\n\nfunction processEvent(sensor, isOn) {\n    if (sensor === cfg.sensor1Topic) {\n        state.sensor1 = isOn;\n    } else if (sensor === cfg.sensor2Topic) {\n        state.sensor2 = isOn;\n    } else {\n        log(`[ERRO] topic inválido: ${sensor}`);\n        save();\n        return;\n    }\n\n    log(`[EVENTO] ${sensor} -> ${isOn ? 'on' : 'off'} | armed=${state.armed} bootMode=${state.bootMode} sensor1=${state.sensor1} sensor2=${state.sensor2} lightOn=${state.lightOn}`);\n\n    const anyOn = state.sensor1 || state.sensor2;\n\n    if (!anyOn) {\n        if (state.armed || state.lightOn || state.bootMode === 'active') {\n            state.armed = false;\n            state.lightOn = false;\n            state.bootMode = 'idle';\n            sendOff('both_off');\n            log('[DESARMADO] ambos OFF -> enviando OFF');\n        } else {\n            log('[OK] ambos OFF e já estava ocioso');\n        }\n\n        clearWindow();\n        save();\n        return;\n    }\n\n    if (state.armed || state.bootMode === 'active') {\n        if (isOn) {\n            state.armed = true;\n            state.bootMode = 'active';\n            state.lightOn = true;\n            sendOn('active_keep_on');\n            log('[MANTÉM ON] sistema ativo');\n        } else {\n            log('[MANTÉM ATIVO] um sensor OFF, outro ainda ON');\n        }\n        save();\n        return;\n    }\n\n    if (state.sensor1 && state.sensor2) {\n        state.armed = true;\n        state.bootMode = 'active';\n        state.lightOn = true;\n        clearWindow();\n        sendOn('both_on');\n        log('[ARMADO] ambos ON dentro da janela');\n        save();\n        return;\n    }\n\n    if (isOn && state.firstOnAt === 0) {\n        state.firstOnAt = Date.now();\n        state.firstSensor = sensor;\n\n        timer = setTimeout(() => {\n            if (!state.armed && state.bootMode !== 'active') {\n                log('[TIMEOUT] segundo sensor não apareceu na janela');\n                clearWindow();\n                if (!state.sensor1 && !state.sensor2) {\n                    state.bootMode = 'idle';\n                } else {\n                    state.bootMode = 'waiting';\n                }\n                save();\n            }\n        }, cfg.windowMs);\n\n        state.bootMode = 'waiting';\n        log(`[JANELA] primeiro ON de ${sensor}, aguardando o outro por ${cfg.windowMs}ms`);\n    }\n\n    save();\n}\n\nconst topic = String(msg.topic || '').trim();\nconst payload = String(msg.payload || '').trim().toLowerCase();\n\nif (payload !== 'on' && payload !== 'off') {\n    save();\n    return;\n}\n\nprocessEvent(topic, payload === 'on');","outputs":3,"timeout":"","noerr":0,"initialize":"function getStr(key, def) {\n    const v = env.get(key);\n    return (v === undefined || v === null || String(v).trim() === '') ? def : String(v).trim();\n}\n\nfunction getNum(key, def) {\n    const v = env.get(key);\n    const n = Number(v);\n    return (v === undefined || v === null || String(v).trim() === '' || Number.isNaN(n)) ? def : n;\n}\n\nfunction getBool(key, def) {\n    const v = env.get(key);\n    if (v === undefined || v === null || String(v).trim() === '') return def;\n    return String(v).trim().toLowerCase() === 'true';\n}\n\nfunction getHaState(entityId) {\n    const ha = global.get('homeassistant');\n    if (!ha || !entityId) return false;\n\n    for (const srv of Object.keys(ha)) {\n        if (ha[srv] && ha[srv].states && ha[srv].states[entityId]) {\n            return String(ha[srv].states[entityId].state).toLowerCase() === 'on';\n        }\n    }\n    return false;\n}\n\nconst sensor1Topic = getStr('sensor1_topic', 'sensor1');\nconst sensor2Topic = getStr('sensor2_topic', 'sensor2');\nconst sensor1Entity = getStr('sensor1_entity', 'binary_sensor.presenca_pergolado_presence');\nconst sensor2Entity = getStr('sensor2_entity', 'binary_sensor.presenca_pergolado_fundos_presence');\nconst lightEntity = getStr('light_entity', 'light.pow_luzes_fundos_luz_pergolado');\nconst windowMs = getNum('window_ms', 8000);\nconst dbg = getBool('dbg', true);\n\nconst sensor1 = getHaState(sensor1Entity);\nconst sensor2 = getHaState(sensor2Entity);\nconst lightOn = getHaState(lightEntity);\n\nlet bootMode = 'idle';\nif (sensor1 && sensor2) bootMode = 'active';\nelse if (lightOn && (sensor1 || sensor2)) bootMode = 'active';\nelse if (sensor1 || sensor2) bootMode = 'waiting';\n\ncontext.set('cfg', {\n    sensor1Topic,\n    sensor2Topic,\n    sensor1Entity,\n    sensor2Entity,\n    lightEntity,\n    windowMs,\n    dbg\n});\n\ncontext.set('state', {\n    armed: bootMode === 'active',\n    sensor1,\n    sensor2,\n    lightOn,\n    bootMode,\n    firstOnAt: 0,\n    firstSensor: null\n});\n\ncontext.set('timer', null);","finalize":"","libs":[],"x":330,"y":600,"wires":[["4dc866d7d2ba0078"],["4dc866d7d2ba0078"],["ab2ee49b7dfb8b38"]]},{"id":"ab2ee49b7dfb8b38","type":"debug","z":"dbdba0a9.b19f3","name":"Debug trava","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","x":530,"y":640,"wires":[]},{"id":"572f1eb13a7f52c9","type":"debug","z":"dbdba0a9.b19f3","name":"debug 11","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":730,"y":660,"wires":[]},{"id":"c0d490feb3dd0d03","type":"debug","z":"dbdba0a9.b19f3","name":"debug 23","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":750,"y":480,"wires":[]},{"id":"03c11f52c19bffc9","type":"comment","z":"dbdba0a9.b19f3","name":"Luz Oficina","info":"","x":100,"y":2260,"wires":[]},{"id":"6dbeb53aa0feb317","type":"link out","z":"dbdba0a9.b19f3","name":"","mode":"link","links":["04b3b699fd564404"],"x":835,"y":2280,"wires":[]},{"id":"c21abb75b22cc08b","type":"link out","z":"dbdba0a9.b19f3","name":"","mode":"link","links":["def6f4b0c1b14059"],"x":835,"y":2340,"wires":[]},{"id":"3a31d18c23ca98e4","type":"server-state-changed","z":"dbdba0a9.b19f3","name":"Presença oficina","server":"7b975ed1.2c58d","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["binary_sensor.presenca_oficina_presence"],"substring":[],"regex":[]},"outputInitially":true,"stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":true,"ignoreCurrentStateUnavailable":true,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"eventData"},{"property":"topic","propertyType":"msg","value":"","valueType":"triggerId"}],"x":120,"y":2300,"wires":[["a456052d2cdf7e65"]]},{"id":"a456052d2cdf7e65","type":"subflow:86b4d215caa302a6","z":"dbdba0a9.b19f3","name":"","env":[{"name":"input_entidade","value":"light.luz_oficina","type":"str"},{"name":"lux_entidade","value":"sensor.mmwave_servico_illuminance","type":"str"},{"name":"lux_min","value":"600","type":"num"},{"name":"lux_max","value":"800","type":"num"},{"name":"lux_max_manual","value":"810","type":"num"},{"name":"t_max_on_m","value":"120","type":"num"},{"name":"t_off_s","value":"1","type":"num"},{"name":"t_manual_ignora_s","value":"10","type":"num"},{"name":"desativa_lux_manual","value":"input_boolean.desativa_luzes_lux","type":"str"}],"x":660,"y":2300,"wires":[["6dbeb53aa0feb317"],["c21abb75b22cc08b"],["ad862944184595d5"]]},{"id":"ad862944184595d5","type":"debug","z":"dbdba0a9.b19f3","name":"debug 6","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":660,"y":2360,"wires":[]},{"id":"f5b4b1167925ca54","type":"debug","z":"dbdba0a9.b19f3","name":"debug 16","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":650,"y":2220,"wires":[]},{"id":"953360554486a325","type":"inject","z":"e7f558013d35f6e4","name":"Verificar baterias e sensores a cada 10 min","props":[],"repeat":"600","crontab":"","once":true,"onceDelay":"20","topic":"","x":230,"y":80,"wires":[["89b67e7f2c0eba2e"]]},{"id":"e34fe1228c516db5","type":"function","z":"e7f558013d35f6e4","name":"Analisa baterias e offline","func":"// ====== ANALISA BATERIAS, LINKQUALITY (COM DELAY) E OFFLINE ======\n\nconst config = msg.config;\nif (!config) {\n    node.warn(\"msg.config não encontrado.  Verifique se a function de configuração foi executada antes.\");\n    return null;\n}\n\nconst {\n    BATTERY_THRESHOLD,\n    OFFLINE_THRESHOLD_MINUTES,\n    LINKQUALITY_THRESHOLD,\n    LINKQUALITY_DELAY_SECONDS,\n    batterySensors,\n    extraOfflineSensors\n} = config;\n\n// ==== PEGAR ESTADOS DO HA A PARTIR DO CONTEXTO GLOBAL ====\nconst ha = global.get('homeassistant');\nif (!ha || !ha.homeAssistant || !ha.homeAssistant.states) {\n    node.warn(\"Não consegui acessar homeassistant.states no contexto global.\");\n    return null;\n}\n\nconst states = ha.homeAssistant.states;\n\nfunction getEntity(entityId) {\n    return states[entityId];\n}\n\n// Função auxiliar para pegar nome amigável sempre pelo sensor principal (last_seen), se existir\nfunction getNameFor(batteryEntityId) {\n    const cfg = (batterySensors || []).find(s => s.entity_id === batteryEntityId);\n\n    const mainId = cfg && cfg.main_entity_id ? cfg.main_entity_id : batteryEntityId;\n    const ent = states[mainId];\n\n    let name = mainId;\n    if (ent && ent.attributes && ent.attributes.friendly_name) {\n        name = ent.attributes.friendly_name;\n    }\n\n    // Remove sufixo \"Last seen\" se houver\n    name = name.replace(/\\s+Last\\s*seen$/i, \"\");\n    return name;\n}\n\n// Versão para quando já temos o entity_id principal (offline, extraOfflineSensors)\nfunction getNameFromEntityId(entityId) {\n    const ent = states[entityId];\n    let name = entityId;\n\n    if (ent && ent.attributes && ent.attributes.friendly_name) {\n        name = ent.attributes.friendly_name;\n    }\n\n    name = name.replace(/\\s+Last\\s*seen$/i, \"\");\n    return name;\n}\n\n// Estados que consideramos \"indisponíveis\"\nconst UNAVAILABLE_STATES = [\"unavailable\", \"unknown\", \"none\"];\n\n/**\n * timeoutMinutes: tempo em minutos para considerar offline. \n */\nfunction isEntityOffline(mainEntity, now, timeoutMinutes) {\n    if (!mainEntity) {\n        return {\n            offline: true,\n            reason: \"Entidade principal não encontrada no Home Assistant\"\n        };\n    }\n\n    if (UNAVAILABLE_STATES.includes(String(mainEntity.state).toLowerCase())) {\n        return {\n            offline: true,\n            reason: `Estado atual: ${mainEntity.state}`\n        };\n    }\n\n    const lastStr = mainEntity.last_updated || mainEntity.last_changed;\n    if (!lastStr) {\n        return {\n            offline: true,\n            reason: \"Sem informação de última atualização\"\n        };\n    }\n\n    const lastDate = new Date(lastStr);\n    if (isNaN(lastDate.getTime())) {\n        return {\n            offline: true,\n            reason: \"Data de última atualização inválida\"\n        };\n    }\n\n    const diffMs = now.getTime() - lastDate.getTime();\n    const diffMin = diffMs / 1000 / 60;\n\n    if (diffMin >= timeoutMinutes) {\n        return {\n            offline: true,\n            last_seen_minutes: Math.round(diffMin)\n        };\n    }\n\n    return { offline: false };\n}\n\nconst now = new Date();\nconst lowBattery = [];\nconst lowLinkQuality = [];\nconst offline = [];\n\n// ====== DEBOUNCE DE LINK QUALITY ======\n// linkQualityDebounce[base_id] = { firstSeenMs: timestamp, currentValue: number }\nlet linkQualityDebounce = flow.get(\"linkQualityDebounce\") || {};\n\n/**\n * Verifica se link quality está abaixo do limiar HÁ TEMPO SUFICIENTE. \n * Retorna { shouldAlert: bool, currentValue: number }\n */\nfunction checkLinkQualityDebounce(baseId, lqValue, minLq, delaySeconds) {\n    const key = baseId;\n\n    if (lqValue >= minLq) {\n        // Link OK agora → limpa debounce\n        if (linkQualityDebounce[key]) {\n            delete linkQualityDebounce[key];\n        }\n        return { shouldAlert: false, currentValue: lqValue };\n    }\n\n    // Link abaixo do mínimo\n    if (!linkQualityDebounce[key]) {\n        // Primeira vez que detecta baixo → inicia contagem\n        linkQualityDebounce[key] = {\n            firstSeenMs: now.getTime(),\n            currentValue: lqValue\n        };\n        return { shouldAlert: false, currentValue: lqValue };\n    }\n\n    // Já estava baixo antes → atualiza valor e verifica tempo decorrido\n    linkQualityDebounce[key].currentValue = lqValue;\n\n    const elapsedMs = now.getTime() - linkQualityDebounce[key].firstSeenMs;\n    const elapsedSec = elapsedMs / 1000;\n\n    if (elapsedSec >= delaySeconds) {\n        // Passou do delay → pode alertar\n        return { shouldAlert: true, currentValue: lqValue };\n    }\n\n    // Ainda não passou do delay\n    return { shouldAlert: false, currentValue: lqValue };\n}\n\n// 1) BATERIA + LINKQUALITY (COM DELAY) + OFFLINE (por sensor base)\nfor (const s of batterySensors) {\n    const batteryEntity = getEntity(s.entity_id);\n    const mainEntityId = s.main_entity_id || s.entity_id;\n    const mainEntity = getEntity(mainEntityId);\n\n    // ---------- BATERIA ----------\n    if (!batteryEntity) {\n        // Se nem o sensor de bateria existe, vamos só cuidar de offline e linkquality. \n        // (não adiciona nada em lowBattery aqui)\n    } else {\n        let batteryValue = null;\n\n        if (s.type === \"state\") {\n            batteryValue = parseFloat(batteryEntity.state);\n        } else if (s.type === \"attribute\") {\n            batteryValue = parseFloat(\n                batteryEntity.attributes && batteryEntity.attributes[s.attribute]\n            );\n        }\n\n        if (!isNaN(batteryValue) && batteryValue <= BATTERY_THRESHOLD) {\n            lowBattery.push({\n                entity_id: s.entity_id,\n                battery: batteryValue\n            });\n        }\n    }\n\n    // ---------- LINKQUALITY (COM DEBOUNCE) ----------\n    if (s.linkquality_entity_id) {\n        const lqEntity = getEntity(s.linkquality_entity_id);\n        if (lqEntity) {\n            const lqValue = parseFloat(lqEntity.state);\n            if (!isNaN(lqValue)) {\n                // limiar individual ou global\n                let minLq = LINKQUALITY_THRESHOLD;\n                if (s.linkquality_min != null) {\n                    const parsed = parseFloat(s.linkquality_min);\n                    if (!isNaN(parsed)) {\n                        minLq = parsed;\n                    }\n                }\n\n                // Delay individual ou global\n                let delaySeconds = LINKQUALITY_DELAY_SECONDS;\n                if (s.linkquality_delay_seconds != null) {\n                    const parsed = parseInt(s.linkquality_delay_seconds, 10);\n                    if (!isNaN(parsed) && parsed >= 0) {\n                        delaySeconds = parsed;\n                    }\n                }\n\n                const baseId = s.base_id || mainEntityId;\n                const check = checkLinkQualityDebounce(baseId, lqValue, minLq, delaySeconds);\n\n                if (check.shouldAlert) {\n                    lowLinkQuality.push({\n                        entity_id: s.linkquality_entity_id,\n                        base_id: baseId,\n                        linkquality: check.currentValue,\n                        min_linkquality: minLq\n                    });\n                }\n            }\n        }\n    }\n\n    // ---------- OFFLINE ----------\n    const skipOffline = s.not_verify_offline === true;\n    if (!skipOffline) {\n        let timeoutMinutes = OFFLINE_THRESHOLD_MINUTES;\n        if (s.offline_timeout_minutes != null) {\n            const parsed = parseInt(s.offline_timeout_minutes, 10);\n            if (!isNaN(parsed) && parsed > 0) {\n                timeoutMinutes = parsed;\n            }\n        }\n\n        const offInfo = isEntityOffline(mainEntity, now, timeoutMinutes);\n        if (offInfo.offline) {\n            offline.push({\n                entity_id: mainEntityId,\n                ...(offInfo.last_seen_minutes != null\n                    ? { last_seen_minutes: offInfo.last_seen_minutes }\n                    : { reason: offInfo.reason || \"Sem comunicação recente\" }),\n                timeout_minutes: timeoutMinutes\n            });\n        }\n    }\n}\n\n// 2) SENSORES EXTRAS SEM BATERIA (offline + linkquality opcional COM DEBOUNCE)\nfor (const cfg of extraOfflineSensors || []) {\n    const entityId = (typeof cfg === \"string\") ? cfg : cfg.entity_id;\n    if (!entityId) continue;\n\n    const mainEntity = getEntity(entityId);\n\n    // ----- OFFLINE -----\n    let timeoutMinutes = OFFLINE_THRESHOLD_MINUTES;\n    if (cfg && typeof cfg === \"object\" && cfg.offline_timeout_minutes != null) {\n        const parsed = parseInt(cfg.offline_timeout_minutes, 10);\n        if (!isNaN(parsed) && parsed > 0) {\n            timeoutMinutes = parsed;\n        }\n    }\n\n    const offInfo = isEntityOffline(mainEntity, now, timeoutMinutes);\n\n    if (offInfo.offline) {\n        offline.push({\n            entity_id: entityId,\n            ...(offInfo.last_seen_minutes != null\n                ? { last_seen_minutes: offInfo.last_seen_minutes }\n                : { reason: offInfo.reason || \"Sem comunicação recente\" }),\n            timeout_minutes: timeoutMinutes\n        });\n    }\n\n    // ----- LINKQUALITY (COM DEBOUNCE) -----\n    if (cfg && typeof cfg === \"object\" && cfg.linkquality_entity_id) {\n        const lqEntity = getEntity(cfg.linkquality_entity_id);\n        if (lqEntity) {\n            const lqValue = parseFloat(lqEntity.state);\n            if (!isNaN(lqValue)) {\n                let minLq = LINKQUALITY_THRESHOLD;\n                if (cfg.linkquality_min != null) {\n                    const parsedLq = parseFloat(cfg.linkquality_min);\n                    if (!isNaN(parsedLq)) {\n                        minLq = parsedLq;\n                    }\n                }\n\n                let delaySeconds = LINKQUALITY_DELAY_SECONDS;\n                if (cfg.linkquality_delay_seconds != null) {\n                    const parsedDelay = parseInt(cfg.linkquality_delay_seconds, 10);\n                    if (!isNaN(parsedDelay) && parsedDelay >= 0) {\n                        delaySeconds = parsedDelay;\n                    }\n                }\n\n                const baseId = entityId; // usamos o last_seen como identificador base\n                const check = checkLinkQualityDebounce(baseId, lqValue, minLq, delaySeconds);\n\n                if (check.shouldAlert) {\n                    lowLinkQuality.push({\n                        entity_id: cfg.linkquality_entity_id,\n                        base_id: baseId,\n                        linkquality: check.currentValue,\n                        min_linkquality: minLq\n                    });\n                }\n            }\n        }\n    }\n}\n\n// Salva estado de debounce de volta no flow\nflow.set(\"linkQualityDebounce\", linkQualityDebounce);\n\n// 3) MONTAR TEXTO RESUMO + shortMessage + tipo de alerta\n\nlet lines = [];\nlet shortLines = [];\nlet title = \"Monitor de baterias e sensores\";\n\nconst countBat = lowBattery.length;\nconst countLq = lowLinkQuality.length;\nconst countOff = offline.length;\n\n// Ícone/canal padrão\nlet notificationIcon = \"mdi:battery-alert\";\nlet channel = \"battery_and_sensors\";\n\nif (countBat === 0 && countLq === 0 && countOff === 0) {\n    const msgOk = \"Todas as baterias, linkquality e sensores monitorados estão OK. \";\n    lines.push(msgOk);\n    shortLines.push(\"Tudo OK com baterias/linkquality/sensores.\");\n\n    notificationIcon = \"mdi:battery-check\";\n    channel = \"battery_ok\";\n} else {\n    // ----- BATERIAS FRACAS -----\n    if (countBat > 0) {\n        lines.push(\"Baterias fracas:\");\n        shortLines.push(\"Baterias fracas:\");\n\n        lowBattery.forEach(item => {\n            const name = getNameFor(item.entity_id);\n            const line = `- ${name}: ${item.battery}%`;\n            lines.push(line);\n            shortLines.push(line);\n        });\n\n        lines.push(\"\");\n        shortLines.push(\"\");\n    }\n\n    // ----- LINKQUALITY BAIXO -----\n    if (countLq > 0) {\n        lines.push(\"Linkquality baixo:\");\n        shortLines.push(\"Linkquality baixo:\");\n\n        lowLinkQuality.forEach(item => {\n            const name = getNameFromEntityId(item.base_id || item.entity_id);\n            const line = `- ${name}: ${item.linkquality} (mínimo: ${item.min_linkquality})`;\n            lines.push(line);\n            shortLines.push(line);\n        });\n\n        lines.push(\"\");\n        shortLines.push(\"\");\n    }\n\n    // ----- OFFLINE -----\n    if (countOff > 0) {\n        lines.push(\"Sensores offline:\");\n        shortLines.push(\"Sensores offline:\");\n\n        offline.forEach(item => {\n            const name = getNameFromEntityId(item.entity_id);\n            if (item.last_seen_minutes != null) {\n                const line = `- ${name}: > ${item.timeout_minutes} min`;\n                lines.push(line);\n                shortLines.push(line);\n            } else {\n                const line = `- ${name}: ${item.reason}`;\n                lines.push(line);\n                shortLines.push(line);\n            }\n        });\n    }\n\n    // Ícone / canal por tipo de problema\n    if (countBat > 0 && countLq === 0 && countOff === 0) {\n        notificationIcon = \"mdi:battery-alert\";\n        channel = \"battery_alerts\";\n    } else if (countBat === 0 && countLq > 0 && countOff === 0) {\n        notificationIcon = \"mdi:wifi-strength-alert-outline\";\n        channel = \"sensor_linkquality\";\n    } else if (countBat === 0 && countLq === 0 && countOff > 0) {\n        notificationIcon = \"mdi:wifi-alert\";\n        channel = \"sensor_offline\";\n    } else {\n        notificationIcon = \"mdi:alert-circle\";\n        channel = \"battery_and_sensors\";\n    }\n\n    title += ` (${countBat} bat., ${countLq} lq., ${countOff} off.)`;\n}\n\nmsg.summary = lines.join(\"\\n\");\nmsg.shortMessage = shortLines.length > 0\n    ? shortLines.join(\"\\n\")\n    : \"Tudo OK com baterias/linkquality/sensores.\";\n\nmsg.title = title;\nmsg.notificationIcon = notificationIcon;\nmsg.notificationChannel = channel;\nmsg.problems = { lowBattery, lowLinkQuality, offline };\nmsg.hasProblems = (countBat > 0 || countLq > 0 || countOff > 0);\nmsg.payload = msg.hasProblems;\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":170,"y":140,"wires":[["95cea188bb0988eb","19506cecdead424a"]]},{"id":"95cea188bb0988eb","type":"debug","z":"e7f558013d35f6e4","name":"Resumo (debug)","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":430,"y":180,"wires":[]},{"id":"b147bda74deb9195","type":"switch","z":"e7f558013d35f6e4","name":"Há algum problema?","property":"payload","propertyType":"msg","rules":[{"t":"true"},{"t":"false"}],"checkall":"true","repair":false,"outputs":2,"x":160,"y":240,"wires":[["f243fb9d391b0bbc","a2c425e908d8e55a"],["c24b1915cd0344ae"]]},{"id":"8a7c2d5730b2fffb","type":"api-call-service","z":"e7f558013d35f6e4","name":"Notificação HA","server":"ha_server","version":7,"debugenabled":false,"action":"persistent_notification.create","floorId":[],"areaId":[],"deviceId":[],"entityId":[],"labelId":[],"data":"{}","dataType":"json","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"persistent_notification","service":"create","mergecontext":"","x":820,"y":380,"wires":[[]]},{"id":"f243fb9d391b0bbc","type":"function","z":"e7f558013d35f6e4","name":"Ajusta booleans ON","func":"const actions = [];\n\n// Se houve bateria fraca, ligar input_boolean.bateria_fraca\nif (msg.problems.lowBattery && msg.problems.lowBattery.length > 0) {\n    actions.push({\n        payload: {\n            action: \"homeassistant.turn_on\",\n            target: {\n                entity_id: [\"input_boolean.bateria_fraca\"]\n            },\n            data: {}\n        }\n    });\n}\n\n// Se houve sensor offline, ligar input_boolean.sensor_offline\nif (msg.problems.offline && msg.problems.offline.length > 0) {\n    actions.push({\n        payload: {\n            action: \"homeassistant.turn_on\",\n            target: {\n                entity_id: [\"input_boolean.sensor_offline\"]\n            },\n            data: {}\n        }\n    });\n}\n\n// Se não há nenhuma ação, não envia nada\nif (actions.length === 0) {\n    return null;\n}\n\n// Esta função tem APENAS 1 saída\nreturn [actions];","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":160,"y":440,"wires":[["675d67e97fc8b9fe"]]},{"id":"c24b1915cd0344ae","type":"function","z":"e7f558013d35f6e4","name":"Ajusta booleans OFF","func":"const actions = [];\n\n// Desliga sempre os dois\nactions.push({\n    payload: {\n        action: \"input_boolean.turn_off\",\n        target: {\n            entity_id: [\"input_boolean.bateria_fraca\"]\n        },\n        data: {}\n    }\n});\n\nactions.push({\n    payload: {\n        action: \"input_boolean.turn_off\",\n        target: {\n            entity_id: [\"input_boolean.sensor_offline\"]\n        },\n        data: {}\n    }\n});\n\n// Esta função também tem 1 saída\nreturn [actions];","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":160,"y":480,"wires":[["675d67e97fc8b9fe"]]},{"id":"675d67e97fc8b9fe","type":"api-call-service","z":"e7f558013d35f6e4","name":"Atualiza input_boolean","server":"ha_server","version":7,"debugenabled":false,"action":"","floorId":[],"areaId":[],"deviceId":[],"entityId":[],"labelId":[],"data":"","dataType":"json","mergeContext":"","mustacheAltTags":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"\"turn_on\"","valueType":"str"},{"property":"payload","propertyType":"msg","value":"","valueType":"data"}],"queue":"none","blockInputOverrides":false,"domain":"input_boolean","service":"turn_on","mergecontext":"","x":420,"y":460,"wires":[[]]},{"id":"89b67e7f2c0eba2e","type":"function","z":"e7f558013d35f6e4","name":"Configuração de sensores","func":"// CONFIGURAÇÃO CENTRALIZADA DE SENSORES E PARÂMETROS\n\n// Limiares globais\nconst BATTERY_THRESHOLD = 30;           // % (bateria fraca)\nconst OFFLINE_THRESHOLD_MINUTES = 120;  // minutos (offline global)\nconst LINKQUALITY_THRESHOLD = 5;       // valor mínimo global para linkquality\nconst LINKQUALITY_DELAY_SECONDS = 60*60;  //60*60 // segundos que o link deve ficar baixo antes de alertar\n\n// Sufixos padrão para construir entidades a partir do \"base_id\"\nconst SUFIXO_BATERIA = \"_battery\";\nconst SUFIXO_LINK_QUALITY = \"_linkquality\";\nconst SUFIXO_LAST_SEEN = \"_last_seen\";\n\n// Tipo de leitura padrão (state)\nconst SENSOR_TYPE = \"state\";\n\n/**\n * batterySensorsConfig:\n * - base_id: obrigatório (ex.: \"sensor.termometro_luisa\")\n * - opcionalmente overrides:\n *   - battery_entity_id\n *   - last_seen_entity_id\n *   - linkquality_entity_id\n * - offline_timeout_minutes?: timeout individual (se não, usa OFFLINE_THRESHOLD_MINUTES)\n * - linkquality_min?: limiar individual (se não, usa LINKQUALITY_THRESHOLD)\n * - linkquality_delay_seconds?: delay individual antes de alertar (se não, usa LINKQUALITY_DELAY_SECONDS)\n * - not_verify_offline?: true para não checar offline\n */\nconst batterySensorsConfig = [\n    // Termômetros\n    {\n        base_id: \"sensor.termometro_luisa\",\n        not_verify_offline: false\n    },\n    {\n        base_id: \"sensor.termometro_cozinha\",\n    },\n    {\n        base_id: \"sensor.termometro_escritorio\",\n    },\n    {\n        base_id: \"sensor.termometro_geladeira\",\n    },\n    {\n        base_id: \"sensor.termometro_oficina\",\n    },\n    {\n        base_id: \"sensor.termometro_pergolado\",\n    },\n    {\n        base_id: \"sensor.termometro_sala_tv\",\n    },\n    {\n        base_id: \"sensor.termometro_servico\",\n    },\n    {\n        base_id: \"sensor.termometro_sotao\",\n    },\n    {\n        base_id: \"sensor.termometro_suite\",\n    },\n    {\n        base_id: \"sensor.termometro_suite_2\",\n    },\n    {\n        base_id: \"sensor.termometro_telhado\",\n        offline_timeout_minutes: 7 * 60\n    },\n\n    // Luxímetros\n    {\n        base_id: \"sensor.lux_sala_tv\",\n    },\n    {\n        base_id: \"sensor.lux_corredor_andar_2\",\n    },\n    {\n        base_id: \"sensor.lux_fundos\",\n    },\n\n    // Vazamento (COM timeout individual 24*60)\n    {\n        base_id: \"sensor.vazamento_suite_master_esquerda\",\n        offline_timeout_minutes: 24 * 60\n    },\n    {\n        base_id: \"sensor.vazamento_suite_master_direita\",\n        offline_timeout_minutes: 24 * 60\n    },\n    {\n        base_id: \"sensor.vazamento_suite_2\",\n        offline_timeout_minutes: 24 * 60\n    },\n    {\n        base_id: \"sensor.vazamento_caixa_agua\",\n        offline_timeout_minutes: 24 * 60\n    },\n    {\n        base_id: \"sensor.vazamento_lava_loucas\",\n        offline_timeout_minutes: 24 * 60\n    },\n    {\n        base_id: \"sensor.vazamento_lavabo\",\n        offline_timeout_minutes: 24 * 60\n    },\n    {\n        base_id: \"sensor.vazamento_pia_cozinha_esquerda\",\n        offline_timeout_minutes: 24 * 60\n    },\n    {\n        base_id: \"sensor.vazamento_pia_cozinha_direita\",\n        offline_timeout_minutes: 24 * 60\n    },\n    {\n        base_id: \"sensor.vazamento_telhado\",\n        offline_timeout_minutes: 24 * 60\n    },\n\n    // PIR e mmWave alimentados a bateria\n    {\n        base_id: \"sensor.pir_gas\",\n        offline_timeout_minutes: 300\n    },\n    {\n        base_id: \"binary_sensor.presenca_escada_inferior\",\n        battery_entity_id:\"sensor.presenca_escada_inferior_battery\",\n        last_seen_entity_id:\"sensor.presenca_escada_inferior_last_seen\",\n        linkquality_entity_id:\"sensor.presenca_escada_inferior_linkquality\",\n        offline_timeout_minutes: 4*60\n    },\n    {\n        base_id: \"binary_sensor.presenca_escada_superior\",\n        battery_entity_id:\"sensor.presenca_escada_superior_battery\",\n        last_seen_entity_id:\"sensor.presenca_escada_superior_last_seen\",\n        linkquality_entity_id:\"sensor.presenca_escada_superior_linkquality\",\n        \n        offline_timeout_minutes: 4*60\n    },\n    {\n        base_id: \"sensor.presenca_corredor_andar_2\",\n        offline_timeout_minutes: 4*60\n    },\n    {\n        base_id: \"sensor.presenca_corredor_andar_2_fundos\",\n        offline_timeout_minutes: 4*60\n    },\n    {\n        base_id: \"sensor.presenca_corredor_externo\",\n        offline_timeout_minutes: 4*60\n    },\n    {\n        base_id: \"sensor.presenca_garagem\",\n        offline_timeout_minutes: 4*60\n    },\n    {\n        base_id: \"sensor.presenca_garagem_frente\",\n        offline_timeout_minutes: 4*60\n    },\n    {\n        base_id: \"sensor.presenca_sala_tv\",\n        offline_timeout_minutes: 4*60\n    },\n    {\n        base_id: \"sensor.presenca_pergolado\",\n        offline_timeout_minutes: 4*60\n    },\n    {\n        base_id: \"sensor.presenca_pergolado_fundos\",\n        offline_timeout_minutes: 4*60\n    },\n    \n    // Chuva e pluviômetro\n    {\n        base_id: \"sensor.sensor_chuva\",\n        offline_timeout_minutes: 120\n    },\n    {\n        base_id: \"sensor.sensor_chuva_fundos\",\n        offline_timeout_minutes: 120\n    },\n    {\n        base_id: \"sensor.pluviometro\",\n        offline_timeout_minutes: 5 * 24 * 60\n    },\n\n    // Portas (COM timeout individual)\n    {\n        base_id: \"sensor.lava_loucas_porta\",\n        offline_timeout_minutes: 7 * 24 * 60\n    },\n    {\n        base_id: \"sensor.porta_cozinha\",\n        offline_timeout_minutes: 3 * 24 * 60\n    },\n    {\n        base_id: \"sensor.porta_oficina\",\n        offline_timeout_minutes: 3 * 24 * 60\n    },\n    {\n        base_id: \"sensor.portao_social_vazamento\",\n        offline_timeout_minutes: 3 * 24 * 60\n    },\n    {\n        base_id: \"sensor.portao_escada_superior\",\n        offline_timeout_minutes: 3 * 24 * 60\n    },      \n\n    // Janelas (COM timeout individual)\n    // {\n    //     base_id: \"sensor.janela_luisa\",\n    //     offline_timeout_minutes: 7 * 24 * 60\n    // },\n    {\n        base_id: \"sensor.janela_oficina\",\n        offline_timeout_minutes: 7 * 24 * 60\n    },\n\n    // Botões e Cubos (COM timeout individual)\n    {\n        base_id: \"sensor.botao_bancada_cozinha\",\n        offline_timeout_minutes: 1 * 24 * 60\n    },\n    {\n        base_id: \"sensor.botao_externo\",\n        offline_timeout_minutes: 1 * 24 * 60\n    },\n    {\n        base_id: \"sensor.botao_luisa\",\n        offline_timeout_minutes: 1 * 24 * 60\n    },\n    {\n        base_id: \"sensor.cubo_sala_tv\",\n        offline_timeout_minutes: 1 * 24 * 60\n    },\n\n    // Detector Fumaça\n    {\n        base_id: \"sensor.detector_fumaca_telecom\",\n        offline_timeout_minutes: 1 * 24 * 60\n    },\n\n    //Sensores umidade plantas\n    {\n        base_id:\"sensor.umidade_plantas_sala\"\n    },\n    {\n        base_id:\"sensor.umidade_plantas_pergolado\"\n    },\n\n    // adicione mais linhas aqui no futuro usando base_id\n];\n\n// Sensores extra SEM bateria (apenas offline + linkquality opcional)\nconst extraOfflineSensors = [\n    {\n        entity_id: \"sensor.mmwave_banheiro_externo_last_seen\",\n        offline_timeout_minutes: 30,\n        linkquality_entity_id: \"sensor.mmwave_banheiro_externo_linkquality\",\n    },\n    {\n        entity_id: \"sensor.mmwave_cozinha_last_seen\",\n        offline_timeout_minutes: 30,\n        linkquality_entity_id: \"sensor.mmwave_cozinha_linkquality\",\n    },\n    {\n        entity_id: \"sensor.mmwave_escritorio_last_seen\",\n        offline_timeout_minutes: 30,\n        linkquality_entity_id: \"sensor.mmwave_escritorio_linkquality\",\n    },\n    {\n        entity_id: \"sensor.mmwave_lavabo_last_seen\",\n        offline_timeout_minutes: 30,\n        linkquality_entity_id: \"sensor.mmwave_lavabo_linkquality\",\n    },\n    {\n        entity_id: \"sensor.mmwave_servico_last_seen\",\n        offline_timeout_minutes: 30,\n        linkquality_entity_id: \"sensor.mmwave_servico_linkquality\",\n    },\n    {\n        entity_id: \"sensor.sirene_last_seen\",\n        offline_timeout_minutes: 2 * 24 * 60,\n        linkquality_entity_id: \"sensor.sirene_linkquality\",\n    }\n];\n\n// ====== NORMALIZA CONFIG PARA A FUNÇÃO DE ANÁLISE ======\n\nconst batterySensors = batterySensorsConfig.map(cfg => {\n    const baseId = cfg.base_id;\n\n    const batteryEntityId = cfg.battery_entity_id || (baseId + SUFIXO_BATERIA);\n    const lastSeenEntityId = cfg.last_seen_entity_id || (baseId + SUFIXO_LAST_SEEN);\n    const linkqualityEntityId = cfg.linkquality_entity_id || (baseId + SUFIXO_LINK_QUALITY);\n\n    return {\n        base_id: baseId,\n\n        // bateria\n        entity_id: batteryEntityId,\n        type: SENSOR_TYPE,\n\n        // entidade usada para offline\n        main_entity_id: lastSeenEntityId,\n\n        // entidade de link quality\n        linkquality_entity_id: linkqualityEntityId,\n\n        // parâmetros opcionais\n        offline_timeout_minutes: cfg.offline_timeout_minutes,\n        linkquality_min: cfg.linkquality_min,\n        linkquality_delay_seconds: cfg.linkquality_delay_seconds,\n\n        not_verify_offline: cfg.not_verify_offline === true ? true : false\n    };\n});\n\nmsg.config = {\n    BATTERY_THRESHOLD,\n    OFFLINE_THRESHOLD_MINUTES,\n    LINKQUALITY_THRESHOLD,\n    LINKQUALITY_DELAY_SECONDS,\n    batterySensors,\n    extraOfflineSensors\n};\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":530,"y":80,"wires":[["e34fe1228c516db5"]]},{"id":"2d570f8834fe5ae0","type":"function","z":"e7f558013d35f6e4","name":"Monta payload notificação","func":"// MONTA PAYLOAD PARA persistent_notification.create\n\nif (!msg.hasNewProblemsForNotification) {\n    return null;\n}\n\nmsg.payload = {\n    data: {\n        title: msg.title || \"Monitor de baterias e sensores\",\n        message: msg.summary || msg.shortMessage || \"Problemas detectados com baterias/sensores.\"\n        // NADA de 'data' aqui dentro!\n    }\n};\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":170,"y":380,"wires":[["1474350ec3fb84d5"]]},{"id":"a2c425e908d8e55a","type":"function","z":"e7f558013d35f6e4","name":"Filtra notificações diárias","func":"// FILTRA NOTIFICAÇÕES DIÁRIAS POR SENSOR\n// Regra:\n// - notifica 1x por dia enquanto o problema persistir\n// - se o sensor sair do erro e voltar no mesmo dia, notifica novamente\n// - se continuar ruim no dia seguinte, notifica novamente\n\nfunction getTodayStr() {\n    const now = new Date();\n    const y = now.getFullYear();\n    const m = String(now.getMonth() + 1).padStart(2, \"0\");\n    const d = String(now.getDate()).padStart(2, \"0\");\n    return `${y}-${m}-${d}`;\n}\n\nconst today = getTodayStr();\n\n// lastNotified[key] = \"YYYY-MM-DD\"\n// keys:\n//   entity_id:lowBattery\n//   entity_id:lowLinkQuality\n//   entity_id:offline\n//   entity_id:recoveredBattery\n//   entity_id:recoveredLinkQuality\n//   entity_id:recoveredOnline\nlet lastNotified = flow.get(\"lastNotified\") || {};\n\n// Estado ativo do problema por sensor\n// problemState[key] = true/false\n// usado para saber se o sensor já \"saiu do erro\" e pode notificar de novo no mesmo dia\nlet problemState = flow.get(\"problemState\") || {};\n\n// Atalhos\nconst problems = msg.problems || {};\nconst lowBattery = problems.lowBattery || [];\nconst lowLinkQuality = problems.lowLinkQuality || [];\nconst offline = problems.offline || [];\nconst recovered = problems.recovered || [];\n\n// Listas filtradas\nconst lowBatteryToNotify = [];\nconst lowLinkQualityToNotify = [];\nconst offlineToNotify = [];\nconst recoveredToNotify = [];\n\n// ---------- RECUPERADOS ----------\nfor (const item of recovered) {\n    const id = item.entity_id;\n\n    if (item.batteryRecovered) {\n        const key = `${id}:lowBattery`;\n        problemState[key] = false;\n        delete lastNotified[key];\n\n        const rkey = `${id}:recoveredBattery`;\n        if (lastNotified[rkey] !== today) {\n            recoveredToNotify.push({\n                ...item,\n                type: \"battery\"\n            });\n            lastNotified[rkey] = today;\n        }\n    }\n\n    if (item.linkqualityRecovered) {\n        const key = `${id}:lowLinkQuality`;\n        problemState[key] = false;\n        delete lastNotified[key];\n\n        const rkey = `${id}:recoveredLinkQuality`;\n        if (lastNotified[rkey] !== today) {\n            recoveredToNotify.push({\n                ...item,\n                type: \"linkquality\"\n            });\n            lastNotified[rkey] = today;\n        }\n    }\n\n    if (item.onlineRecovered) {\n        const key = `${id}:offline`;\n        problemState[key] = false;\n        delete lastNotified[key];\n\n        const rkey = `${id}:recoveredOnline`;\n        if (lastNotified[rkey] !== today) {\n            recoveredToNotify.push({\n                ...item,\n                type: \"online\"\n            });\n            lastNotified[rkey] = today;\n        }\n    }\n}\n\n// ---------- BATERIA FRACA ----------\nfor (const item of lowBattery) {\n    const id = item.entity_id;\n    const key = `${id}:lowBattery`;\n\n    const wasActive = problemState[key] === true;\n    const alreadyNotifiedToday = lastNotified[key] === today;\n\n    if (!wasActive) {\n        // entrou agora em erro\n        problemState[key] = true;\n        lowBatteryToNotify.push(item);\n        lastNotified[key] = today;\n    } else if (!alreadyNotifiedToday) {\n        // já estava em erro, mas mudou de dia\n        lowBatteryToNotify.push(item);\n        lastNotified[key] = today;\n    }\n}\n\n// ---------- LINKQUALITY BAIXO ----------\nfor (const item of lowLinkQuality) {\n    const id = item.base_id || item.entity_id;\n    const key = `${id}:lowLinkQuality`;\n\n    const wasActive = problemState[key] === true;\n    const alreadyNotifiedToday = lastNotified[key] === today;\n\n    if (!wasActive) {\n        // entrou agora em erro\n        problemState[key] = true;\n        lowLinkQualityToNotify.push(item);\n        lastNotified[key] = today;\n    } else if (!alreadyNotifiedToday) {\n        // já estava em erro, mas mudou de dia\n        lowLinkQualityToNotify.push(item);\n        lastNotified[key] = today;\n    }\n}\n\n// ---------- OFFLINE ----------\nfor (const item of offline) {\n    const id = item.entity_id;\n    const key = `${id}:offline`;\n\n    const wasActive = problemState[key] === true;\n    const alreadyNotifiedToday = lastNotified[key] === today;\n\n    if (!wasActive) {\n        // ficou offline agora\n        problemState[key] = true;\n        offlineToNotify.push(item);\n        lastNotified[key] = today;\n    } else if (!alreadyNotifiedToday) {\n        // continua offline, mas virou o dia\n        offlineToNotify.push(item);\n        lastNotified[key] = today;\n    }\n}\n\n// Salva de volta no contexto\nflow.set(\"lastNotified\", lastNotified);\nflow.set(\"problemState\", problemState);\n\n// Monta objeto filtrado\nmsg.problemsToNotify = {\n    lowBattery: lowBatteryToNotify,\n    lowLinkQuality: lowLinkQualityToNotify,\n    offline: offlineToNotify,\n    recovered: recoveredToNotify\n};\n\nmsg.hasNewProblemsForNotification =\n    (lowBatteryToNotify.length > 0 ||\n     lowLinkQualityToNotify.length > 0 ||\n     offlineToNotify.length > 0 ||\n     recoveredToNotify.length > 0);\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":430,"y":240,"wires":[["2d570f8834fe5ae0","eb5cd55ec9dc6769"]]},{"id":"19506cecdead424a","type":"function","z":"e7f558013d35f6e4","name":"Detecta recuperados","func":"// DETECTA TRANSIÇÕES DE ERRO → OK (bateria fraca, linkquality baixa e/ou offline)\n\nconst problems = msg.problems || {};\nconst lowBattery = problems.lowBattery || [];\nconst lowLinkQuality = problems.lowLinkQuality || [];\nconst offline = problems.offline || [];\n\n// Acesso ao HA para pegar friendly_name\nconst ha = global.get('homeassistant');\nconst states = ha && ha.homeAssistant && ha.homeAssistant.states ?  ha.homeAssistant.states : {};\n\nfunction getFriendlyName(entityId) {\n    const ent = states[entityId];\n    if (ent && ent.attributes && ent.attributes.friendly_name) {\n        // Limpa sufixo \"Last seen\", se houver\n        return ent.attributes.friendly_name.replace(/\\s+Last\\s*seen$/i, \"\");\n    }\n    return entityId;\n}\n\n// Data de hoje\nfunction getTodayStr() {\n    const now = new Date();\n    const y = now.getFullYear();\n    const m = String(now.getMonth() + 1).padStart(2, \"0\");\n    const d = String(now.getDate()).padStart(2, \"0\");\n    return `${y}-${m}-${d}`;\n}\nconst today = getTodayStr();\n\n/**\n * sensorStatus[entity_id] = {\n *   lowBattery: bool,\n *   lowLinkQuality: bool,\n *   offline: bool,\n *   lastDay: \"YYYY-MM-DD\"\n * }\n */\nlet sensorStatus = flow.get(\"sensorStatus\") || {};\n\n// Pega o debounce de link quality para detectar recuperações de sensores\n// que estavam com LQ baixo mas não geraram alerta ainda\nlet linkQualityDebounce = flow.get(\"linkQualityDebounce\") || {};\n\n// Conjuntos atuais de problemas\nconst lowBatteryNow = new Set(lowBattery. map(i => i.entity_id));\nconst lowLqNow = new Set(\n    lowLinkQuality.map(i => i.base_id || i.entity_id) // usamos base_id se existir\n);\nconst offlineNow = new Set(offline.map(i => i.entity_id));\n\n// Conjuntos de sensores com LQ baixo NO DEBOUNCE (ainda não alertados, mas problemáticos)\nconst lowLqDebounceNow = new Set(Object.keys(linkQualityDebounce));\n\n// 1) Primeiro, marca o estado ATUAL no mapa (antes de detectar recuperações)\n//    Isso ajuda em cenários de restart. \n\nfor (const item of lowBattery) {\n    const id = item.entity_id;\n    if (! sensorStatus[id]) {\n        sensorStatus[id] = { lowBattery: false, lowLinkQuality: false, offline: false, lastDay: today };\n    }\n    sensorStatus[id].lowBattery = true;\n    sensorStatus[id].lastDay = today;\n}\n\n// Para linkquality, usamos base_id se existir, senão entity_id da própria LQ\nfor (const item of lowLinkQuality) {\n    const id = item.base_id || item.entity_id;\n    if (!sensorStatus[id]) {\n        sensorStatus[id] = { lowBattery: false, lowLinkQuality: false, offline: false, lastDay: today };\n    }\n    sensorStatus[id].lowLinkQuality = true;\n    sensorStatus[id].lastDay = today;\n}\n\n// Marca como LQ baixo os sensores que estão no debounce (mesmo sem alerta)\nfor (const baseId of lowLqDebounceNow) {\n    if (! sensorStatus[baseId]) {\n        sensorStatus[baseId] = { lowBattery: false, lowLinkQuality: false, offline: false, lastDay: today };\n    }\n    sensorStatus[baseId].lowLinkQuality = true;\n    sensorStatus[baseId]. lastDay = today;\n}\n\nfor (const item of offline) {\n    const id = item.entity_id;\n    if (!sensorStatus[id]) {\n        sensorStatus[id] = { lowBattery: false, lowLinkQuality: false, offline: false, lastDay: today };\n    }\n    sensorStatus[id].offline = true;\n    sensorStatus[id].lastDay = today;\n}\n\n// 2) Detecta quem se recuperou comparando estado anterior e atual\nconst recovered = [];\nconst sensorsToRemove = [];\n\nfor (const [entityId, status] of Object.entries(sensorStatus)) {\n    const hadLowBatBefore = !!status. lowBattery;\n    const hadLowLqBefore = !!status.lowLinkQuality;\n    const hadOfflineBefore = !! status.offline;\n\n    const hasLowBatNow = lowBatteryNow.has(entityId);\n    const hasLowLqNow = lowLqNow.has(entityId) || lowLqDebounceNow.has(entityId);\n    const hasOfflineNow = offlineNow.has(entityId);\n\n    let batteryRecovered = false;\n    let linkqualityRecovered = false;\n    let onlineRecovered = false;\n\n    if (hadLowBatBefore && !hasLowBatNow) {\n        batteryRecovered = true;\n        status.lowBattery = false;\n        status.lastDay = today;\n    }\n\n    if (hadLowLqBefore && !hasLowLqNow) {\n        linkqualityRecovered = true;\n        status.lowLinkQuality = false;\n        status.lastDay = today;\n    }\n\n    if (hadOfflineBefore && !hasOfflineNow) {\n        onlineRecovered = true;\n        status.offline = false;\n        status.lastDay = today;\n    }\n\n    if (batteryRecovered || linkqualityRecovered || onlineRecovered) {\n        recovered. push({\n            entity_id: entityId,\n            friendly_name: getFriendlyName(entityId),\n            batteryRecovered,\n            linkqualityRecovered,\n            onlineRecovered\n        });\n        \n        // Se o sensor está totalmente OK (sem nenhum problema),\n        // marca para remoção após processar recuperações\n        if (!status.lowBattery && !status.lowLinkQuality && !status.offline) {\n            sensorsToRemove.push(entityId);\n        }\n    }\n}\n\n// Remove sensores totalmente recuperados\nfor (const entityId of sensorsToRemove) {\n    delete sensorStatus[entityId];\n}\n\n// 3) Limpa sensores OK de dias antigos\nfor (const [entityId, status] of Object. entries(sensorStatus)) {\n    if (status.lastDay !== today && ! status.lowBattery && ! status.lowLinkQuality && !status.offline) {\n        delete sensorStatus[entityId];\n    }\n}\n\n// Salva no contexto\nflow.set(\"sensorStatus\", sensorStatus);\n\n// Atualiza msg.problems com recuperados\nmsg.problems = {\n    ... problems,\n    recovered\n};\n\nconst hasProblemsNow =\n    (lowBattery.length > 0 || lowLinkQuality.length > 0 || offline.length > 0);\n\nmsg.hasProblems = hasProblemsNow;\nmsg.hasRecoveries = recovered.length > 0;\n\n// Flag para notificar se houver problemas OU recuperações\nmsg.shouldNotify = msg.hasProblems || recovered.length > 0;\nmsg.payload = msg.shouldNotify;\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":440,"y":140,"wires":[["b147bda74deb9195"]]},{"id":"c109d3bb77fb1768","type":"comment","z":"e7f558013d35f6e4","name":"Verificação de senores (bateria/offline/link)","info":"","x":200,"y":40,"wires":[]},{"id":"eb5cd55ec9dc6769","type":"function","z":"e7f558013d35f6e4","name":"Monta payload Celular","func":"// MONTA TEXTO COMPLETO PARA O SUBFLOW DE PUSH\n\n// 1. Só notifica se há problemas novos ou recuperações novas hoje\nif (!msg.hasNewProblemsForNotification) {\n    return null;\n}\n\n// 2. Atalhos das informações vindas dos nós anteriores\nconst p = msg.problemsToNotify || {};\nconst recovered = p.recovered || [];\nconst title = msg.title || \"Monitor de baterias e sensores\";\n\n// 3. Monta a mensagem base com o resumo original (já inclui erros atuais)\nlet message = msg.shortMessage || msg.summary || \"Situação de baterias e sensores.\";\n\n// 4. Acrescenta bloco de recuperados (sensores que voltaram a funcionar)\nif (recovered.length > 0) {\n    const lines = [];\n    recovered.forEach(item => {\n        const name = item.friendly_name || item.entity_id;\n        if (item.type === \"battery\") {\n            lines.push(`- ${name}: bateria normalizada`);\n        } else if (item.type === \"linkquality\") {\n            lines.push(`- ${name}: link normalizado`);\n        } else if (item.type === \"online\") {\n            lines.push(`- ${name}: voltou online`);\n        }\n    });\n\n    if (lines.length > 0) {\n        message += \"\\n\\n✅ Normalizados:\\n\" + lines.join(\"\\n\");\n    }\n}\n\n// 5. Prepara os dados para o Subflow de PUSH\nmsg.payload = \"on\"; // Sinaliza para o subflow que é um alerta\nmsg.texto_push = `${title}\\n\\n${message}`;\n\n// Se quiser manter os botões de ação e ícone, o subflow de push precisará \n// ser ajustado depois, mas por enquanto isso garante que o texto chegue completo.\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":160,"y":300,"wires":[["87074f89756fc88b"]]},{"id":"9966f9754b135aa1","type":"time-range-switch","z":"e7f558013d35f6e4","name":"Horário Avisar?","lat":"-19.879587","lon":"-44.000821","startTime":"09:00","endTime":"20:30","startOffset":"0","endOffset":"0","x":640,"y":300,"wires":[["d77d8db0f13d6943"],[]]},{"id":"d77d8db0f13d6943","type":"subflow:ba4d7b17676436e8","z":"e7f558013d35f6e4","name":"Push Baterias","env":[{"name":"notifica_app_1","value":"mobile_app_ivan_celular","type":"str"},{"name":"texto_on","value":"texto_push","type":"msg"},{"name":"texto_off","value":"texto_push","type":"msg"}],"x":820,"y":300,"wires":[]},{"id":"87074f89756fc88b","type":"function","z":"e7f558013d35f6e4","name":"Filtro Anti-Repetição APP","func":"let data_hoje = new Date().toISOString().split('T')[0];\nlet texto_atual = msg.texto_push;\nlet ultimo_texto = context.get(\"ultimo_texto\");\nlet ultima_data = context.get(\"ultima_data\");\n\nif (texto_atual !== ultimo_texto || data_hoje !== ultima_data) {\n    context.set(\"ultimo_texto\", texto_atual);\n    context.set(\"ultima_data\", data_hoje);\n    return msg;\n}\nreturn null;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":430,"y":300,"wires":[["9966f9754b135aa1"]]},{"id":"1474350ec3fb84d5","type":"function","z":"e7f558013d35f6e4","name":"Filtro Anti-Repetição HA","func":"let data_hoje = new Date().toISOString().split('T')[0];\nlet texto_atual = msg.payload && msg.payload.data && msg.payload.data.message ? msg.payload.data.message : \"\";\nlet ultimo_texto = context.get(\"ultimo_texto\");\nlet ultima_data = context.get(\"ultima_data\");\n\nif (texto_atual !== ultimo_texto || data_hoje !== ultima_data) {\n    context.set(\"ultimo_texto\", texto_atual);\n    context.set(\"ultima_data\", data_hoje);\n    return msg;\n}\nreturn null;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":430,"y":380,"wires":[["8a7c2d5730b2fffb"]]},{"id":"sensor_telhado","type":"server-state-changed","z":"vazamento_v14_final","name":"Telhado","server":"12097a98.a70645","version":6,"outputs":2,"exposeAsEntityConfig":"","entities":{"entity":["binary_sensor.vazamento_telhado_water_leak"],"substring":[],"regex":[]},"outputInitially":false,"stateType":"str","ifState":"on","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"10","forType":"num","forUnits":"seconds","ignorePrevStateNull":true,"ignorePrevStateUnknown":true,"ignorePrevStateUnavailable":true,"ignoreCurrentStateUnknown":true,"ignoreCurrentStateUnavailable":true,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"nome_sensor","propertyType":"msg","value":"Telhado","valueType":"str"},{"property":"topic","propertyType":"msg","value":"","valueType":"str"}],"x":90,"y":80,"wires":[["logic_v14_core"],["logic_v14_core"]]},{"id":"sensor_suite_v14","type":"server-state-changed","z":"vazamento_v14_final","name":"Suite Master Esquerda","server":"12097a98.a70645","version":6,"outputs":2,"exposeAsEntityConfig":"","entities":{"entity":["binary_sensor.vazamento_suite_master_esquerda_water_leak"],"substring":[],"regex":[]},"outputInitially":false,"stateType":"str","ifState":"on","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"10","forType":"num","forUnits":"seconds","ignorePrevStateNull":true,"ignorePrevStateUnknown":true,"ignorePrevStateUnavailable":true,"ignoreCurrentStateUnknown":true,"ignoreCurrentStateUnavailable":true,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"nome_sensor","propertyType":"msg","value":"Suíte Master Esquerda","valueType":"str"},{"property":"topic","propertyType":"msg","value":"","valueType":"str"}],"x":140,"y":280,"wires":[["logic_v14_core"],["logic_v14_core"]]},{"id":"logic_v14_core","type":"function","z":"vazamento_v14_final","name":"Estado e Msg","func":"let ativos = flow.get('vazamentos_ativos') || {};\nconst id = msg.topic || \"sensor_desconhecido\";\nconst status = msg.payload;\nconst nome = msg.nome_sensor || \"Sem Nome\";\n\nif (status === 'on') {\n    ativos[id] = nome;\n    msg.texto_notificacao = `ALERTA: Vazamento no ${nome}!`;\n} else {\n    delete ativos[id];\n    msg.texto_notificacao = `FIM: ${nome} seco.`;\n}\n\nflow.set('vazamentos_ativos', ativos);\n\nconst lista = Object.values(ativos);\nmsg.count = lista.length;\nmsg.texto_falado = msg.count > 0 ? `Atenção! Vazamento em: ${lista.join(', ')}` : \"\";\n\n// Saída 1: Push e Sync | Saída 2: Start/Stop Loop\nreturn [msg, { payload: (status === 'on' ? 'start' : 'stop') }];","outputs":2,"noerr":0,"initialize":"","finalize":"","libs":[],"x":420,"y":200,"wires":[["ha_sync_v14","136414c904e00f83"],["loop_trigger_v14"]]},{"id":"ha_sync_v14","type":"api-call-service","z":"vazamento_v14_final","name":"Sync HA","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"input_boolean.turn_{{payload}}","floorId":[],"areaId":[],"deviceId":[],"entityId":["input_boolean.vazamento_agua"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"input_boolean","service":"turn_{{payload}}","x":640,"y":160,"wires":[[]]},{"id":"loop_trigger_v14","type":"trigger","z":"vazamento_v14_final","name":"Motor 60 min","op1":"check","op2":"check","op1type":"str","op2type":"str","duration":"60","extend":false,"overrideDelay":false,"units":"min","reset":"stop","bytopic":"all","topic":"topic","outputs":1,"x":170,"y":580,"wires":[["anti_duplicidade"]]},{"id":"anti_duplicidade","type":"function","z":"vazamento_v14_final","name":"Bloqueia Duplicatas","func":"// Cria um timestamp arredondado para os últimos 5 segundos\n// Isso garante que qualquer mensagem extra no mesmo ciclo tenha o mesmo ID\nconst roundTime = Math.floor(Date.now() / 5000);\nmsg.loop_id = roundTime;\nreturn msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":360,"y":580,"wires":[["rbe_v14"]]},{"id":"rbe_v14","type":"rbe","z":"vazamento_v14_final","name":"Filtro RBE","func":"rbe","gap":"","start":"","property":"loop_id","x":550,"y":580,"wires":[["check_ativos_v14"]]},{"id":"check_ativos_v14","type":"function","z":"vazamento_v14_final","name":"Check Ativos","func":"let ativos = flow.get('vazamentos_ativos') || {};\nlet lista = Object.values(ativos);\n\nif (lista.length > 0) {\n    msg.payload = 'on';\n    msg.texto_falado = `Vazamento em: ${lista.join(', ')}`;\n    return msg;\n}\nreturn null;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":710,"y":580,"wires":[["criticos_v14"]]},{"id":"criticos_v14","type":"api-current-state","z":"vazamento_v14_final","name":"Críticos?","server":"12097a98.a70645","version":3,"outputs":2,"halt_if":"on","halt_if_type":"str","halt_if_compare":"is","entity_id":"input_boolean.alertas_criticos","state_type":"str","blockInputOverrides":false,"outputProperties":[],"for":0,"forType":"num","forUnits":"minutes","x":120,"y":680,"wire