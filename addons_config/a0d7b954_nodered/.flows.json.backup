:1,"x":110,"y":560,"wires":[["e82aa0e3f108ea3c"]]},{"id":"e82aa0e3f108ea3c","type":"function","z":"7f0478e1.026128","name":"Status Zonas","func":"// Inicializa os estados como falsos por padrão\nlet zonasAtivas = {\n    fundos: { enabled: false, adjustment: \"0\" },\n    gramado: { enabled: false, adjustment: \"0\" },\n    frente: { enabled: false, adjustment: \"0\" },\n    horta: { enabled: false, adjustment: \"0\" },\n    corredor: { enabled: false, adjustment: \"0\" }\n};\n\n// Mapeamento das entidades para facilitar a manutenção\nconst mapaEntidades = {\n    \"binary_sensor.irrigation_unlimited_c1_z1\": \"fundos\",\n    \"binary_sensor.irrigation_unlimited_c1_z2\": \"gramado\",\n    \"binary_sensor.irrigation_unlimited_c1_z3\": \"frente\",\n    \"binary_sensor.irrigation_unlimited_c2_z1\": \"horta\",\n    \"binary_sensor.irrigation_unlimited_c3_z1\": \"corredor\"\n};\n\n// Processa as entidades recebidas\nif (Array.isArray(msg.payload)) {\n    msg.payload.forEach(entity => {\n        const zonaKey = mapaEntidades[entity.entity_id];\n        if (zonaKey && entity.attributes) {\n            zonasAtivas[zonaKey].enabled = entity.attributes.enabled === true;\n            zonasAtivas[zonaKey].adjustment = String(entity.attributes.adjustment || \"0\");\n        }\n    });\n}\n\n// Lógica de decisão (Linhas 40-44 otimizadas)\n// Verifica se pelo menos uma zona está habilitada E não está com ajuste de 0%\nconst deveAvisar = Object.values(zonasAtivas).some(zona => {\n    // No Irrigation Unlimited, \"%0.0\" ou \"0\" significa que a zona não vai rodar\n    return zona.enabled === true && \n           zona.adjustment !== \"%0.0\" && \n           zona.adjustment !== \"0\" &&\n           zona.adjustment !== \"0.0\";\n});\n\nmsg.payload = deveAvisar ? \"on\" : \"off\";\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":310,"y":560,"wires":[["375d5e5b.5fdd12"]]},{"id":"8dd09ee26a8d784a","type":"server-state-changed","z":"7f0478e1.026128","name":"Controle Fonte","server":"12097a98.a70645","version":6,"outputs":2,"exposeAsEntityConfig":"","entities":{"entity":["input_boolean.fonte_automatico"],"substring":[],"regex":[]},"outputInitially":false,"stateType":"str","ifState":"on","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"eventData"},{"property":"topic","propertyType":"msg","value":"","valueType":"triggerId"}],"x":120,"y":140,"wires":[["9bb6d472.136da8"],["99becef5.5eb8d"]]},{"id":"f181c18a70a87464","type":"comment","z":"7f0478e1.026128","name":"Alerta Irrigação Interna","info":"","x":140,"y":920,"wires":[]},{"id":"55c0e85aa4f84f0d","type":"change","z":"7f0478e1.026128","name":"ON","rules":[{"t":"set","p":"payload","pt":"msg","to":"on","tot":"str"}],"action":"","property":"","from":"","to":"","reg":false,"x":650,"y":400,"wires":[["dc77708e7fe2c4b6"]]},{"id":"8cad67d2.3c0138","type":"inject","z":"7f0478e1.026128","name":"Pulso 10 min","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"600","crontab":"","once":true,"onceDelay":"10","topic":"","payload":"","payloadType":"date","x":140,"y":80,"wires":[["815b2338.ee7f3"]]},{"id":"e7eb211d0da62035","type":"api-current-state","z":"7f0478e1.026128","name":"Bateria casa SOC baixo?","server":"12097a98.a70645","version":3,"outputs":2,"halt_if":"off","halt_if_type":"str","halt_if_compare":"is","entity_id":"input_boolean.bateria_casa_soc_baixo","state_type":"str","blockInputOverrides":false,"outputProperties":[],"for":"","forType":"num","forUnits":"minutes","x":850,"y":80,"wires":[["8038ffd.76c91"],["99becef5.5eb8d"]]},{"id":"a1b9b8d526618eee","type":"subflow:29d0962b.dafb3a","z":"7f0478e1.026128","name":"Fala: planta seca","env":[{"name":"entidade_media_player","value":"media_player.sala_de_tv_2","type":"str"},{"name":"volume","value":"50","type":"num"},{"name":"texto_falado_on","value":"","type":"str"},{"name":"texto_falado_off","value":"","type":"str"}],"x":610,"y":1340,"wires":[]},{"id":"af125d3e2cbc78db","type":"subflow:29d0962b.dafb3a","z":"7f0478e1.026128","name":"Fala: planta regada","env":[{"name":"entidade_media_player","value":"media_player.sala_de_tv_2","type":"str"},{"name":"volume","value":"50","type":"num"},{"name":"texto_falado_on","value":"","type":"str"},{"name":"texto_falado_off","value":"","type":"str"}],"x":1010,"y":1340,"wires":[]},{"id":"e687fbbe0e36ca55","type":"api-call-service","z":"7f0478e1.026128","name":"Indica umidade solo baixa","server":"12097a98.a70645","version":7,"debugenabled":true,"action":"input_boolean.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["input_boolean.alerta_regar_plantas"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"input_boolean","service":"turn_on","x":450,"y":1280,"wires":[["ab3c08ccf5dbdac7"]]},{"id":"82e70d56b7bfc631","type":"api-call-service","z":"7f0478e1.026128","name":"Indica umidade solo OK","server":"12097a98.a70645","version":7,"debugenabled":true,"action":"input_boolean.turn_off","floorId":[],"areaId":[],"deviceId":[],"entityId":["input_boolean.alerta_regar_plantas"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"input_boolean","service":"turn_off","x":850,"y":1280,"wires":[["9172ab19a2d19ff0"]]},{"id":"ab3c08ccf5dbdac7","type":"time-range-switch","z":"7f0478e1.026128","name":"Horário Normal?","lat":"-19.879587","lon":"-44.000821","startTime":"07:40:00","endTime":"19:30:00","startOffset":"0","endOffset":0,"x":420,"y":1340,"wires":[["a1b9b8d526618eee"],["b74e71ce10f4ba3a"]]},{"id":"1848684fb55c59d7","type":"inject","z":"7f0478e1.026128","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":160,"y":1300,"wires":[["7f37b6b0de863ffe"]]},{"id":"b959f01bf3412b95","type":"inject","z":"7f0478e1.026128","name":"Carregar config","props":[{"p":"payload"}],"repeat":"","crontab":"","once":true,"onceDelay":"2","topic":"","payload":"","payloadType":"date","x":120,"y":960,"wires":[["364ba6834f0cc3ff"]]},{"id":"364ba6834f0cc3ff","type":"function","z":"7f0478e1.026128","name":"Configuração centralizada vasos","func":"/**\n * CONFIGURAÇÃO CENTRALIZADA DE SENSORES DE UMIDADE / VASOS\n *\n * OBJETIVO\n * --------\n * Centralizar em um único lugar:\n * - lista de vasos monitorados\n * - thresholds default\n * - input_numbers de override dinâmico\n * - parâmetros globais do gestor\n *\n * SAÍDA\n * -----\n * msg.config = {\n *   THROTTLE_MIN,\n *   DEBUG_ENABLE,\n *   FRASE_BAIXA_PREFIXO,\n *   FRASE_NORMALIZADA_PREFIXO,\n *   plantSensors\n * }\n *\n * OBSERVAÇÕES\n * -----------\n * - min_umidade: limiar para considerar vaso em baixa\n * - ok_umidade: limiar para considerar normalizado\n * - Se ok_umidade < min_umidade, a função ajusta ok_umidade = min_umidade\n * - input_number_* são opcionais; se ausentes, o vaso usa apenas os defaults\n * - enabled = false permite desabilitar um vaso sem apagar sua configuração\n */\n\n// ==============================\n// PARÂMETROS GLOBAIS\n// ==============================\nconst THROTTLE_MIN = 60;\nconst DEBUG_ENABLE = false;\n\nconst FRASE_BAIXA_PREFIXO = \"Atenção, vasos à regar:\";\nconst FRASE_NORMALIZADA_PREFIXO = \"Ótimo, vasos regados:\";\n\nconst SENSOR_TYPE = \"state\";\nconst STARTUP_SILENCE_SECONDS = 20;\n\n// ==============================\n// CONFIGURAÇÃO BRUTA DOS VASOS\n// ==============================\n// Campos suportados:\n// - base_id: obrigatório\n// - nome_vaso: obrigatório\n// - min_umidade: obrigatório\n// - ok_umidade: obrigatório\n// - sensor_id: opcional (override explícito)\n// - entity_id: opcional (override explícito)\n// - input_number_min_entity_id: opcional\n// - input_number_ok_entity_id: opcional\n// - enabled: opcional (default true)\nconst plantsConfig = [\n    {\n        base_id: \"sensor.umidade_plantas_pergolado_soil_moisture\",\n        nome_vaso: \"vasos do pergolado\",\n        min_umidade: 45,\n        ok_umidade: 50,\n        input_number_min_entity_id: \"input_number.umidade_pergolado_min\",\n        input_number_ok_entity_id: \"input_number.umidade_pergolado_ok\",\n        enabled: true\n    },\n    {\n        base_id: \"sensor.umidade_plantas_sala_soil_moisture\",\n        nome_vaso: \"vasos da sala\",\n        min_umidade: 40,\n        ok_umidade: 65,\n        input_number_min_entity_id: \"input_number.umidade_sala_min\",\n        input_number_ok_entity_id: \"input_number.umidade_sala_ok\",\n        enabled: true\n    }\n\n    // Exemplo para adicionar mais vasos:\n    // {\n    //     base_id: \"sensor.umidade_plantas_escritorio_soil_moisture\",\n    //     nome_vaso: \"vaso do escritório\",\n    //     min_umidade: 20,\n    //     ok_umidade: 45,\n    //     input_number_min_entity_id: \"input_number.umidade_min_vaso_escritorio\",\n    //     input_number_ok_entity_id: \"input_number.umidade_ok_vaso_escritorio\",\n    //     enabled: true\n    // }\n];\n\n// ==============================\n// HELPERS\n// ==============================\nfunction normalizeThresholdPair(minValue, okValue) {\n    let min = Number(minValue);\n    let ok = Number(okValue);\n    let adjusted = false;\n\n    if (Number.isNaN(min)) min = 0;\n    if (Number.isNaN(ok)) ok = min;\n\n    if (ok < min) {\n        ok = min;\n        adjusted = true;\n    }\n\n    return { min, ok, adjusted };\n}\n\nfunction asNonEmptyString(value, fallback = \"\") {\n    return (typeof value === \"string\" && value.trim() !== \"\") ? value.trim() : fallback;\n}\n\n// ==============================\n// NORMALIZAÇÃO E VALIDAÇÃO\n// ==============================\nconst warnings = [];\nconst seenSensorIds = new Set();\nconst seenInputNumbers = new Set();\n\nconst plantSensors = plantsConfig\n    .filter((cfg, index) => {\n        const enabled = cfg.enabled !== false;\n\n        if (!enabled) {\n            warnings.push(`Item ${index} ignorado: enabled=false (${cfg.nome_vaso || cfg.base_id || \"sem identificação\"})`);\n            return false;\n        }\n\n        if (!cfg.base_id || typeof cfg.base_id !== \"string\") {\n            warnings.push(`Item ${index} ignorado: base_id ausente ou inválido`);\n            return false;\n        }\n\n        if (!cfg.nome_vaso || typeof cfg.nome_vaso !== \"string\") {\n            warnings.push(`Item ${index} ignorado: nome_vaso ausente ou inválido (${cfg.base_id})`);\n            return false;\n        }\n\n        return true;\n    })\n    .map((cfg, index) => {\n        const sensorId = asNonEmptyString(cfg.sensor_id, cfg.base_id);\n        const entityId = asNonEmptyString(cfg.entity_id, sensorId);\n        const nomeVaso = asNonEmptyString(cfg.nome_vaso, sensorId);\n\n        const normalized = normalizeThresholdPair(cfg.min_umidade, cfg.ok_umidade);\n\n        const inputMin = asNonEmptyString(cfg.input_number_min_entity_id, \"\");\n        const inputOk = asNonEmptyString(cfg.input_number_ok_entity_id, \"\");\n\n        if (seenSensorIds.has(sensorId)) {\n            warnings.push(`sensor_id duplicado detectado: ${sensorId}`);\n        }\n        seenSensorIds.add(sensorId);\n\n        if (inputMin) {\n            if (seenInputNumbers.has(inputMin)) {\n                warnings.push(`input_number duplicado detectado: ${inputMin}`);\n            }\n            seenInputNumbers.add(inputMin);\n        }\n\n        if (inputOk) {\n            if (seenInputNumbers.has(inputOk)) {\n                warnings.push(`input_number duplicado detectado: ${inputOk}`);\n            }\n            seenInputNumbers.add(inputOk);\n        }\n\n        if (normalized.adjusted) {\n            warnings.push(`Threshold ajustado para ${nomeVaso}: ok_umidade < min_umidade, então ok foi ajustado para ${normalized.ok}`);\n        }\n\n        return {\n            base_id: cfg.base_id,\n            sensor_id: sensorId,\n            entity_id: entityId,\n            type: SENSOR_TYPE,\n            nome_vaso: nomeVaso,\n\n            min_umidade: normalized.min,\n            ok_umidade: normalized.ok,\n\n            input_number_min_entity_id: inputMin,\n            input_number_ok_entity_id: inputOk,\n\n            thresholds_adjusted_on_config: normalized.adjusted\n        };\n    });\n\n// ==============================\n// SAÍDA FINAL\n// ==============================\nmsg.config = {\n    THROTTLE_MIN,\n    DEBUG_ENABLE,\n    FRASE_BAIXA_PREFIXO,\n    FRASE_NORMALIZADA_PREFIXO,\n    STARTUP_SILENCE_SECONDS,\n    plantSensors\n};\n\n// Metadados úteis para debug\nmsg.config_meta = {\n    total_vasos_configurados: plantSensors.length,\n    warnings\n};\n\n// Opcional: deixa aviso visível no log do Node-RED\nif (warnings.length > 0) {\n    node.warn(`[IRRIGACAO CONFIG] ${warnings.join(\" | \")}`);\n}\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":370,"y":960,"wires":[["b2f32de1874bdcfb"]]},{"id":"b2f32de1874bdcfb","type":"change","z":"7f0478e1.026128","name":"Salvar config em flow.plants_config","rules":[{"t":"set","p":"plants_config","pt":"flow","to":"config","tot":"msg"}],"action":"","property":"","from":"","to":"","reg":false,"x":680,"y":960,"wires":[["a3096aef1456a260"]]},{"id":"a3096aef1456a260","type":"debug","z":"7f0478e1.026128","name":"debug config","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"config","targetType":"msg","x":930,"y":960,"wires":[]},{"id":"7ee1e4c47ac15422","type":"server-state-changed","z":"7f0478e1.026128","name":"Eventos sensores umidade","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["sensor.umidade_plantas_pergolado_soil_moisture","sensor.umidade_plantas_sala_soil_moisture"],"substring":[],"regex":[]},"outputInitially":true,"stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":true,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"eventData"}],"x":150,"y":1020,"wires":[["b88a0fc8f43be414"]]},{"id":"b88a0fc8f43be414","type":"function","z":"7f0478e1.026128","name":"Normalizar evento sensor","func":"const LOG_SUCCESS = false;\nconst LOG_WARNINGS = true;\n\nfunction warn(msg) {\n    if (LOG_WARNINGS) node.warn(msg);\n}\n\nfunction info(msg) {\n    if (LOG_SUCCESS) node.warn(msg);\n}\n\nconst config = flow.get('plants_config') || {};\nconst plantSensors = Array.isArray(config.plantSensors) ? config.plantSensors : [];\n\n// --------------------------------------------------\n// 1) Validação mínima da configuração carregada\n// --------------------------------------------------\nif (plantSensors.length === 0) {\n    warn(\"[IRRIGACAO] Nenhum plantSensors encontrado em flow.plants_config. Verifique se a function de configuração já executou.\");\n    return null;\n}\n\n// --------------------------------------------------\n// 2) Descobre a entidade recebida\n// --------------------------------------------------\nconst entityId = msg?.data?.entity_id || msg?.entity_id;\n\nif (!entityId || typeof entityId !== \"string\") {\n    warn(`[IRRIGACAO] Evento de sensor ignorado: entity_id ausente ou inválido. msg.payload=${JSON.stringify(msg.payload)}`);\n    return null;\n}\n\n// --------------------------------------------------\n// 3) Detecta mapeamentos candidatos\n// --------------------------------------------------\nconst matches = plantSensors.filter(p =>\n    p &&\n    (\n        p.sensor_id === entityId ||\n        p.entity_id === entityId ||\n        p.base_id === entityId\n    )\n);\n\n// --------------------------------------------------\n// 4) Trata sensor não configurado\n// --------------------------------------------------\nif (matches.length === 0) {\n    const sensoresConhecidos = plantSensors.map(p => p.sensor_id).join(\", \");\n    warn(`[IRRIGACAO] Sensor recebido não está configurado: ${entityId}. Sensores conhecidos: ${sensoresConhecidos}`);\n    return null;\n}\n\n// --------------------------------------------------\n// 5) Trata duplicidade de mapeamento\n// --------------------------------------------------\nif (matches.length > 1) {\n    const duplicados = matches.map(p => `${p.nome_vaso}(${p.sensor_id})`).join(\", \");\n    warn(`[IRRIGACAO] Mapeamento duplicado detectado para entity_id=${entityId}. Correspondências: ${duplicados}`);\n    return null;\n}\n\nconst cfg = matches[0];\n\n// --------------------------------------------------\n// 6) Validação do valor de umidade\n// --------------------------------------------------\nconst rawPayload = msg.payload;\nconst umidade = Number(rawPayload);\n\nif (rawPayload === \"\" || rawPayload === null || rawPayload === undefined) {\n    warn(`[IRRIGACAO] Umidade vazia para sensor ${entityId}. payload=${JSON.stringify(rawPayload)}`);\n    return null;\n}\n\nif (rawPayload === \"unknown\" || rawPayload === \"unavailable\") {\n    warn(`[IRRIGACAO] Umidade indisponível para sensor ${entityId}. payload=${rawPayload}`);\n    return null;\n}\n\nif (Number.isNaN(umidade)) {\n    warn(`[IRRIGACAO] Payload não numérico para sensor ${entityId}. payload=${JSON.stringify(rawPayload)}`);\n    return null;\n}\n\n// --------------------------------------------------\n// 7) Normalização final da mensagem\n// --------------------------------------------------\nmsg.config = config;\nmsg.topic = \"sensor_update\";\nmsg.payload = {\n    sensor_id: cfg.sensor_id,\n    umidade: umidade\n};\n\nmsg.debug_sensor_normalizado = {\n    entity_id_recebido: entityId,\n    sensor_id_mapeado: cfg.sensor_id,\n    entity_id_configurado: cfg.entity_id,\n    base_id_configurado: cfg.base_id,\n    nome_vaso: cfg.nome_vaso,\n    umidade: umidade,\n    raw_payload: rawPayload\n};\n\ninfo(\n    `[IRRIGACAO] sensor_update -> entity=${entityId}` +\n    ` | sensor_id=${cfg.sensor_id}` +\n    ` | vaso=${cfg.nome_vaso}` +\n    ` | umidade=${umidade}`\n);\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":450,"y":1020,"wires":[["d81a936ca3d12847"]]},{"id":"f9c9588b57d64d78","type":"server-state-changed","z":"7f0478e1.026128","name":"Eventos input_number limiares","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["input_number.umidade_pergolado_min","input_number.umidade_pergolado_ok","input_number.umidade_sala_min","input_number.umidade_sala_ok"],"substring":[],"regex":[]},"outputInitially":true,"stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":false,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"eventData"}],"x":170,"y":1080,"wires":[["adf40282fec00776"]]},{"id":"adf40282fec00776","type":"function","z":"7f0478e1.026128","name":"Normalizar input_number limiar","func":"const LOG_SUCCESS = false;\nconst LOG_WARNINGS = true;\n\nfunction warn(msg) {\n    if (LOG_WARNINGS) node.warn(msg);\n}\n\nfunction info(msg) {\n    if (LOG_SUCCESS) node.warn(msg);\n}\n\nconst config = flow.get('plants_config') || {};\nconst plantSensors = Array.isArray(config.plantSensors) ? config.plantSensors : [];\n\n// --------------------------------------------------\n// 1) Validação mínima da configuração carregada\n// --------------------------------------------------\nif (plantSensors.length === 0) {\n    warn(\"[IRRIGACAO] Nenhum plantSensors encontrado em flow.plants_config para normalização de input_number.\");\n    return null;\n}\n\n// --------------------------------------------------\n// 2) Descobre a entidade recebida\n// --------------------------------------------------\nconst entityId = msg?.data?.entity_id || msg?.entity_id;\n\nif (!entityId || typeof entityId !== \"string\") {\n    warn(`[IRRIGACAO] Evento de input_number ignorado: entity_id ausente ou inválido. payload=${JSON.stringify(msg.payload)}`);\n    return null;\n}\n\n// --------------------------------------------------\n// 3) Busca correspondências por input_number min/ok\n// --------------------------------------------------\nconst matches = plantSensors.filter(p =>\n    p &&\n    (\n        p.input_number_min_entity_id === entityId ||\n        p.input_number_ok_entity_id === entityId\n    )\n);\n\n// --------------------------------------------------\n// 4) Trata input_number não configurado\n// --------------------------------------------------\nif (matches.length === 0) {\n    const conhecidos = plantSensors\n        .flatMap(p => [p.input_number_min_entity_id, p.input_number_ok_entity_id])\n        .filter(Boolean)\n        .join(\", \");\n\n    warn(`[IRRIGACAO] input_number recebido não está configurado: ${entityId}. Inputs conhecidos: ${conhecidos}`);\n    return null;\n}\n\n// --------------------------------------------------\n// 5) Trata duplicidade de mapeamento\n// --------------------------------------------------\nif (matches.length > 1) {\n    const duplicados = matches.map(p => `${p.nome_vaso}(${p.sensor_id})`).join(\", \");\n    warn(`[IRRIGACAO] Mapeamento duplicado detectado para input_number=${entityId}. Correspondências: ${duplicados}`);\n    return null;\n}\n\nconst plant = matches[0];\n\n// --------------------------------------------------\n// 6) Descobre se é threshold min ou ok\n// --------------------------------------------------\nconst isMin = plant.input_number_min_entity_id === entityId;\nconst isOk = plant.input_number_ok_entity_id === entityId;\n\nif (!isMin && !isOk) {\n    warn(`[IRRIGACAO] input_number ${entityId} encontrado, mas não foi possível determinar se é min ou ok.`);\n    return null;\n}\n\nconst thresholdKind = isMin ? \"min\" : \"ok\";\nconst raw = msg.payload;\n\nmsg.config = config;\n\n// --------------------------------------------------\n// 7) Trata reset implícito para voltar ao default\n// --------------------------------------------------\nif (\n    raw === \"unknown\" ||\n    raw === \"unavailable\" ||\n    raw === \"\" ||\n    raw === null ||\n    raw === undefined\n) {\n    msg.topic = \"threshold_reset\";\n    msg.payload = {\n        sensor_id: plant.sensor_id\n    };\n\n    if (isMin) msg.payload.reset_min = true;\n    if (isOk) msg.payload.reset_ok = true;\n\n    msg.debug_threshold_normalizado = {\n        entity_id_recebido: entityId,\n        sensor_id_mapeado: plant.sensor_id,\n        nome_vaso: plant.nome_vaso,\n        threshold_kind: thresholdKind,\n        action: \"reset\",\n        raw_payload: raw\n    };\n\n    info(\n        `[IRRIGACAO] threshold_reset -> input=${entityId}` +\n        ` | vaso=${plant.nome_vaso}` +\n        ` | sensor_id=${plant.sensor_id}` +\n        ` | kind=${thresholdKind}` +\n        ` | motivo=payload inválido/indisponível`\n    );\n\n    return msg;\n}\n\n// --------------------------------------------------\n// 8) Converte e valida valor numérico\n// --------------------------------------------------\nconst valor = Number(raw);\n\nif (Number.isNaN(valor)) {\n    warn(`[IRRIGACAO] Valor não numérico em input_number ${entityId}. payload=${JSON.stringify(raw)}`);\n    return null;\n}\n\n// --------------------------------------------------\n// 9) Monta threshold_update\n// --------------------------------------------------\nmsg.topic = \"threshold_update\";\nmsg.payload = {\n    sensor_id: plant.sensor_id\n};\n\nif (isMin) {\n    msg.payload.min_umidade = valor;\n}\n\nif (isOk) {\n    msg.payload.ok_umidade = valor;\n}\n\nmsg.debug_threshold_normalizado = {\n    entity_id_recebido: entityId,\n    sensor_id_mapeado: plant.sensor_id,\n    nome_vaso: plant.nome_vaso,\n    threshold_kind: thresholdKind,\n    action: \"update\",\n    valor: valor,\n    raw_payload: raw\n};\n\ninfo(\n    `[IRRIGACAO] threshold_update -> input=${entityId}` +\n    ` | vaso=${plant.nome_vaso}` +\n    ` | sensor_id=${plant.sensor_id}` +\n    ` | kind=${thresholdKind}` +\n    ` | valor=${valor}`\n);\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":470,"y":1080,"wires":[["d81a936ca3d12847"]]},{"id":"dfdbe70d03c211ec","type":"server-state-changed","z":"7f0478e1.026128","name":"Controle lembrete regar plantas","server":"12097a98.a70645","version":6,"outputs":1,"exposeAsEntityConfig":"","entities":{"entity":["input_boolean.lembrete_regar_plantas"],"substring":[],"regex":[]},"outputInitially":true,"stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputOnlyOnStateChange":false,"for":"0","forType":"num","forUnits":"minutes","ignorePrevStateNull":false,"ignorePrevStateUnknown":false,"ignorePrevStateUnavailable":false,"ignoreCurrentStateUnknown":false,"ignoreCurrentStateUnavailable":false,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"eventData"}],"x":170,"y":1140,"wires":[["6c2b129be3016fe2"]]},{"id":"6c2b129be3016fe2","type":"function","z":"7f0478e1.02