7c0bf52324","type":"change","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"","rules":[{"t":"set","p":"reset","pt":"msg","to":"true","tot":"bool"},{"t":"set","p":"payload","pt":"msg","to":"comando_status","tot":"flow"},{"t":"set","p":"error.source.count","pt":"msg","to":"0","tot":"num"},{"t":"set","p":"port","pt":"msg","to":"9015","tot":"num"}],"action":"","property":"","from":"","to":"","reg":false,"x":340,"y":760,"wires":[["f842f9f8377232ba","b5ca1a5348c352ea"]]},{"id":"229e461070752bd6","type":"inject","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"STATUS","props":[{"p":"payload"}],"repeat":"0.33","crontab":"","once":true,"onceDelay":"5","topic":"","payload":"comando_status","payloadType":"flow","x":160,"y":940,"wires":[["f842f9f8377232ba","1652de67da0937dd"]]},{"id":"ff4e1652c55373ea","type":"tcp request","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"Conexão TCP","server":"","port":"","out":"time","ret":"buffer","splitc":"200","newline":"","trim":false,"tls":"","x":800,"y":940,"wires":[["c248e3acf2e29dbb","4eb836db38ea7ffa","544a9c9243472749","91e2108ba718830d","5d4dad28017049fd"]]},{"id":"e58fa8b56a38fac5","type":"link in","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"TCP REQUEST","links":["7992f49608eba2a1","436cf32ac884b59d"],"x":375,"y":980,"wires":[["f842f9f8377232ba"]]},{"id":"f842f9f8377232ba","type":"function","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"Simple triggered queue","func":"var check_status = flow.get(\"check_status\")\nif (check_status == true) {\n\n    msg.host = flow.get(\"host\");\n    msg.port = flow.get(\"port\");\n    // const haCtx = global.get(\"homeassistant\");\n    // const configCtx = haCtx.homeAssistant;\n    // const entityState = configCtx.states[\"switch.central_amt_requisicao_de_status\"];\n    // msg.entityState = entityState.state;\n\n    //if (entityState.state == \"on\") {\n\n    context.comando = context.comando || false;\n    if (msg.reset == true) {\n        context.busy = false;\n    }\n    if ((msg.payload[0] == 0x0a && msg.payload[9] == 0x5a || msg.payload[9] == 0x5b || msg.payload[9] == 0x5d)\n        ||\n        (msg.payload[0] == 0x08 && msg.payload[7] == 0x5a || msg.payload[7] == 0x5b || msg.payload[7] == 0x5d)) {\n        //recebendo status\n        //msg.teste = \"status\"\n        context.comando = false;\n\n    } else {\n        //recebendo comando\n        //msg.teste = \"comando\"\n        context.comando = true;\n\n    }\n    //return msg;\n\n    // if queue doesn't exist, create it\n    context.queue = context.queue || [];\n    context.busy = context.busy || false;\n\n    // if the msg is a trigger one release next message\n    if (msg.hasOwnProperty(\"trigger\")) {\n        if (context.queue.length > 0) {\n            var m = context.queue.shift();\n            var h = context.queue.shift();\n            var p = context.queue.shift();\n            var b = context.queue.shift();\n            var t = context.queue.shift();\n            return { payload: m, host: h, port: p, button_press: b, time: t };\n\n        }\n        else {\n            context.busy = false;\n        }\n    }\n    else {\n        if (context.busy) {\n            // if busy add to queue\n            if (context.comando) {\n                // if command add to queue\n\n                context.queue.push(msg.payload, msg.host, msg.port, msg.button_press, msg.time);\n\n            }\n        }\n        else {\n            // otherwise we are empty so just pass through and set busy flag\n            if (context.comando == false) {\n                // if (entityState.state == \"on\") {// && check_status == 1) {\n\n                    context.busy = true;\n                    return msg;\n                // }\n            } else {\n\n                context.busy = true;\n                return msg;\n\n            }\n        }\n\n        return null;\n    }\n}","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":550,"y":940,"wires":[["ff4e1652c55373ea","1cc90c4a73eb67eb"]]},{"id":"544a9c9243472749","type":"function","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"set trigger","func":"// handle the return from the exec in here \n// if all is good then set msg.trigger property to exist\nmsg.trigger = 1;\nreturn msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":540,"y":880,"wires":[["f842f9f8377232ba","df9b92fa7844ea45"]]},{"id":"6f42836cdcdb7232","type":"catch","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"","scope":["ff4e1652c55373ea"],"uncaught":false,"x":130,"y":760,"wires":[["f8f7177c0bf52324","06cc6b4a1881245b"]]},{"id":"df9b92fa7844ea45","type":"trigger","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"Watchdog 2000ms","op1":"","op2":"reset","op1type":"nul","op2type":"str","duration":"2000","extend":true,"overrideDelay":false,"units":"ms","reset":"","bytopic":"all","topic":"topic","outputs":2,"x":550,"y":820,"wires":[[],["f8f7177c0bf52324"]]},{"id":"3ab4a7998ba214ce","type":"catch","z":"77ee9ef7029ba7e3","g":"a73e0c81643c3080","name":"","scope":["2fcebe01bab68902"],"uncaught":false,"x":110,"y":360,"wires":[["d2d66e270330801c"]]},{"id":"b6e6caa2a1c88223","type":"change","z":"77ee9ef7029ba7e3","g":"83cf8e04366e5d93","name":"SENHAS e IP da central!!!!","rules":[{"t":"set","p":"senha","pt":"msg","to":"0001","tot":"str"},{"t":"set","p":"senha_a","pt":"msg","to":"0002","tot":"str"},{"t":"set","p":"senha_b","pt":"msg","to":"0003","tot":"str"},{"t":"set","p":"senha_c","pt":"msg","to":"0004","tot":"str"},{"t":"set","p":"senha_d","pt":"msg","to":"123456","tot":"str"},{"t":"set","p":"host","pt":"msg","to":"192.168.0.11","tot":"str"},{"t":"set","p":"port","pt":"msg","to":"9009","tot":"num"},{"t":"set","p":"check_status","pt":"flow","to":"false","tot":"bool"},{"t":"set","p":"time","pt":"msg","to":"$moment(time).tz(\"America/Sao_Paulo\").format('D MMM HH:mm:ss - ') ","tot":"jsonata"}],"action":"","property":"","from":"","to":"","reg":false,"x":220,"y":140,"wires":[["6f64d7fcaa8c71d2"]]},{"id":"afb14dcf7466d645","type":"delay","z":"77ee9ef7029ba7e3","g":"a73e0c81643c3080","name":"","pauseType":"delay","timeout":"30","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"allowrate":false,"outputs":1,"x":120,"y":240,"wires":[["b6e6caa2a1c88223"]]},{"id":"d013217c5f70e078","type":"function","z":"77ee9ef7029ba7e3","g":"a73e0c81643c3080","name":"function 44","func":"console.log(msg.time + \"[AMT] Sem conexão com a central. Nova tentativa em 30 segundos.\");\n\nreturn msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":130,"y":280,"wires":[["afb14dcf7466d645"]]},{"id":"d2d66e270330801c","type":"change","z":"77ee9ef7029ba7e3","g":"a73e0c81643c3080","name":"","rules":[{"t":"set","p":"time","pt":"msg","to":"$moment(time).tz(\\\"America/Sao_Paulo\\\").format('D MMM HH:mm:ss - ') ","tot":"jsonata"}],"action":"","property":"","from":"","to":"","reg":false,"x":130,"y":320,"wires":[["d013217c5f70e078"]]},{"id":"1652de67da0937dd","type":"debug","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"Status","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":150,"y":1000,"wires":[]},{"id":"06cc6b4a1881245b","type":"debug","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"Catch TCP Status","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":190,"y":840,"wires":[]},{"id":"91e2108ba718830d","type":"trigger","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"Watchdog 2000ms","op1":"","op2":"reset","op1type":"nul","op2type":"str","duration":"3000","extend":true,"overrideDelay":false,"units":"ms","reset":"","bytopic":"all","topic":"topic","outputs":2,"x":290,"y":1080,"wires":[["d7d837f4ab074b3f"],["5aeb728524239bab","9597ea345e1e0451"]]},{"id":"5aeb728524239bab","type":"change","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"","rules":[{"t":"set","p":"host","pt":"msg","to":"host","tot":"flow"},{"t":"set","p":"port","pt":"msg","to":"9015","tot":"num"}],"action":"","property":"","from":"","to":"","reg":false,"x":500,"y":1080,"wires":[["f82c9909848e1652","91e2108ba718830d","468b34de9a319960"]]},{"id":"f82c9909848e1652","type":"debug","z":"77ee9ef7029ba7e3","g":"9028c6beb21cbfda","name":"debug 97","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":720,"y":1140,"wires":[]},{"id":"a3ee75c7d74428ba","type":"link in","z":"77ee9ef7029ba7e3","g":"86569d2d471da717","name":"TCP REQUEST","links":["7992f49608eba2a1","436cf32ac884b59d"],"x":545,"y":2240,"wires":[["8bc5fcbfda1ce4ce"]]},{"id":"eb3eaed97bfda623","type":"inject","z":"77ee9ef7029ba7e3","name":"Start","props":[],"repeat":"","crontab":"","once":true,"onceDelay":"3","topic":"","x":110,"y":500,"wires":[["d11e7509e77efea2"]]},{"id":"d11e7509e77efea2","type":"function","z":"77ee9ef7029ba7e3","name":"HA Conectado?","func":"if (global.get(\"homeassistant.homeAssistant.isConnected\") == true) {\n    msg.ha_connected = true;\n    flow.set(\"ha_connected\", true)\n    return [msg, null];\n} else {\n\n    flow.set(\"ha_connected\", false)\n    msg.ha_connected = false;\n    return [null, msg];\n\n}\n\n","outputs":2,"noerr":0,"initialize":"","finalize":"","libs":[],"x":280,"y":500,"wires":[["d412b9313a1cab19","c0afc8b0f7e5ba7b"],["b4963b3473bada29"]]},{"id":"b4963b3473bada29","type":"delay","z":"77ee9ef7029ba7e3","name":"Aguardando Conexão com HA","pauseType":"delay","timeout":"500","timeoutUnits":"milliseconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"allowrate":false,"outputs":1,"x":190,"y":560,"wires":[["d11e7509e77efea2"]]},{"id":"d412b9313a1cab19","type":"delay","z":"77ee9ef7029ba7e3","name":"Conectado ao HA","pauseType":"delay","timeout":"4","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"allowrate":false,"outputs":1,"x":150,"y":440,"wires":[["3ea73c089db934a1","b6e6caa2a1c88223","2c6a24fb28cf02c4"]]},{"id":"2c6a24fb28cf02c4","type":"debug","z":"77ee9ef7029ba7e3","name":"Conectado ao HA","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":410,"y":400,"wires":[]},{"id":"31cfedc7055e3aa9","type":"ha-sensor","z":"77ee9ef7029ba7e3","g":"4781abea0e422d71","name":"Central AMT - Partições Ativadas","entityConfig":"c9a5b62b8acde6a5","version":0,"state":"particoes_ativadas","stateType":"msg","attributes":[{"property":"Partições Ativadas","value":"particoes_ativadas_count","valueType":"msg"}],"inputOverride":"allow","outputProperties":[],"x":2890,"y":460,"wires":[[]]},{"id":"59ddf272b4b5fd87","type":"link in","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Anular Zonas","links":["269f05a2d7accf69"],"x":645,"y":540,"wires":[["93e1b91af8f7c0d6"]]},{"id":"140752d3bb2f256a","type":"debug","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Comandos","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1472.500015258789,"y":536.249997138977,"wires":[]},{"id":"2f096f199d3d7063","type":"tcp request","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Conexção TCP","server":"","port":"","out":"time","ret":"buffer","splitc":"50","newline":"","trim":false,"tls":"","x":1302.500015258789,"y":296.24999713897705,"wires":[["b39d7af64f35ef92","369645614049f074","7c4b18c734a6e286"]]},{"id":"7c4b18c734a6e286","type":"function","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Verificação de Comando Status","func":"if (msg.payload[2] == 0xE5) {\n\n    console.log(msg.time + \"[AMT] Comando \" + msg.comando + \": Descontinuado.\");\n\n} else if (msg.payload[0] > 0x04) {\n\n    console.log(msg.time + \"[AMT] Comando \" + msg.comando + \": Status OK\");\n\n    if (msg.payload[0] == 0x37) {\n        if (msg.payload[25 + 1] == 0x41) {\n            msg.model = \"AMT 4010 SMART\"\n        } else {\n            msg.model = \"Desconhecido\"\n        }\n\n    } else if (msg.payload[0] == 0x2c) {\n        if (msg.payload[19 + 1] == 0x1E) {\n            msg.model = \"AMT 2018 E/EG\"\n        } else if (msg.payload[19 + 1] == 0x34) {\n            msg.model = \"AMT 2018 E SMART\"\n        } else if (msg.payload[19 + 1] == 0x61) {\n            msg.model = \"AMT 1016 NET\"\n        } else if (msg.payload[19 + 1] == 0x24) {\n            msg.model = \"AMN 24 NET\"\n        } else {\n            msg.model = \"Desconhecido\"\n        }\n\n    } else if (msg.payload[0] == 0x5e) {\n        if (msg.payload[19 + 1] == 0x34) {\n            msg.model = \"AMT 2018 E SMART (beta)\"\n        } else {\n            msg.model = \"Desconhecido\"\n        }\n    } else {\n        msg.model = \"Desconhecido\"\n    }\n\n    msg.payload = msg.temp_status;\n\n    flow.set(\"comando_status\", msg.temp_status);\n\n    return msg;\n\n} else if (msg.payload[2] == 0xE1) {\n\n    console.log(msg.time + \"[AMT] Senha incorreta.\" + '\\r\\n' + \"Verique a senha inserida ou se o tamanho da senha inserida\" + '\\r\\n' + \"é igual ao tamanho de senha configurado na central\");\n\n} else if (msg.payload[2] == 0xE2) {\n\n    if (msg.temp_status[0] == 0x0a) {\n\n        console.log(msg.time + \"[AMT] Comando \" + msg.comando + \": Inválido.\");\n\n    } else {\n\n        console.log(msg.time + \"[AMT] Comando \" + msg.comando + \": Senha incorreta.\" + '\\r\\n' + \"Verique a senha inserida ou se o tamanho da senha inserida\" + '\\r\\n' + \"é igual ao tamanho de senha configurado na central\");\n\n    }\n} else {\n\n    var buffer = Buffer.from(msg.payload);\n    for (var i = 0; i < buffer.length; i++) {\n        if (i == 0) {\n            msg.teste = buffer[i].toString(16);\n        } else {\n            msg.teste = msg.teste + \" \" + buffer[i].toString(16);\n        }\n    }\n    msg.payload = msg.teste;//.toString('16');\n\n    console.log(msg.time + \"[AMT] Erro: \\\"\" + msg.payload + \"\\\" Desconhecido\");\n\n}\n\n","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":772.5000152587891,"y":416.24999713897705,"wires":[["140752d3bb2f256a","8686297a1c9987e5","307468df19674766"]],"outputLabels":["Verificação de Comando Status"]},{"id":"6f64d7fcaa8c71d2","type":"function","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Comandos","func":"//flow.set(\"hold_status\", undefined);\n//flow.set(\"stop\", undefined);\n//flow.set(\"senha\", msg.senha);\n\nlet myFunc = num => Number(num);\n\nmsg.senha = Array.from(String(msg.senha), myFunc);\nmsg.senha_a = Array.from(String(msg.senha_a), myFunc);\nmsg.senha_b = Array.from(String(msg.senha_b), myFunc);\nmsg.senha_c = Array.from(String(msg.senha_c), myFunc);\nmsg.senha_d = Array.from(String(msg.senha_d), myFunc);\n\nvar check_sum = 0;\nvar i;\nfor (i = 0; i < msg.senha.length; i++) { msg.senha[i] = msg.senha[i] + 0x30; }\nfor (i = 0; i < msg.senha_a.length; i++) { msg.senha_a[i] = msg.senha_a[i] + 0x30; }\nfor (i = 0; i < msg.senha_b.length; i++) { msg.senha_b[i] = msg.senha_b[i] + 0x30; }\nfor (i = 0; i < msg.senha_c.length; i++) { msg.senha_c[i] = msg.senha_c[i] + 0x30; }\nfor (i = 0; i < msg.senha_d.length; i++) { msg.senha_d[i] = msg.senha_d[i] + 0x30; }\n\nmsg.senha = Buffer.from(msg.senha);\nmsg.senha_a = Buffer.from(msg.senha_a);\nmsg.senha_b = Buffer.from(msg.senha_b);\nmsg.senha_c = Buffer.from(msg.senha_c);\nmsg.senha_d = Buffer.from(msg.senha_d);\n\nflow.set(\"senha\", msg.senha);\n\nvar start = Buffer.from([0x00, 0xe9, 0x21]);\nvar end = Buffer.from([0x21, 0xff]);\nvar comando_stay = Buffer.from([0x41, 0x50]);\nvar comando_stay_a = Buffer.from([0x41, 0x41, 0x50]);\nvar comando_stay_b = Buffer.from([0x41, 0x42, 0x50]);\nvar comando_stay_c = Buffer.from([0x41, 0x43, 0x50]);\nvar comando_stay_d = Buffer.from([0x41, 0x44, 0x50]);\nvar comando_ativar = Buffer.from([0x41]);\nvar comando_desativar = Buffer.from([0x44]);\nvar comando_ativar_a = Buffer.from([0x41, 0x41]);\nvar comando_desativar_a = Buffer.from([0x44, 0x41]);\nvar comando_ativar_b = Buffer.from([0x41, 0x42]);\nvar comando_desativar_b = Buffer.from([0x44, 0x42]);\nvar comando_ativar_c = Buffer.from([0x41, 0x43]);\nvar comando_desativar_c = Buffer.from([0x44, 0x43]);\nvar comando_ativar_d = Buffer.from([0x41, 0x44]);\nvar comando_desativar_d = Buffer.from([0x44, 0x44]);\nvar comando_pgm_1 = Buffer.from([0x50, 0x4c, 0x31]);\nvar comando_pgm_2 = Buffer.from([0x50, 0x4c, 0x32]);\nvar comando_pgm_3 = Buffer.from([0x50, 0x4c, 0x33]);\nvar comando_liga_sirene = Buffer.from([0x43]);\nvar comando_desliga_sirene = Buffer.from([0x63]);\nvar comando_status_0 = Buffer.from([0x5a]);\nvar comando_status_1 = Buffer.from([0x5b]);\nvar comando_status_2 = Buffer.from([0x5d]);\nvar comando_pgm_1_des = Buffer.from([0x50, 0x44, 0x31]);\nvar comando_pgm_2_des = Buffer.from([0x50, 0x44, 0x32]);\nvar comando_pgm_3_des = Buffer.from([0x50, 0x44, 0x33]);\n\n\n\ni = 0;\n\nconst comandos_nomes = [\"comando_stay_a\",\n    \"comando_ativar_a\",\n    \"comando_desativar_a\",\n    \"comando_stay_b\",\n    \"comando_ativar_b\",\n    \"comando_desativar_b\",\n    \"comando_stay_c\",\n    \"comando_ativar_c\",\n    \"comando_desativar_c\",\n    \"comando_stay_d\",\n    \"comando_ativar_d\",\n    \"comando_desativar_d\",\n    \"comando_stay\",\n    \"comando_ativar\",\n    \"comando_desativar\",\n    \"comando_pgm_1\",\n    \"comando_pgm_2\",\n    \"comando_pgm_3\",\n    \"comando_liga_sirene\",\n    \"comando_desliga_sirene\",\n    \"comando_status_0\",\n    \"comando_status_1\",\n    \"comando_status_2\",\n    \"comando_pgm_1_des\",\n    \"comando_pgm_2_des\",\n    \"comando_pgm_3_des\"];\n\nvar comandos = [comando_stay_a,\n    comando_ativar_a,\n    comando_desativar_a,\n    comando_stay_b,\n    comando_ativar_b,\n    comando_desativar_b,\n    comando_stay_c,\n    comando_ativar_c,\n    comando_desativar_c,\n    comando_stay_d,\n    comando_ativar_d,\n    comando_desativar_d,\n    comando_stay,\n    comando_ativar,\n    comando_desativar,\n    comando_pgm_1,\n    comando_pgm_2,\n    comando_pgm_3,\n    comando_liga_sirene,\n    comando_desliga_sirene,\n    comando_status_0,\n    comando_status_1,\n    comando_status_2,\n    comando_pgm_1_des,\n    comando_pgm_2_des,\n    comando_pgm_3_des];\n\n\nvar full_comandos = [];\nfor (var j = 0; j < comandos.length; j++) {\n    if (j <= 2) {\n        full_comandos[j] = [start, msg.senha_a, comandos[j], end]\n    } else if ((j >= 3) && (j <= 5)) {\n        full_comandos[j] = [start, msg.senha_b, comandos[j], end]\n    } else if ((j >= 6) && (j <= 8)) {\n        full_comandos[j] = [start, msg.senha_c, comandos[j], end]\n    } else if ((j >= 9) && (j <= 11)) {\n        full_comandos[j] = [start, msg.senha_d, comandos[j], end]\n    } else \t/*( j >= 12)*/ {\n        full_comandos[j] = [start, msg.senha, comandos[j], end]\n    }\n};\n\nvar buffer_full_comandos = [];\nfor (var g = 0; g < full_comandos.length; g++) {\n\n    buffer_full_comandos[g] = Buffer.concat(full_comandos[g]);\n\n};\n\n\nvar nb_buffer_full_comandos = [];\nfor (var z = 0; z < buffer_full_comandos.length; z++) {\n\n    nb_buffer_full_comandos[z] = (buffer_full_comandos[z].length - 2);\n    buffer_full_comandos[z][0] = nb_buffer_full_comandos[z];\n};\nnb_buffer_full_comandos = 0;\n//msg.nbtemp = nb_buffer_full_comandos;//apagar\n\nvar sum_buffer_full_comandos = [];\nfor (var r = 0; r < buffer_full_comandos.length; r++) {\n\n    for (var s = 0; s < buffer_full_comandos[r].length; s++) { sum_buffer_full_comandos[r] = sum_buffer_full_comandos[r] ^ buffer_full_comandos[r][s] }\n\n    buffer_full_comandos[r][buffer_full_comandos[r].length - 1] = sum_buffer_full_comandos[r];\n};\n\nfor (var d = 0; d < buffer_full_comandos.length; d++) {\n\n    flow.set(comandos_nomes[d], buffer_full_comandos[d]);\n}\n/*\nfor (var d = 0; d < buffer_full_comandos.length; d++) {\n\n    flow.set(\"comando_final\" + [d], buffer_full_comandos[d]);\n\n}\n*/\nflow.set(\"host\", msg.host);\nflow.set(\"port\", msg.port);\n\nmsg.payload = buffer_full_comandos[20];\n//msg.temp_status = buffer_full_comandos[20];\n\n//msg.teste123 = comandos_nomes;\n//console.log(msg.time + \"[AMT] Testando Comando Status...\");\n/*\nfor (i = 20; i < 23; i++) {\n\n    msg.temp_status[i] = buffer_full_comandos[i];\n    \n    //node.send(msg);\n\n}*/\nreturn msg;\n\n\n","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":682.5000152587891,"y":156.24999713897705,"wires":[["d35b334be5c7c047","ebf8c933a7256c9b"]],"outputLabels":["Comandos"]},{"id":"93e1b91af8f7c0d6","type":"function","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Comandos Anular","func":"if (Buffer.isBuffer(msg.payload)) {\nmsg.senha = flow.get(\"senha\");\nvar i;\n// Hex para comandos anular zonas abertas\nif (msg.payload[0] == 0x2C) {\n    var anular_abertas = Buffer.alloc(6);\n    for (i = 0; i < anular_abertas.length; i++) {\n        anular_abertas[i] = msg.payload[1 + 1 + i];\n    };\n} else if (msg.payload[0] == 0x37) {\n    var anular_abertas = Buffer.alloc(8);\n    for (i = 0; i < anular_abertas.length; i++) {\n        anular_abertas[i] = msg.payload[1 + 1 + i];\n    };\n}\n\n// Hex para comandos anular zonas disparadas\nif (msg.payload[0] == 0x2C) {\n    var anular_disparadas = Buffer.alloc(6);\n    for (i = 0; i < anular_disparadas.length; i++) {\n        anular_disparadas[i] = msg.payload[1 + 7 + i];\n    };\n} else if (msg.payload[0] == 0x37) {\n    var anular_disparadas = Buffer.alloc(8);\n    for (i = 0; i < anular_disparadas.length; i++) {\n        anular_disparadas[i] = msg.payload[1 + 9 + i];\n    };\n}\n\n// Hex para comandos anular zonas abertas e disparadas\nif (msg.payload[0] == 0x2C) {\n    var anular_ab_disp = Buffer.alloc(8);\n    for (i = 0; i < anular_ab_disp.length; i++) {\n        anular_ab_disp[i] = msg.payload[1 + 1 + i] | msg.payload[1 + 7 + i];\n    };\n\n} else if (msg.payload[0] == 0x37) {\n    var anular_ab_disp = Buffer.alloc(8);\n    for (i = 0; i < anular_ab_disp.length; i++) {\n        anular_ab_disp[i] = msg.payload[1 + 1 + i] | msg.payload[1 + 9 + i];\n    };\n}\nflow.set(\"senha\", msg.senha);\n\nvar check_sum = 0;\nvar start = Buffer.from([0x00, 0xe9, 0x21]);\nvar end = Buffer.from([0x21, 0xff]);\nvar comando_anular = Buffer.from([0x42]);\n\ni = 0;\n// Quantidade de comandos a serem gerados\nvar zonas_anular = [anular_abertas,\n    anular_disparadas,\n    anular_ab_disp\n];\n\n// Juntar os comandos\nvar full_comandos = [];\nfor (var j = 0; j < zonas_anular.length; j++) {\n    full_comandos[j] = [start, msg.senha, comando_anular, zonas_anular[j], end]\n};\n\n// Gerando Buffer dos comandos gerados\nvar buffer_full_comandos = [];\nfor (var g = 0; g < full_comandos.length; g++) {\n    buffer_full_comandos[g] = Buffer.concat(full_comandos[g]);\n};\n\n// Calcular o tamanho do comando\nvar nb_buffer_full_comandos = []\nfor (var z = 0; z < zonas_anular.length; z++) {\n    nb_buffer_full_comandos[z] = Buffer.from([0x00]);\n};\n\nfor (var z = 0; z < buffer_full_comandos.length; z++) {\n    nb_buffer_full_comandos[z] = (buffer_full_comandos[z].length - 2);\n    buffer_full_comandos[z][0] = nb_buffer_full_comandos[z];\n};\n\n// Gerar Checksum\nvar sum_buffer_full_comandos = [];\nfor (var r = 0; r < buffer_full_comandos.length; r++) {\n    for (var s = 0; s < buffer_full_comandos[r].length; s++) { sum_buffer_full_comandos[r] = sum_buffer_full_comandos[r] ^ buffer_full_comandos[r][s] }\n    buffer_full_comandos[r][buffer_full_comandos[r].length - 1] = sum_buffer_full_comandos[r];\n};\n\nfor (var d = 0; d < buffer_full_comandos.length; d++) {\n    flow.set(\"zonas_anular\" + [d], buffer_full_comandos[d]);\n}\nmsg.payload = buffer_full_comandos;\n\nreturn msg;\n}","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":790,"y":540,"wires":[["11ea034183e9c1d8"]]},{"id":"11ea034183e9c1d8","type":"debug","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Comandos Anular","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1030,"y":540,"wires":[]},{"id":"8686297a1c9987e5","type":"file","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Salvar comandos em arquivo","filename":"/config/node-red/amt_comandos.txt","filenameType":"str","appendNewline":false,"createDir":true,"overwriteFile":"true","encoding":"none","x":1042.500015258789,"y":476.24999713897705,"wires":[["fbcaca5c046cad22"]]},{"id":"fbcaca5c046cad22","type":"debug","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Salvar comandos em arquivo","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1322.500015258789,"y":476.24999713897705,"wires":[]},{"id":"ebf8c933a7256c9b","type":"exec","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","command":"ls /config/node-red/amt_comandos.txt","addpay":"","append":"","useSpawn":"false","timer":"","winHide":false,"oldrc":false,"name":"Verficar arquivo comandos","x":912.5000152587891,"y":156.24999713897705,"wires":[[],[],["0c8b7b417161b060","6cc6950599b9342c"]],"outputLabels":["","","Verficar arquivo comandos"]},{"id":"0c8b7b417161b060","type":"switch","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"","property":"payload.code","propertyType":"msg","rules":[{"t":"eq","v":"0","vt":"num"},{"t":"eq","v":"1","vt":"num"}],"checkall":"true","repair":false,"outputs":2,"x":662.5000152587891,"y":256.24999713897705,"wires":[["6dabe613fd9fae7c"],["9a17b8222d6c21c3"]]},{"id":"1810b0322bf21322","type":"debug","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Restaurar comando","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1490,"y":240,"wires":[]},{"id":"6dabe613fd9fae7c","type":"file in","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Ler arquivo comandos","filename":"/config/node-red/amt_comandos.txt","filenameType":"str","format":"","chunk":false,"sendError":false,"encoding":"none","allProps":false,"x":852.5000152587891,"y":236.24999713897705,"wires":[["0a3a270a6f687fb0"]]},{"id":"03b31abca97380dc","type":"function","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Restaurar comando","func":"console.log(msg.time + \"[AMT] Recuperando Comando Status...\");\nconsole.log(msg.time + \"[AMT] Caso tenha alterado a senha, apague o arquivo \" + \"\\\\\" + \"config\" + \"\\\\\" + \"node-red\" + \"\\\\\" + \"amt_comandos.txt e reinicie o flow\");\nflow.set(\"comando_status\", Buffer.from(msg.payload));\n\nif (msg.requisicao == \"on\"){\nflow.set(\"check_status\", true);\nmsg.teste = true;\n} else {\nflow.set(\"check_status\", false);\nmsg.teste = false;\n\n}\n\n// if (global.get('homeassistant.homeAssistant.states[\"switch.central_amt_requisicao_de_status\"].state') == 'on'){\n// flow.set(\"check_status\", true);\n// msg.teste = true;\n// } else {\n// flow.set(\"check_status\", false);\n// msg.teste = false;\n\n// }\n\nreturn msg;\n\n\n","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1290,"y":240,"wires":[["1810b0322bf21322","cc3a37142b2a86b9","11ee7cf9370bb8a1"]]},{"id":"9a17b8222d6c21c3","type":"function","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"function 45","func":"if (msg.payload != \"\" ){\n    // flow.set(\"check_status\",0);\n    console.log(msg.time + \"[AMT] Testando Comando Status. Caso nenhum comando funcione, verifique senha, IP e compatibilidade da central.\");\n\n    for (var i = 0; i < 3; i++) {\n\n        msg.payload = flow.get(\"comando_status_\" + [i]);\n        msg.temp_status = flow.get(\"comando_status_\" + [i]);\n        msg.comando = i + 1;\n        node.send(msg);\n        \n    }\n\n}\n\n","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":832.5000152587891,"y":296.24999713897705,"wires":[["f8e9a35cfc7d1657"]]},{"id":"d35b334be5c7c047","type":"debug","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Comandos","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":862.5000152587891,"y":96.24999713897705,"wires":[]},{"id":"6cc6950599b9342c","type":"debug","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Verficar arquivo comandos","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1342.500015258789,"y":156.24999713897705,"wires":[]},{"id":"b39d7af64f35ef92","type":"debug","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"debug 3","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1482.500015258789,"y":296.24999713897705,"wires":[]},{"id":"f8e9a35cfc7d1657","type":"function","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Simple triggered queue (status)","func":"// if queue doesn't exist, create it\ncontext.queue = context.queue || [];\ncontext.busy = context.busy || false;\n\n// if the msg is a trigger one release next message\nif (msg.hasOwnProperty(\"trigger\")) {\n    if (context.queue.length > 0) {\n        var m = context.queue.shift();\n        var h = context.queue.shift();\n        var p = context.queue.shift();\n        var t = context.queue.shift();\n        var temp = context.queue.shift();\n        var c = context.queue.shift();\n        return { payload: m, host: h, port: p, time: t, temp_status: temp, comando: c };\n\n        // return {payload:m};\n    }\n    else {\n        context.busy = false;\n    }\n}\nelse {\n    if (context.busy) {\n        // if busy add to queue\n        // context.queue.push(msg.payload, msg.host, msg.port, msg.time);\n        context.queue.push(msg.payload, msg.host, msg.port, msg.time, msg.temp_status, msg.comando);\n\n    }\n    else {\n        // otherwise we are empty so just pass through and set busy flag\n        context.busy = true;\n        return msg;\n    }\n}\n\nreturn null;\n","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1072.500015258789,"y":296.24999713897705,"wires":[["2f096f199d3d7063"]]},{"id":"369645614049f074","type":"function","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"set trigger","func":"// handle the return from the exec in here \n// if all is good then set msg.trigger property to exist\nmsg.trigger = 1;\nreturn msg;","outputs":1,"noerr":0,"x":1062.500015258789,"y":356.24999713897705,"wires":[["f8e9a35cfc7d1657"]]},{"id":"307468df19674766","type":"delay","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"Primeira execusão","pauseType":"delay","timeout":"5","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"allowrate":false,"outputs":1,"x":1022.5000152587891,"y":416.24999713897705,"wires":[["0c1e84b3f17ed0db"]]},{"id":"0c1e84b3f17ed0db","type":"function","z":"77ee9ef7029ba7e3","g":"1c35b0bbbf5ab9e3","name":"","func":"flow.set(\"check_status\", true);\nconsole.log(msg.time + \"[AMT] Modelo da Central: \" + msg.model);\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1192.500015258789,"y":416.24999713897705,"wires":[["cc3a37142b2a86b9","11ee7cf9370bb8a1"]]},{"id":"c4a2259a1f386d70","type":"switch","z":"77ee9ef7029ba7e3","g":"94736602a22b03aa","name":"","property":"check_status","propertyType":"flow","rules":[{"t":"true"}],"checkall":"true","repair":false,"outputs":1,"x":1470,"y":1220,"wires":[[]]},{"id":"c0afc8b0f7e5ba7b","type":"debug","z":"77ee9ef7029ba7e3","name":"debug 107","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":490,"y":500,"wires":[]},{"id":"e97975be16c10056","type":"function","z":"77ee9ef7029ba7e3","g":"ebbe97f61bac706b","name":"Status Switch","func":"// Array para armazenar os valores a serem enviados\nvar valuesToSend = [];\n\n// Defina as chaves de interesse em um array\nvar keys = [\n    'activated',\n    'partition_a',\n    'partition_b',\n    'partition_c',\n    'partition_d',\n    'pgm_1',\n    'pgm_2',\n    'pgm_3',\n    'ss'];\n\n// Verifique cada chave e, se estiver definida, adicione o valor ao array valuesToSend\nfor (var i = 0; i < keys.length; i++) {\n    var key = keys[i];\n    if (msg[key] !== undefined) {\n        msg.enable = msg[key];\n        var messageCopy = Object.assign({}, msg); // Copie a mensagem original para evitar efeitos colaterais\n        valuesToSend.push(messageCopy);\n    }\n}\n\n// Envie o array de mensagens\nnode.send(valuesToSend);\n","outputs":9,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":960,"y":2020,"wires":[["6dd8ae8e7c573e04"],["ca9c1af2a05977ad"],["ac99420c01cf99ec"],["5d76d06be49622ae"],["bcd50f2782a24f9b"],["3c8df6accc3d0c1e"],["ea51267b0249e165"],["013db42bdde02bb5"],["fa8e134516091440"]]},{"id":"b646d2e9d6620898","type":"function","z":"77ee9ef7029ba7e3","g":"ebbe97f61bac706b","name":"function 51","func":"// Mapeamento entre msg.outputType e valores específicos\nvar mapping = {\n    \"central\": {\n        true: {\n            payload: flow.get(\"comando_ativar\"),\n            button_press: \"Ativar AMT\"\n        },\n        false: {\n            payload: flow.get(\"comando_desativar\"),\n            button_press: \"Desativar AMT\"\n        }\n    },\n    \"part_a\": {\n        true: {\n            payload: flow.get(\"comando_ativar_a\"),\n            button_press: \"Ativar Partição A\"\n        },\n        false: {\n            payload: flow.get(\"comando_desativar_a\"),\n            button_press: \"Desativar Partição A\"\n        }\n    },\n    \"part_b\": {\n        true: {\n            payload: flow.get(\"comando_ativar_b\"),\n            button_press: \"Ativar Partição B\"\n        },\n        false: {\n            payload: flow.get(\"comando_desativar_b\"),\n            button_press: \"Desativar Partição B\"\n        }\n    },\n    \"part_c\": {\n        true: {\n            payload: flow.get(\"comando_ativar_c\"),\n            button_press: \"Ativar Partição C\"\n        },\n        false: {\n            payload: flow.get(\"comando_desativar_c\"),\n            button_press: \"Desativar Partição C\"\n        }\n    },\n    \"part_d\": {\n        true: {\n            payload: flow.get(\"comando_ativar_d\"),\n            button_press: \"Ativar Partição D\"\n        },\n        false: {\n            payload: flow.get(\"comando_desativar_d\"),\n            button_press: \"Desativar Partição D\"\n        }\n    },\n    \"pgm_1\": {\n        true: {\n            payload: flow.get(\"comando_pgm_1\"),\n            button_press: \"Ativar PGM 1\"\n        },\n        false: {\n            payload: flow.get(\"comando_pgm_1_des\"),\n            button_press: \"Desativar PGM 1\"\n        }\n    },\n    \"pgm_2\": {\n        true: {\n            payload: flow.get(\"comando_pgm_2\"),\n            button_press: \"Ativar PGM 2\"\n        },\n        false: {\n            payload: flow.get(\"comando_pgm_2_des\"),\n            button_press: \"Desativar PGM 2\"\n        }\n    },\n    \"pgm_3\": {\n        true: {\n            payload: flow.get(\"comando_pgm_3\"),\n            button_press: \"Ativar PGM 3\"\n        },\n        false: {\n            payload: flow.get(\"comando_pgm_3_des\"),\n            button_press: \"Desativar PGM 3\"\n        }\n    },\n    \"sirene\": {\n        true: {\n            payload: flow.get(\"comando_liga_sirene\"),\n            button_press: \"Ligar Sirene\"\n        },\n        false: {\n            payload: flow.get(\"comando_desliga_sirene\"),\n            button_press: \"Desligar Sirene\"\n        }\n    },\n};\n\n// Verifique se msg.outputType está no mapeamento\nif (msg.outputType in mapping) {\n    var outputTypeMapping = mapping[msg.outputType];\n    var payloadMapping = msg.payload ? outputTypeMapping.true : outputTypeMapping.false;\n\n    // Configurar msg.payload e msg.button_press usando o mapeamento\n    msg.payload = payloadMapping.payload;\n    msg.button_press = payloadMapping.button_press;\n\n    // Envie a mensagem\n    return msg;\n} else {\n    // Caso msg.outputType não esteja no mapeamento, você pode tomar outra ação ou simplesmente passar adiante\n    return null;\n}\n","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":1450,"y":2040,"wires":[["436cf32ac884b59d"]]},{"id":"ca9c1af2a05977ad","type":"ha-switch","z":"77ee9ef7029ba7e3","g":"ebbe97f61bac706b","name":"Central AMT - Partição A","version":0,"debugenabled":false,"inputs":1,"outputs":2,"entityConfig":"25a219f2f045ec35","enableInput":true,"outputOnStateChange":true,"outputProperties":[{"property":"outputType","propertyType":"msg","value":"part_a","valueType":"str"},{"property":"payload","propertyType":"msg","value":"","valueType":"entityState"},{"property":"time","propertyType":"msg","value":"$moment(time).tz(\"America/Sao_Paulo\").format('D MMM HH:mm:ss - ') ","valueType":"jsonata"}],"x":1180,"y":1860,"wires":[["b646d2e9d6620898"],["b646d2e9d6620898"]]},{"id":"ac99420c01cf99ec","type":"ha-switch","z":"77ee9ef7029ba7e3","g":"ebbe97f61bac706b","name":"Central AMT - Partição B","version":0,"debugenabled":false,"inputs":1,"outputs":2,"entityConfig":"3261bd5940e9e5f7","enableInput":true,"outputOnStateChange":true,"outputProperties":[{"property":"outputType","propertyType":"msg","value":"part_b","valueType":"str"},{"property":"payload","propertyType":"msg","value":"","valueType":"entityState"},{"property":"time","propertyType":"msg","value":"$moment(time).tz(\"America/Sao_Paulo\").format('D