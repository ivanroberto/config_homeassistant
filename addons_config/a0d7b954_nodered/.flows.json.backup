0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1920,"y":180,"wires":[["d66ca74d04a69a24"]]},{"id":"d66ca74d04a69a24","type":"ha-api","z":"77ee9ef7029ba7e3","g":"10bf888ba394f543","name":"","server":"33803899.487d48","version":1,"debugenabled":false,"protocol":"websocket","method":"get","path":"","data":"{\"type\": \"config/entity_registry/list\"}","dataType":"jsonata","responseType":"json","outputProperties":[{"property":"payload","propertyType":"msg","value":"","valueType":"results"}],"x":1770,"y":240,"wires":[["b1ae81475e9b5f85"]]},{"id":"b1ae81475e9b5f85","type":"function","z":"77ee9ef7029ba7e3","g":"10bf888ba394f543","name":"Entities Array","func":"// Seus dados de entrada estão em msg.payload e msg.devices\n// var msg.payload = msg.payload;\nvar devicesToFind = msg.devices;\nvar entityIds = [];\n\n// Percorre os objetos dentro de \"payload\" e verifica se o \"device_id\" corresponde a um dos dispositivos em \"devicesToFind\"\nfor (var i = 0; i < msg.payload.length; i++) {\n  var entity = msg.payload[i];\n  if (devicesToFind.includes(entity.device_id)) {\n    entityIds.push(entity.entity_id);\n  }\n}\n\n// Filtra as entidades que não começam com \"button\" ou \"switch\" e não contêm \"central_online\"\nentityIds = entityIds.filter(function(entityId) {\n  return !entityId.startsWith(\"button\") && !entityId.startsWith(\"switch\") && !entityId.includes(\"central_online\");\n});\n\n// Crie um novo objeto msg com o array de entityIds\nmsg.payload = entityIds;\nflow.set(\"entidades_indisponiveis\", entityIds);\n\ndelete msg.devices;\ndelete msg.data;\nreturn msg;\n","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":1910,"y":240,"wires":[["91125e9888a853ae"]]},{"id":"11ee7cf9370bb8a1","type":"ha-api","z":"77ee9ef7029ba7e3","g":"10bf888ba394f543","name":"","server":"33803899.487d48","version":1,"debugenabled":false,"protocol":"websocket","method":"get","path":"","data":"{\"type\": \"config/device_registry/list\"}","dataType":"jsonat