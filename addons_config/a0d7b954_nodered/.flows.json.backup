0468","name":"resolver_config","func":"const map = {\n  global: {\n    ativar: {\n      botao: 'button.central_amt_ativar_amt',\n      trigger_done: 'input_boolean.alarme_geral_ativar',\n      texto_falha: 'Falha ao ativar alarme geral'\n    },\n    desativar: {\n      botao: 'button.central_amt_desativar_amt',\n      trigger_done: 'input_boolean.alarme_geral_desativar',\n      texto_falha: 'Falha ao desativar alarme geral'\n    },\n    controle: 'input_boolean.controla_alarme_geral'\n  },\n  portoes: {\n    ativar: {\n      botao: 'button.central_amt_ativar_particao_a',\n      trigger_done: 'input_boolean.alarme_portoes_ativar',\n      texto_falha: 'Falha ao ativar alarme portões'\n    },\n    desativar: {\n      botao: 'button.central_amt_desativar_particao_a',\n      trigger_done: 'input_boolean.alarme_portoes_desativar',\n      texto_falha: 'Falha ao desativar alarme portões'\n    },\n    controle: 'input_boolean.controla_alarme_portoes'\n  },\n  externo: {\n    ativar: {\n      botao: 'button.central_amt_ativar_particao_b',\n      trigger_done: 'input_boolean.alarme_externo_ativar',\n      texto_falha: 'Falha ao ativar alarme externo'\n    },\n    desativar: {\n      botao: 'button.central_amt_desativar_particao_b',\n      trigger_done: 'input_boolean.alarme_externo_desativar',\n      texto_falha: 'Falha ao desativar alarme externo'\n    },\n    controle: 'input_boolean.controla_alarme_externo'\n  },\n  interno: {\n    ativar: {\n      botao: 'button.central_amt_ativar_particao_c',\n      trigger_done: 'input_boolean.alarme_interno_ativar',\n      texto_falha: 'Falha ao ativar alarme interno'\n    },\n    desativar: {\n      botao: 'button.central_amt_desativar_particao_c',\n      trigger_done: 'input_boolean.alarme_interno_desativar',\n      texto_falha: 'Falha ao desativar alarme interno'\n    },\n    controle: 'input_boolean.controla_alarme_interno'\n  }\n};\n\nconst zona = msg.zona;\nconst acao = msg.acao;\nif (!map[zona] || !map[zona][acao]) return null;\n\nmsg.alarm = {\n  zona,\n  acao,\n  botao: map[zona][acao].botao,\n  trigger_done: map[zona][acao].trigger_done,\n  controle: map[zona].controle,\n  texto_falha: map[zona][acao].texto_falha,\n  timeout_s: 4,\n  max_tentativas: 5,\n  tentativa: msg.alarm?.tentativa || 1,\n  id_execucao: msg.alarm?.id_execucao || `${zona}:${acao}:${Date.now()}`\n};\n\nreturn msg;","outputs":1,"noerr":0,"x":220,"y":480,"wires":[["fa2add7b58d4820a"]]},{"id":"fa2add7b58d4820a","type":"function","z":"09f39342169d0468","name":"acquire_lock","func":"const alarm = msg.alarm;\nconst zona = alarm.zona;\nconst acao = alarm.acao;\n\nlet state = flow.get('alarm_state') || {\n  locks: { global: false, portoes: false, externo: false, interno: false },\n  running: {},\n  pending: {}\n};\n\nfunction anyZoneRunningExceptGlobal() {\n  return state.locks.portoes || state.locks.externo || state.locks.interno;\n}\n\nif (zona === 'global') {\n  if (anyZoneRunningExceptGlobal() || state.locks.global) {\n    state.pending.global = { zona, acao, ts: Date.now() };\n    flow.set('alarm_state', state);\n    return [null, null, msg];\n  }\n  state.locks.global = true;\n  state.running.global = { zona, acao, ts: Date.now(), id_execucao: alarm.id_execucao };\n  flow.set('alarm_state', state);\n  return [msg, null, null];\n}\n\nif (state.locks.global) {\n  state.pending[zona] = { zona, acao, ts: Date.now() };\n  flow.set('alarm_state', state);\n  return [null, null, msg];\n}\n\nif (state.locks[zona]) {\n  const running = state.running[zona];\n  if (running && running.acao === acao) {\n    return [null, msg, null];\n  }\n  state.pending[zona] = { zona, acao, ts: Date.now() };\n  flow.set('alarm_state', state);\n  return [null, null, msg];\n}\n\nstate.locks[zona] = true;\nstate.running[zona] = { zona, acao, ts: Date.now(), id_execucao: alarm.id_execucao };\nflow.set('alarm_state', state);\nreturn [msg, null, null];","outputs":3,"noerr":0,"x":390,"y":480,"wires":[["859b34b438be2169"],["2fe9fd70c952e69f"],["d0a8a8ecc9a2dd5a"]]},{"id":"2fe9fd70c952e69f","type":"debug","z":"09f39342169d0468","name":"Ignorado","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"bool","x":580,"y":440,"wires":[]},{"id":"d0a8a8ecc9a2dd5a","type":"debug","z":"09f39342169d0468","name":"Em fila","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"bool","x":570,"y":520,"wires":[]},{"id":"859b34b438be2169","type":"function","z":"09f39342169d0468","name":"prepare_press","func":"msg.payload = { entity_id: msg.alarm.botao };\nreturn msg;","outputs":1,"noerr":0,"x":590,"y":480,"wires":[["082046f4f66ff6b8"]]},{"id":"082046f4f66ff6b8","type":"api-call-service","z":"09f39342169d0468","name":"button.press","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"button.press","floorId":[],"areaId":[],"deviceId":[],"entityId":[],"labelId":[],"data":"{\"entity_id\": payload.entity_id}","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"button","service":"press","x":770,"y":480,"wires":[["f52e97a788c63a14"]]},{"id":"f52e97a788c63a14","type":"function","z":"09f39342169d0468","name":"route_wait","func":"const z = msg.alarm.zona;\nconst a = msg.alarm.acao;\n\nif (a === 'ativar') {\n  if (z === 'global') return [msg,null,null,null,null,null,null,null];\n  if (z === 'portoes') return [null,msg,null,null,null,null,null,null];\n  if (z === 'externo') return [null,null,msg,null,null,null,null,null];\n  if (z === 'interno') return [null,null,null,msg,null,null,null,null];\n}\n\nif (a === 'desativar') {\n  if (z === 'global') return [null,null,null,null,msg,null,null,null];\n  if (z === 'portoes') return [null,null,null,null,null,msg,null,null];\n  if (z === 'externo') return [null,null,null,null,null,null,msg,null];\n  if (z === 'interno') return [null,null,null,null,null,null,null,msg];\n}\n\nreturn null;","outputs":8,"noerr":0,"x":110,"y"