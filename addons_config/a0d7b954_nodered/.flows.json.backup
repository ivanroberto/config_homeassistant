ffc","type":"function","z":"09f39342169d0468","name":"release_and_drain","func":"const zona = msg.alarm.zona;\nlet state = flow.get('alarm_state') || {\n  locks: { global: false, portoes: false, externo: false, interno: false },\n  running: {},\n  pending: {}\n};\n\nstate.locks[zona] = false;\ndelete state.running[zona];\n\nif (zona === 'global') {\n  flow.set('alarm_state', state);\n  if (state.pending.global) {\n    const p = state.pending.global;\n    delete state.pending.global;\n    flow.set('alarm_state', state);\n    return [{ zona: p.zona, acao: p.acao }, null];\n  }\n  for (const z of ['portoes','externo','interno']) {\n    if (state.pending[z]) {\n      const p = state.pending[z];\n      delete state.pending[z];\n      flow.set('alarm_state', state);\n      return [{ zona: p.zona, acao: p.acao }, null];\n    }\n  }\n  return [null, msg];\n}\n\nflow.set('alarm_state', state);\nconst someoneRunning = state.locks.portoes || state.locks.externo || state.locks.interno || state.locks.global;\nif (!someoneRunning && state.pending.global) {\n  const p = state.pending.global;\n  delete state.pending.global;\n  flow.set('alarm_state', state);\n  return [{ zona: p.zona, acao: p.acao }, null];\n}\nif (state.pending[zona]) {\n  const p = state.pending[zona];\n  delete state.pending[zona];\n  flow.set('alarm_state', state);\n  return [{ zona: p.zona, acao: p.acao }, null];\n}\nreturn [null, msg];","outputs":2,"noerr":0,"x":990,"y":680,"wires":[["08ecf840a40c8cdf"],["6b2149eee871f3bb"]]},{"id":"6b2149eee871f3bb","type":"debug","z":"09f39342169d0468","name":"Fim execução","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"resultado","targetType":"msg","x":980,"y":720,"wires":[]},{"id":"3c381749c284e0ae","type":"server-state-changed","z":"09f39342169d0468","name":"Ativar Alarme Geral","server":"12097a98.a70645","version":6,"outputs":2,"exposeAsEntityConfig":"","entities":{"entity":["input_boolean.alarme_geral_ativar"],"substring":[],"regex":[]},"o