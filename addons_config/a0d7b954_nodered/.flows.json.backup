es":[],"for":0,"forType":"num","forUnits":"minutes","x":700,"y":500,"wires":[["7a8883c9f443af3b"],[]]},{"id":"44033108620cef88","type":"subflow:486714b6.7eac6c","z":"8ea01d9a.8987c","name":"","env":[{"name":"notifica_app_1","value":"mobile_app_ivan_celular","type":"str"},{"name":"texto_on","value":"Geladeira QUENTE!!!","type":"str"},{"name":"texto_off","value":"Temperatura geladeira OK","type":"str"},{"name":"service_app_notify_1","value":"mobile_app_ivan_celular","type":"str"},{"name":"service_app_notify_2","value":"mobile_app_tablet_ivan","type":"str"}],"x":960,"y":560,"wires":[]},{"id":"6416457c74776428","type":"change","z":"8ea01d9a.8987c","name":"ON","rules":[{"t":"set","p":"payload","pt":"msg","to":"on","tot":"str"}],"action":"","property":"","from":"","to":"","reg":false,"x":410,"y":480,"wires":[["06be1005d4b2e00c","d979fe7e433ae10a","44033108620cef88"]]},{"id":"cbf0ac59344cd83d","type":"change","z":"8ea01d9a.8987c","name":"OFF","rules":[{"t":"set","p":"payload","pt":"msg","to":"off","tot":"str"}],"action":"","property":"","from":"","to":"","reg":false,"x":410,"y":540,"wires":[["06be1005d4b2e00c","806cf401694014c2","44033108620cef88"]]},{"id":"d979fe7e433ae10a","type":"api-call-service","z":"8ea01d9a.8987c","name":"Indica Geladeira Quente","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"input_boolean.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["input_boolean.geladeira_quente"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"input_boolean","service":"turn_on","x":710,"y":580,"wires":[[]]},{"id":"806cf401694014c2","type":"api-call-service","z":"8ea01d9a.8987c","name":"Indica Geladeira Normal","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"input_boolean.turn_off","floorId":[],"areaId":[],"deviceId":[],"entityId":["input_boolean.geladeira_quente"],"labelId":[],"data":"","dataType":"jsonata","