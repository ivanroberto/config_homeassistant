{"property":"entity_picture","value":""},{"property":"device_class","value":""}],"resend":false,"debugEnabled":false},{"id":"1a6a828a1cc42223","type":"ha-entity-config","z":"77ee9ef7029ba7e3","server":"33803899.487d48","deviceConfig":"c1313758bf1ca187","name":"Central AMT - PGM 3 Desativar","version":"6","entityType":"button","haConfig":[{"property":"name","value":"Central AMT - PGM 3 Desativar"},{"property":"icon","value":"mdi:power"},{"property":"entity_category","value":""},{"property":"entity_picture","value":""},{"property":"device_class","value":""}],"resend":false,"debugEnabled":false},{"id":"ha_server","type":"server","name":"Home Assistant","addon":true},{"id":"home_assistant","type":"server","name":"Home Assistant","addon":true},{"id":"f641b8f134d9e1c2","type":"api-call-service","z":"29d0962b.dafb3a","name":"Snapshot Cena","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"scene.create","floorId":[],"areaId":[],"deviceId":[],"entityId":[],"labelId":[],"data":"{\"scene_id\":\"falar_google\",\"snapshot_entities\":$env(\"entidade_media_player\")}","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"scene","service":"create","x":180,"y":60,"wires":[["f07b6c13b4c69845"]]},{"id":"f07b6c13b4c69845","type":"function","z":"29d0962b.dafb3a","name":"Prepara Texto","func":"const status = msg.payload;\nconst txtOn = env.get(\"texto_falado_on\");\nconst txtOff = env.get(\"texto_falado_off\");\n\n// Se o payload já for um texto pronto, usa diretamente\nif (typeof msg.payload === \"string\") {\n    const textoDireto = msg.payload.trim();\n    if (textoDireto !== \"\" && textoDireto !== \"on\" && textoDireto !== \"off\") {\n        return [msg, msg];\n    }\n}\n\n// Resolve o texto (fixo ou vindo de msg.prop)\nlet texto = (status === 'on') ? txtOn : txtOff;\n\nif (texto && typeof texto === 'string') {\n    if (texto.startsWith('msg.')) {\n        texto = RED.util.getMessageProperty(msg, texto.split('.').slice(1).join('.'));\n    } else if (msg[texto] !== undefined) {\n        texto = msg[texto];\n    }\n}\n\nmsg.payload = texto || \"Alerta\";\n\n// Saída 1: Voz | Saída 2: Notificação App\nreturn [msg, msg];","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":380,"y":60,"wires":[["2e4ed1f39e0c3d54"],["bd1d373ffc062760"]]},{"id":"2e4ed1f39e0c3d54","type":"api-call-service","z":"29d0962b.dafb3a","name":"Volume","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"media_player.volume_set","floorId":[],"areaId":[],"deviceId":[],"entityId":[],"labelId":[],"data":"{\n    \"entity_id\": $env(\"entidade_media_player\"),\n    \"volume_level\": $env(\"volume\") / 100\n}","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"media_player","service":"volume_set","x":560,"y":60,"wires":[["37d970c2fc31e0df"]]},{"id":"37d970c2fc31e0df","type":"api-call-service","z":"29d0962b.dafb3a","name":"Falar","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"tts.google_translate_say","floorId":[],"areaId":[],"deviceId":[],"entityId":[],"labelId":[],"data":"{\n    \"entity_id\": $env(\"entidade_media_player\"),\n    \"message\": payload,\n    \"language\": \"pt\"\n}","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"tts","service":"google_translate_say","x":710,"y":60,"wires":[["25db2ed1c8093894"]]},{"id":"25db2ed1c8093894","type":"delay","z":"29d0962b.dafb3a","name":"12s","pauseType":"delay","timeout":"12","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"outputs":1,"x":850,"y":60,"wires":[["4b9993b1ac3fc6ef"]]},{"id":"4b9993b1ac3fc6ef","type":"api-call-service","z":"29d0962b.dafb3a","name":"Restaura Cena","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"scene.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["scene.falar_google"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"scene","service":"turn_on","x":1020,"y":60,"wires":[[]]},{"id":"bd1d373ffc062760","type":"switch","z":"29d0962b.dafb3a","name":"Push Ativo?","property":"realiza_notificacao_app","propertyType":"env","rules":[{"t":"true"}],"checkall":"true","repair":false,"outputs":1,"x":390,"y":160,"wires":[["af21ca21316568cd"]]},{"id":"af21ca21316568cd","type":"subflow:486714b6.7eac6c","z":"29d0962b.dafb3a","name":"Envia PUSH","env":[{"name":"notifica_app_1","value":"service_app_notify_1","type":"env"},{"name":"notifica_app_2","value":"service_app_notify_2","type":"env"},{"name":"notifica_app_3","value":"service_app_notify_3","type":"env"},{"name":"notifica_app_4","value":"service_app_notify_4","type":"env"},{"name":"texto_on","value":"payload","type":"msg"},{"name":"texto_off","value":"payload","type":"msg"}],"x":570,"y":160,"wires":[]},{"id":"694ce0e1.4bee58","type":"function","z":"7cc13ada.b6712c","name":"is in range?","func":"const schedule = flow.get(\"schedule\");\nlet start = env.get(\"start\");\nlet stop = env.get(\"stop\");\nlet days = env.get(\"days\");\nif(schedule !== undefined){\n    start = schedule.start;\n    stop = schedule.stop;\n    days = schedule.days;\n}\nconst time = new Date();\nlet day = time.getDay();\nif(day === 0) day = 7;\nlet hour = String(time.getHours());\nlet minute = String(time.getMinutes());\nif(hour.length == 1) hour = \"0\" + hour;\nif(minute.length == 1) minute = \"0\" + minute;\nconst hmtime = hour + \":\" + minute;\nif(days.includes(day)){\n    if(start == stop){\n        return [msg, null];\n    } else if(start > stop){\n        if(hmtime >= start || hmtime < stop){\n            return [msg, null];\n        } else {\n            return [null, msg];\n        }\n    } else if(hmtime >= start && hmtime < stop){\n        return [msg, null];\n    } else {\n        return [null, msg];\n    }\n} else {\n    return null;\n}","outputs":2,"noerr":0,"x":450,"y":100,"wires":[[],[]]},{"id":"94dc9c00.0f576","type":"inject","z":"7cc13ada.b6712c","name":"","repeat":"","crontab":"","once":true,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":170,"y":200,"wires":[["1bc56c04.ca0a3c"]]},{"id":"1bc56c04.ca0a3c","type":"function","z":"7cc13ada.b6712c","name":"display rule","func":"const schedule = flow.get(\"schedule\");\nif(typeof schedule == \"object\"){\n    const start = schedule.start;\n    const stop = schedule.stop;\n    const days = String(schedule.days).replace(/1/g,\"Mo\").replace(/2/g,\"Tu\").replace(/3/g,\"We\").replace(/4/g,\"Th\").replace(/5/g,\"Fr\").replace(/6/g,\"Sa\").replace(/7/g,\"Su\");\n    msg.payload = \"override: \" + start + \"-\" + stop + \"/\" + days;\n} else {\n    const start = env.get(\"start\");\n    const stop = env.get(\"stop\");\n    const days = String(env.get(\"days\")).replace(/1/g,\"Mo\").replace(/2/g,\"Tu\").replace(/3/g,\"We\").replace(/4/g,\"Th\").replace(/5/g,\"Fr\").replace(/6/g,\"Sa\").replace(/7/g,\"Su\");\n    const override = false;\n    msg.payload = start + \"-\" + stop + \"/\" + days;\n}\nreturn msg;","outputs":1,"noerr":0,"x":350,"y":200,"wires":[[]]},{"id":"da7f7d3f.da5af","type":"function","z":"7cc13ada.b6712c","name":"check for override","func":"if(msg.topic == \"override\"){\n    flow.set(\"schedule\",msg.payload);\n    return [null, msg];\n} else if (msg.payload == \"reset\"){\n    let reset;\n    flow.set(\"schedule\",reset);\n    return [null, msg];\n} else {\n    return [msg, null];\n}","outputs":2,"noerr":0,"x":250,"y":100,"wires":[["694ce0e1.4bee58"],["1bc56c04.ca0a3c"]]},{"id":"d2f39b12424fdf8a","type":"api-call-service","z":"486714b6.7eac6c","name":"Push","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"{{service}}","floorId":[],"areaId":[],"deviceId":[],"entityId":[],"labelId":[],"data":"hadata","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":true,"domain":"notify","service":"","x":410,"y":120,"wires":[[]]},{"id":"add2b52b24e5f144","type":"function","z":"486714b6.7eac6c","name":"Montar Ações","func":"const status = msg.payload;\nconst txtOn = env.get(\"texto_on\");\nconst txtOff = env.get(\"texto_off\");\n\n// 1. Resolve a mensagem\nlet mensagem = (status === 'on') ? txtOn : txtOff;\n\n// Se vier de uma propriedade da msg (como o payload do Google)\nif (mensagem && typeof mensagem === 'string') {\n    if (mensagem.startsWith('msg.')) {\n        mensagem = RED.util.getMessageProperty(msg, mensagem.split('.')[1]);\n    } else if (msg[mensagem]) {\n        mensagem = msg[mensagem];\n    }\n}\n\n// Fallback para o payload direto se nada foi resolvido\nconst textoFinal = mensagem || (typeof msg.payload === 'string' ? msg.payload : \"Alerta\");\n\n// 2. Resolve os destinos\nconst destinosRaw = [\n    env.get(\"notifica_app_1\"),\n    env.get(\"notifica_app_2\"),\n    env.get(\"notifica_app_3\"),\n    env.get(\"notifica_app_4\")\n];\n\n// Filtra destinos vazios ou não resolvidos\nconst destinosValidos = destinosRaw.filter(d => {\n    if (!d || typeof d !== 'string') return false;\n    const limpo = d.trim();\n    // IMPORTANTE: Só deixa passar se o valor NÃO for o nome da variável de ambiente\n    return limpo !== \"\" && \n           limpo !== \"service_app_notify_1\" && \n           limpo !== \"service_app_notify_2\" &&\n           limpo !== \"service_app_notify_3\" &&\n           limpo !== \"service_app_notify_4\";\n});\n\nif (destinosValidos.length === 0) return null;\n\n// 3. Monta as mensagens\nconst msgs = destinosValidos.map(d => {\n    let servico = d.trim();\n    if (!servico.includes('.')) servico = 'notify.' + servico;\n    \n    return {\n        ...msg,\n        service: servico,\n        hadata: { \"message\": textoFinal }\n    };\n});\n\nreturn [msgs];","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":220,"y":200,"wires":[["d2f39b12424fdf8a"]]},{"id":"02dedc0c1fd72da4","type":"inject","z":"b41c30e99f60296a","name":"Check 30s","props":[{"p":"payload"}],"repeat":"30","crontab":"","once":true,"onceDelay":"2","topic":"","payload":"check","payloadType":"str","x":130,"y":120,"wires":[["9ec5aa5cb72036aa"]]},{"id":"9ec5aa5cb72036aa","type":"switch","z":"b41c30e99f60296a","name":"Tem LUX?","property":"lux_entidade","propertyType":"env","rules":[{"t":"nempty"},{"t":"else"}],"checkall":"true","repair":false,"outputs":2,"x":290,"y":120,"wires":[["d8f4498605cf06cb"],["6b0198ebae4c8de4"]]},{"id":"d8f4498605cf06cb","type":"api-current-state","z":"b41c30e99f60296a","name":"Lê LUX Atual","server":"12097a98.a70645","version":3,"outputs":1,"halt_if":"","halt_if_type":"str","halt_if_compare":"is","entity_id":"$(lux_entidade)","state_type":"str","blockInputOverrides":false,"outputProperties":[{"property":"lux_atual","propertyType":"msg","value":"","valueType":"entityState"}],"for":"0","forType":"num","forUnits":"minutes","x":450,"y":80,"wires":[["6b0198ebae4c8de4"]]},{"id":"6b0198ebae4c8de4","type":"function","z":"b41c30e99f60296a","name":"Lógica Central","func":"const luzEnt = env.get(\"luz_entidade\");\nconst luxLimite = parseFloat(env.get(\"lux_claro_valor\")) || 0;\n\n// RETORNADO PARA MINUTOS: Multiplicamos por 60 * 1000\nconst tempoClaroOffMs = (parseFloat(env.get(\"tempo_claro_off_m\")) || 0) * 60 * 1000;\n\nconst haGlobal = global.get('homeassistant');\nif (!haGlobal || !haGlobal.homeAssistant || !haGlobal.homeAssistant.states) return null;\nconst states = haGlobal.homeAssistant.states;\n\nconst luzState = states[luzEnt] ? states[luzEnt].state : 'off';\nconst luxAtual = msg.lux_atual !== undefined ? parseFloat(msg.lux_atual) : 0;\n\nconst now = Date.now();\nlet startTime = context.get('startTime') || 0;\nlet luxStartTime = context.get('luxStartTime') || 0;\n\n// 1. Monitor de Estado da Luz\nif (luzState === 'off') {\n    context.set('startTime', 0);\n    context.set('luxStartTime', 0);\n    return null;\n}\n\nif (startTime === 0) {\n    startTime = now;\n    context.set('startTime', startTime);\n}\n\n// 2. Lógica de Tempo Máximo (Segurança em Minutos)\nconst tempoMaxMs = (parseFloat(env.get(\"tempo_max_on_m\")) || 120) * 60 * 1000;\nif (now - startTime >= tempoMaxMs) {\n    return [{ payload: { data: { entity_id: luzEnt } }, service: \"turn_off\" }, { payload: \"OFF: Tempo Máximo\" }];\n}\n\n// 3. Lógica de LUX (Claridade em Minutos)\nif (luxLimite > 0 && luxAtual >= luxLimite) {\n    if (luxStartTime === 0) {\n        luxStartTime = now;\n        context.set('luxStartTime', luxStartTime);\n    } else if (now - luxStartTime >= tempoClaroOffMs) {\n        return [{ payload: { data: { entity_id: luzEnt } }, service: \"turn_off\" }, { payload: \"OFF: Claridade (Lux)\" }];\n    }\n} else {\n    // Se escureceu, reseta o timer de claridade\n    context.set('luxStartTime', 0);\n}\n\nreturn null;","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":630,"y":120,"wires":[["1a4f443d18df61b1"],["5e21b31696747b6b"]]},{"id":"1a4f443d18df61b1","type":"api-call-service","z":"b41c30e99f60296a","name":"Executar OFF","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"homeassistant.turn_off","floorId":[],"areaId":[],"deviceId":[],"entityId":[],"labelId":[],"data":"payload.data","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":true,"domain":"homeassistant","service":"turn_off","x":840,"y":100,"wires":[[]]},{"id":"5e21b31696747b6b","type":"debug","z":"b41c30e99f60296a","d":true,"name":"Log","active":false,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":810,"y":160,"wires":[]},{"id":"1eef5dcf83dd24d6","type":"function","z":"de646eb88bbbd87e","name":"send notification","func":"var topic = env.get(\"topic\");\nvar titulo = env.get(\"titulo\");\nvar cor_titulo = env.get(\"cor_titulo\");\nvar notificacao = env.get(\"notificacao\");\nvar cor_notificacao = env.get(\"cor_notificacao\");\nvar tempo_notificacao = env.get(\"tempo_notificacao_s\");\nvar qte_buzzer = env.get(\"qte_buzzer\");\nvar screen_save = env.get(\"screen_save\");\nvar limpa_notificacao = env.get(\"limpa_notificacao\");\nvar out_msgs;\n\nif(msg.limpa_notificacao == true){\n    limpa_notificacao = \"true\";\n}\nif(msg.titulo){\n    titulo = msg.titulo;\n}\nif(msg.notificacao){\n    notificacao = msg.notificacao;\n}\nif(msg.qte_buzzer){\n    qte_buzzer = msg.qte_buzzer;\n}\nif(msg.tempo_notificacao){\n    tempo_notificacao = msg.tempo_notificacao;\n}\nif(msg.screen_save){\n    screen_save = msg.screen_save;\n}\n\nif (limpa_notificacao == \"true\") {\n    out_msgs =\n    [\n        { topic: \"cmnd/\" + topic + \"/CustomSend\", payload: \"notify~~\" }\n    ]\n} else {\n    if(screen_save == \"false\"){\n        out_msgs = \n        [   \n            {topic: \"cmnd/\"+topic+\"/Backlog\",payload:\"CustomSend pageType~popupNotify\"}, \n            {topic: \"cmnd/\"+topic+\"/Backlog\",payload:\"CustomSend entityUpdateDetail~\"\n                    +\"id~\"+titulo+\"~\"+cor_titulo\n                    +\"~~~~~\"\n                    +notificacao+\"~\"+cor_notificacao+\"~\"\n                    +tempo_notificacao\n            },\n            {topic: \"cmnd/\"+topic+\"/Backlog\",payload:\"Buzzer \"+qte_buzzer+\",2,2\"}\n        ]\n    } else {\n        out_msgs = \n        [ \n            {topic: \"cmnd/\"+topic+\"/Backlog\",payload:\"CustomSend notify~\" \n                    +titulo+\"~\"+notificacao+\"~\"\n            },\n            {topic: \"cmnd/\"+topic+\"/Backlog\",payload:\"Buzzer \"+qte_buzzer+\",2,2\"}\n        ]\n    }    \n} \n\nreturn [out_msgs]","outputs":1,"noerr":0,"initialize":"if (flow.get(\"ns-currentPage\") === undefined) {\n    flow.set(\"ns-currentPage\", 0)\n}","finalize":"","libs":[],"x":220,"y":100,"wires":[["2931e90ebb2644cd"]]},{"id":"2931e90ebb2644cd","type":"mqtt out","z":"de646eb88bbbd87e","name":"","topic":"","qos":"1","retain":"","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"bf156a65.c215e8","x":410,"y":100,"wires":[]},{"id":"e3d380f1ab99ce71","type":"comment","z":"de646eb88bbbd87e","name":"Notifica NSPanel","info":"","x":120,"y":60,"wires":[]},{"id":"27c2303f69359c89","type":"api-call-service","z":"e575047d796d3ba1","name":"Ativar Alarme Portões","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"input_boolean.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["button.central_amt_ativar_amt"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"input_boolean","service":"turn_on","x":660,"y":180,"wires":[["469493208d76da20"]]},{"id":"16a997d37d0bb0f1","type":"api-call-service","z":"e575047d796d3ba1","name":"Ativar Alarme Externo","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"input_boolean.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["input_boolean.alarme_externo_ativar"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"input_boolean","service":"turn_on","x":920,"y":240,"wires":[[]]},{"id":"b986175d420ec888","type":"api-call-service","z":"e575047d796d3ba1","name":"Ativar Alarme Geral","server":"12097a98.a70645","version":7,"debugenabled":false,"action":"input_boolean.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["input_boolean.alarme_geral_ativar"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":false,"domain":"input_boolean","service":"turn_on","x":190,"y":180,"wires":[[